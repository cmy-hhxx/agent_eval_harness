{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "session_overview",
    "session_meta",
    "trace_meta",
    "turns"
  ],
  "properties": {
    "session_overview": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "session_meta": {
      "type": "object"
    },
    "trace_meta": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object"
      }
    },
    "turns": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "turn_idx",
          "plans",
          "reasoning_chain",
          "execution_chain",
          "reflections",
          "tool_errors",
          "final_answer",
          "components",
          "key_data",
          "artifacts"
        ],
        "properties": {
          "turn_idx": {
            "type": "integer",
            "minimum": 0
          },
          "plans": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "step_idx",
                "content",
                "evidence"
              ],
              "properties": {
                "step_idx": {
                  "type": "integer",
                  "minimum": 1
                },
                "content": {
                  "type": "string",
                  "minLength": 1
                },
                "evidence": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "evidence_id",
                      "quote"
                    ],
                    "properties": {
                      "evidence_id": {
                        "type": "string",
                        "minLength": 1
                      },
                      "quote": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 400
                      }
                    }
                  }
                }
              }
            }
          },
          "reasoning_chain": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "step_idx",
                "content",
                "evidence"
              ],
              "properties": {
                "step_idx": {
                  "type": "integer",
                  "minimum": 1
                },
                "content": {
                  "type": "string",
                  "minLength": 1
                },
                "evidence": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "evidence_id",
                      "quote"
                    ],
                    "properties": {
                      "evidence_id": {
                        "type": "string",
                        "minLength": 1
                      },
                      "quote": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 400
                      }
                    }
                  }
                }
              }
            }
          },
          "execution_chain": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "step_idx",
                "content",
                "evidence"
              ],
              "properties": {
                "step_idx": {
                  "type": "integer",
                  "minimum": 1
                },
                "content": {
                  "type": "string",
                  "minLength": 1
                },
                "evidence": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "evidence_id",
                      "quote"
                    ],
                    "properties": {
                      "evidence_id": {
                        "type": "string",
                        "minLength": 1
                      },
                      "quote": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 400
                      }
                    }
                  }
                }
              }
            }
          },
          "reflections": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "reflection_idx",
                "reflection_content",
                "evidence"
              ],
              "properties": {
                "reflection_idx": {
                  "type": "integer",
                  "minimum": 1
                },
                "reflection_content": {
                  "type": "string",
                  "minLength": 1
                },
                "evidence": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "evidence_id",
                      "quote"
                    ],
                    "properties": {
                      "evidence_id": {
                        "type": "string",
                        "minLength": 1
                      },
                      "quote": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 400
                      }
                    }
                  }
                }
              }
            }
          },
          "tool_errors": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "tool_error_idx",
                "tool_error_content",
                "evidence"
              ],
              "properties": {
                "tool_error_idx": {
                  "type": "integer",
                  "minimum": 1
                },
                "tool_error_content": {
                  "type": "string",
                  "minLength": 1
                },
                "evidence": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "evidence_id",
                      "quote"
                    ],
                    "properties": {
                      "evidence_id": {
                        "type": "string",
                        "minLength": 1
                      },
                      "quote": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 400
                      }
                    }
                  }
                }
              }
            }
          },
          "final_answer": {
            "type": "string"
          },
          "components": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "components_idx",
                "components_name",
                "components_kind",
                "components_content",
                "evidence"
              ],
              "properties": {
                "components_idx": {
                  "type": "integer",
                  "minimum": 1
                },
                "components_name": {
                  "type": "string",
                  "minLength": 1
                },
                "components_kind": {
                  "enum": [
                    "model",
                    "tool",
                    "script",
                    "skill"
                  ]
                },
                "components_content": {
                  "type": "string",
                  "minLength": 1
                },
                "evidence": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "evidence_id",
                      "quote"
                    ],
                    "properties": {
                      "evidence_id": {
                        "type": "string",
                        "minLength": 1
                      },
                      "quote": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 400
                      }
                    }
                  }
                }
              }
            }
          },
          "key_data": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "key_data_idx",
                "key_data_content",
                "evidence"
              ],
              "properties": {
                "key_data_idx": {
                  "type": "integer",
                  "minimum": 1
                },
                "key_data_content": {
                  "type": "string",
                  "minLength": 1
                },
                "evidence": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "evidence_id",
                      "quote"
                    ],
                    "properties": {
                      "evidence_id": {
                        "type": "string",
                        "minLength": 1
                      },
                      "quote": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 400
                      }
                    }
                  }
                }
              }
            }
          },
          "artifacts": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "artifacts_idx",
                "artifacts_content",
                "evidence"
              ],
              "properties": {
                "artifacts_idx": {
                  "type": "integer",
                  "minimum": 1
                },
                "artifacts_content": {
                  "type": "string",
                  "minLength": 1
                },
                "evidence": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "evidence_id",
                      "quote"
                    ],
                    "properties": {
                      "evidence_id": {
                        "type": "string",
                        "minLength": 1
                      },
                      "quote": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 400
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
