{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "session_overview",
    "meta",
    "turns"
  ],
  "properties": {
    "session_overview": {
      "type": "object"
    },
    "meta": {
      "type": "object"
    },
    "turns": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "turn_index"
        ],
        "properties": {
          "turn_index": {
            "type": "integer",
            "minimum": 0
          },
          "plan": {
            "type": "object"
          },
          "stop_reason": {
            "type": "object"
          },
          "final_answer": {
            "type": "object"
          },
          "key_data": {
            "type": "object"
          },
          "reasoning_chain": {
            "type": "array"
          },
          "execution_chain": {
            "type": "array"
          },
          "reflections": {
            "type": "array"
          },
          "gaps": {
            "type": "array"
          },
          "artifacts": {
            "type": "array"
          },
          "components": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "kind",
                "name"
              ],
              "properties": {
                "kind": {
                  "enum": [
                    "model",
                    "tool",
                    "script",
                    "skill"
                  ]
                },
                "name": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "additionalProperties": true
            }
          }
        }
      }
    },
    "cross_turn": {
      "type": "object"
    },
    "components": {
      "type": "array"
    }
  }
}
