{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "task_analysis",
    "ranking",
    "assessments",
    "decision_basis",
    "status",
    "review_requests"
  ],
  "properties": {
    "task_analysis": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "task_type",
        "goal",
        "requirements",
        "scoring_points",
        "red_flags"
      ],
      "properties": {
        "task_type": {
          "type": "string",
          "minLength": 1
        },
        "goal": {
          "type": "string",
          "minLength": 1
        },
        "requirements": {
          "type": "array",
          "minItems": 1,
          "maxItems": 24,
          "items": {
            "$ref": "#/$defs/criterion"
          }
        },
        "scoring_points": {
          "type": "array",
          "maxItems": 24,
          "items": {
            "$ref": "#/$defs/criterion"
          }
        },
        "red_flags": {
          "type": "array",
          "maxItems": 24,
          "items": {
            "$ref": "#/$defs/criterion"
          }
        }
      }
    },
    "ranking": {
      "type": "array",
      "minItems": 0,
      "items": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "assessments": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "meets_core",
          "summary",
          "core_failure_refs"
        ],
        "properties": {
          "meets_core": {
            "type": [
              "boolean",
              "null"
            ],
            "description": "照录来源core_assessment；证据不足时仅needs_review可为null。核心失败明确引用已确认的requirements。"
          },
          "summary": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "core_failure_refs": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "decision_basis": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tradeoff",
        "comparisons",
        "decisive_findings"
      ],
      "properties": {
        "tradeoff": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "comparisons": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "aspect",
              "importance",
              "better_candidates",
              "assessments",
              "criterion_ids"
            ],
            "properties": {
              "aspect": {
                "type": "string",
                "minLength": 1,
                "maxLength": 60
              },
              "importance": {
                "enum": [
                  "high",
                  "medium",
                  "low"
                ]
              },
              "better_candidates": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "assessments": {
                "type": "object",
                "additionalProperties": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "summary",
                    "finding_indices",
                    "status",
                    "evidence_status"
                  ],
                  "properties": {
                    "summary": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 160
                    },
                    "finding_indices": {
                      "type": "array",
                      "uniqueItems": true,
                      "items": {
                        "type": "integer",
                        "minimum": 0
                      }
                    },
                    "status": {
                      "enum": [
                        "met",
                        "partial",
                        "unmet",
                        "unknown",
                        "not_applicable"
                      ]
                    },
                    "evidence_status": {
                      "enum": [
                        "established",
                        "uncertain"
                      ]
                    }
                  }
                }
              },
              "criterion_ids": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        },
        "decisive_findings": {
          "type": "array",
          "maxItems": 24,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "candidate",
              "finding_index"
            ],
            "properties": {
              "candidate": {
                "type": "string",
                "minLength": 1
              },
              "finding_index": {
                "type": "integer",
                "minimum": 0
              }
            }
          }
        }
      }
    },
    "rewritten": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evaluator_version",
        "rewrites"
      ],
      "properties": {
        "evaluator_version": {
          "type": "string",
          "minLength": 1
        },
        "rewrites": {
          "type": "array",
          "minItems": 0,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "text"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 80
              },
              "text": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    "status": {
      "enum": [
        "decided",
        "needs_review"
      ]
    },
    "review_requests": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "candidate",
          "criterion_ids",
          "finding_indices",
          "reason"
        ],
        "properties": {
          "candidate": {
            "type": "string",
            "minLength": 1
          },
          "criterion_ids": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "finding_indices": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "integer",
              "minimum": 0
            }
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  },
  "$defs": {
    "criterion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "text",
        "applies_to",
        "acceptance_rule"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]{0,31}$"
        },
        "text": {
          "type": "string",
          "minLength": 1
        },
        "applies_to": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
          }
        },
        "acceptance_rule": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "decided"
          }
        }
      },
      "then": {
        "properties": {
          "ranking": {
            "minItems": 1
          },
          "review_requests": {
            "maxItems": 0
          },
          "assessments": {
            "additionalProperties": {
              "properties": {
                "meets_core": {
                  "type": "boolean"
                }
              }
            }
          }
        }
      },
      "else": {
        "properties": {
          "ranking": {
            "maxItems": 0
          },
          "review_requests": {
            "minItems": 1
          },
          "decision_basis": {
            "properties": {
              "decisive_findings": {
                "maxItems": 0
              }
            }
          }
        }
      }
    }
  ]
}
