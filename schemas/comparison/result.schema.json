{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "task_analysis",
    "ranking",
    "assessments",
    "decision_basis"
  ],
  "properties": {
    "task_analysis": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "task_type",
        "goal",
        "requirements",
        "scoring_points",
        "red_flags"
      ],
      "properties": {
        "task_type": {
          "type": "string",
          "minLength": 1
        },
        "goal": {
          "type": "string",
          "minLength": 1
        },
        "requirements": {
          "type": "array",
          "minItems": 1,
          "maxItems": 6,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "scoring_points": {
          "type": "array",
          "minItems": 0,
          "maxItems": 6,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "red_flags": {
          "type": "array",
          "minItems": 0,
          "maxItems": 6,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "ranking": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "assessments": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "meets_core",
          "summary"
        ],
        "properties": {
          "meets_core": {
            "type": "boolean",
            "description": "关键交付是否可用，须看整份最终回答；不直接复制 is_correct 或 importance。false 须引用已证实的问题，说明哪项必要结果缺失或错误到无法使用。"
          },
          "summary": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          }
        }
      }
    },
    "decision_basis": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tradeoff",
        "comparisons",
        "decisive_findings"
      ],
      "properties": {
        "tradeoff": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "comparisons": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["aspect", "importance", "better_candidates", "assessments"],
            "properties": {
              "aspect": { "type": "string", "minLength": 1, "maxLength": 60 },
              "importance": { "enum": ["high", "medium", "low"] },
              "better_candidates": {
                "type": "array", "uniqueItems": true,
                "items": { "type": "string", "minLength": 1 }
              },
              "assessments": {
                "type": "object",
                "additionalProperties": {
                  "type": "object", "additionalProperties": false,
                  "required": ["summary", "finding_indices"],
                  "properties": {
                    "summary": { "type": "string", "minLength": 1, "maxLength": 160 },
                    "finding_indices": {
                      "type": "array", "uniqueItems": true,
                      "items": { "type": "integer", "minimum": 0 }
                    }
                  }
                }
              }
            }
          }
        },
        "decisive_findings": {
          "type": "array",
          "maxItems": 24,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "candidate",
              "finding_index"
            ],
            "properties": {
              "candidate": {
                "type": "string",
                "minLength": 1
              },
              "finding_index": {
                "type": "integer",
                "minimum": 0
              }
            }
          }
        }
      }
    },
    "rewritten": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evaluator_version",
        "rewrites"
      ],
      "properties": {
        "evaluator_version": {
          "type": "string",
          "minLength": 1
        },
        "rewrites": {
          "type": "array",
          "minItems": 0,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "text"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 80
              },
              "text": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    }
  }
}
