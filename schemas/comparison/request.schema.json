{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["ground_truth", "candidates"],
  "properties": {
    "ground_truth": {
      "type": "object",
      "required": ["available", "value"],
      "properties": {
        "available": {
          "type": "boolean"
        },
        "value": {}
      }
    },
    "candidates": {
      "type": "object",
      "required": ["A", "B"],
      "additionalProperties": {
        "type": "object",
        "required": ["final_message_index", "original_answer_timing", "original_answer_usage"],
        "properties": {
          "final_message_index": {
            "type": "integer",
            "minimum": 0
          },
          "original_answer_timing": {
            "type": "object",
            "required": ["finish_seconds"],
            "properties": {
              "finish_seconds": {
                "type": ["number", "null"],
                "minimum": 0
              },
              "first_token_seconds": {
                "type": ["number", "null"],
                "minimum": 0
              },
              "first_answer_seconds": {
                "type": ["number", "null"],
                "minimum": 0
              }
            }
          },
          "original_answer_usage": {
            "type": "object",
            "additionalProperties": false,
            "required": ["input_tokens", "output_tokens", "total_tokens", "cached_input_tokens", "total_tokens_basis", "source_fields", "issues"],
            "properties": {
              "input_tokens": {
                "type": ["integer", "null"],
                "minimum": 0
              },
              "output_tokens": {
                "type": ["integer", "null"],
                "minimum": 0
              },
              "total_tokens": {
                "type": ["integer", "null"],
                "minimum": 0
              },
              "cached_input_tokens": {
                "type": ["integer", "null"],
                "minimum": 0
              },
              "total_tokens_basis": {
                "enum": ["reported", "input_plus_output", null]
              },
              "source_fields": {
                "type": "object",
                "required": ["input_tokens", "output_tokens", "total_tokens", "cached_input_tokens"],
                "additionalProperties": {
                  "type": "string"
                }
              },
              "issues": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "attributions": {
      "type": "object"
    }
  }
}
