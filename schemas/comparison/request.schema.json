{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["ground_truth", "candidates", "attributions", "strength_checks"],
  "properties": {
    "ground_truth": {
      "type": "object",
      "required": ["available", "value"],
      "properties": {
        "available": {
          "type": "boolean"
        },
        "value": {}
      }
    },
    "candidates": {
      "type": "object",
      "required": ["A", "B"],
      "additionalProperties": {
        "type": "object",
        "required": ["final_message_index", "deferred_final_material", "original_answer_timing", "original_answer_usage"],
        "properties": {
          "deferred_final_material": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["message_index", "path", "total_chars"],
              "properties": {
                "message_index": { "type": "integer", "minimum": 0 },
                "path": { "type": "string", "minLength": 1 },
                "total_chars": { "type": "integer", "minimum": 1 }
              }
            }
          },
          "final_message_index": {
            "type": "integer",
            "minimum": 0
          },
          "original_answer_timing": {
            "type": "object",
            "required": ["finish_seconds"],
            "properties": {
              "finish_seconds": {
                "type": ["number", "null"],
                "minimum": 0
              },
              "first_token_seconds": {
                "type": ["number", "null"],
                "minimum": 0
              },
              "first_answer_seconds": {
                "type": ["number", "null"],
                "minimum": 0
              }
            }
          },
          "original_answer_usage": {
            "type": "object",
            "additionalProperties": false,
            "required": ["input_tokens", "output_tokens", "total_tokens", "cached_input_tokens", "total_tokens_basis", "source_fields", "issues"],
            "properties": {
              "input_tokens": {
                "type": ["integer", "null"],
                "minimum": 0
              },
              "output_tokens": {
                "type": ["integer", "null"],
                "minimum": 0
              },
              "total_tokens": {
                "type": ["integer", "null"],
                "minimum": 0
              },
              "cached_input_tokens": {
                "type": ["integer", "null"],
                "minimum": 0
              },
              "total_tokens_basis": {
                "enum": ["reported", "input_plus_output", null]
              },
              "source_fields": {
                "type": "object",
                "required": ["input_tokens", "output_tokens", "total_tokens", "cached_input_tokens"],
                "additionalProperties": {
                  "type": "string"
                }
              },
              "issues": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "attributions": {
      "type": "object"
    },
    "strength_checks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["candidate", "finding_index", "counterparts"],
        "properties": {
          "candidate": { "type": "string", "minLength": 1 },
          "finding_index": { "type": "integer", "minimum": 0 },
          "counterparts": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
        }
      }
    }
  }
}
