{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "ground_truth",
    "candidates",
    "attributions",
    "task_analysis"
  ],
  "properties": {
    "ground_truth": {
      "type": "object",
      "required": [
        "available",
        "value"
      ],
      "properties": {
        "available": {
          "type": "boolean"
        },
        "value": {}
      }
    },
    "candidates": {
      "type": "object",
      "required": [
        "A",
        "B"
      ],
      "additionalProperties": {
        "type": "object",
        "required": [
          "final_message_index",
          "deferred_final_material",
          "original_answer_timing",
          "original_answer_usage",
          "candidate_id"
        ],
        "properties": {
          "deferred_final_material": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "message_index",
                "path",
                "total_chars"
              ],
              "properties": {
                "message_index": {
                  "type": "integer",
                  "minimum": 0
                },
                "path": {
                  "type": "string",
                  "minLength": 1
                },
                "total_chars": {
                  "type": "integer",
                  "minimum": 1
                }
              }
            }
          },
          "final_message_index": {
            "type": "integer",
            "minimum": 0
          },
          "original_answer_timing": {
            "type": "object",
            "required": [
              "finish_seconds"
            ],
            "properties": {
              "finish_seconds": {
                "type": [
                  "number",
                  "null"
                ],
                "minimum": 0
              },
              "first_token_seconds": {
                "type": [
                  "number",
                  "null"
                ],
                "minimum": 0
              },
              "first_answer_seconds": {
                "type": [
                  "number",
                  "null"
                ],
                "minimum": 0
              }
            }
          },
          "original_answer_usage": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "input_tokens",
              "output_tokens",
              "total_tokens",
              "cached_input_tokens",
              "total_tokens_basis",
              "source_fields",
              "issues"
            ],
            "properties": {
              "input_tokens": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 0
              },
              "output_tokens": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 0
              },
              "total_tokens": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 0
              },
              "cached_input_tokens": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 0
              },
              "total_tokens_basis": {
                "enum": [
                  "reported",
                  "input_plus_output",
                  null
                ]
              },
              "source_fields": {
                "type": "object",
                "required": [
                  "input_tokens",
                  "output_tokens",
                  "total_tokens",
                  "cached_input_tokens"
                ],
                "additionalProperties": {
                  "type": "string"
                }
              },
              "issues": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          },
          "candidate_id": {
            "type": "string",
            "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
          },
          "instruction_sources": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/instructionSource"
            }
          },
          "citation_inventory": {
            "$ref": "#/$defs/citationInventory"
          },
          "answer_generation": {
            "$ref": "#/$defs/answer_generation"
          }
        }
      },
      "minProperties": 2,
      "maxProperties": 2
    },
    "attributions": {
      "type": "object",
      "required": [
        "A",
        "B"
      ],
      "minProperties": 2,
      "maxProperties": 2,
      "additionalProperties": {
        "type": "object",
        "required": [
          "criterion_assessments",
          "core_assessment",
          "findings",
          "task_analysis",
          "summary",
          "has_standard_answer",
          "is_correct",
          "correctness_reason",
          "correctness_evidence",
          "numeric_checks"
        ],
        "properties": {
          "criterion_assessments": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "criterion_id",
                "status",
                "evidence_status",
                "summary",
                "evidence"
              ],
              "properties": {
                "criterion_id": {
                  "type": "string",
                  "minLength": 1
                },
                "status": {
                  "enum": [
                    "met",
                    "partial",
                    "unmet",
                    "unknown",
                    "not_applicable"
                  ]
                },
                "evidence_status": {
                  "enum": [
                    "established",
                    "uncertain"
                  ]
                },
                "summary": {
                  "type": "string",
                  "minLength": 1
                },
                "evidence": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "evidence_id",
                      "message_index",
                      "quote"
                    ],
                    "properties": {
                      "message_index": {
                        "type": "integer",
                        "minimum": 0
                      },
                      "quote": {
                        "type": "string",
                        "minLength": 1
                      },
                      "source": {
                        "type": "string",
                        "minLength": 1
                      },
                      "source_input_id": {
                        "type": "string",
                        "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
                      },
                      "evidence_id": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "dependentRequired": {
                      "source": [
                        "source_input_id"
                      ],
                      "source_input_id": [
                        "source"
                      ]
                    }
                  }
                },
                "context_evidence": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "evidence_id",
                      "message_index",
                      "quote"
                    ],
                    "properties": {
                      "message_index": {
                        "type": "integer",
                        "minimum": 0
                      },
                      "quote": {
                        "type": "string",
                        "minLength": 1
                      },
                      "source": {
                        "type": "string",
                        "minLength": 1
                      },
                      "source_input_id": {
                        "type": "string",
                        "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
                      },
                      "evidence_id": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "dependentRequired": {
                      "source": [
                        "source_input_id"
                      ],
                      "source_input_id": [
                        "source"
                      ]
                    }
                  },
                  "minItems": 1
                }
              },
              "additionalProperties": false
            }
          },
          "core_assessment": {
            "type": "object",
            "required": [
              "meets_core",
              "reason",
              "criterion_ids"
            ],
            "properties": {
              "meets_core": {
                "type": [
                  "boolean",
                  "null"
                ]
              },
              "reason": {
                "type": "string",
                "minLength": 1
              },
              "criterion_ids": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "additionalProperties": false
          },
          "findings": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "type",
                "dimension",
                "stage",
                "importance",
                "text",
                "reason",
                "evidence",
                "assessment"
              ],
              "properties": {
                "type": {
                  "enum": [
                    "strength",
                    "problem"
                  ]
                },
                "dimension": {
                  "enum": [
                    "correctness",
                    "completeness",
                    "instruction_following",
                    "evidence_quality",
                    "reasoning",
                    "format",
                    "relevance",
                    "efficiency"
                  ]
                },
                "stage": {
                  "enum": [
                    "context_recall",
                    "reasoning",
                    "execution",
                    "final_answer"
                  ]
                },
                "importance": {
                  "enum": [
                    "high",
                    "medium",
                    "low"
                  ]
                },
                "text": {
                  "type": "string",
                  "minLength": 1
                },
                "reason": {
                  "type": "string",
                  "minLength": 1
                },
                "evidence": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "evidence_id",
                      "message_index",
                      "quote"
                    ],
                    "properties": {
                      "message_index": {
                        "type": "integer",
                        "minimum": 0
                      },
                      "quote": {
                        "type": "string",
                        "minLength": 1
                      },
                      "source": {
                        "type": "string",
                        "minLength": 1
                      },
                      "source_input_id": {
                        "type": "string",
                        "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"
                      },
                      "evidence_id": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "dependentRequired": {
                      "source": [
                        "source_input_id"
                      ],
                      "source_input_id": [
                        "source"
                      ]
                    }
                  }
                },
                "context_evidence": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "evidence_id",
                      "message_index",
                      "quote"
                    ],
                    "properties": {
                      "message_index": {
                        "type": "integer",
                        "minimum": 0
                      },
                      "quote": {
                        "type": "string",
                        "minLength": 1
                      },
                      "source": {
                        "type": "string",
                        "minLength": 1
                      },
                      "source_input_id": {
                        "type": "string",
                        "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"
                      },
                      "evidence_id": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "dependentRequired": {
                      "source": [
                        "source_input_id"
                      ],
                      "source_input_id": [
                        "source"
                      ]
                    }
                  },
                  "description": "程序绑定的完整规范上下文，保留条件与例外；不作为直接支持结论的聚焦引用。"
                },
                "assessment": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "requirement_index",
                    "observation",
                    "evidence_status",
                    "impact"
                  ],
                  "properties": {
                    "requirement_index": {
                      "type": [
                        "integer",
                        "null"
                      ],
                      "minimum": 0
                    },
                    "observation": {
                      "type": "string",
                      "minLength": 1
                    },
                    "evidence_status": {
                      "enum": [
                        "established",
                        "uncertain"
                      ]
                    },
                    "impact": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                },
                "finding_index": {
                  "type": "integer",
                  "minimum": 0
                }
              }
            }
          },
          "task_analysis": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "task_type",
              "goal",
              "requirements",
              "scoring_points",
              "red_flags"
            ],
            "properties": {
              "task_type": {
                "type": "string",
                "minLength": 1
              },
              "goal": {
                "type": "string",
                "minLength": 1
              },
              "requirements": {
                "type": "array",
                "minItems": 1,
                "maxItems": 24,
                "items": {
                  "$ref": "#/$defs/criterion"
                }
              },
              "scoring_points": {
                "type": "array",
                "maxItems": 24,
                "items": {
                  "$ref": "#/$defs/criterion"
                }
              },
              "red_flags": {
                "type": "array",
                "maxItems": 24,
                "items": {
                  "$ref": "#/$defs/criterion"
                }
              }
            }
          },
          "summary": {
            "type": "string",
            "minLength": 1
          },
          "has_standard_answer": {
            "type": "boolean"
          },
          "is_correct": {
            "type": [
              "boolean",
              "null"
            ]
          },
          "correctness_reason": {
            "type": "string"
          },
          "correctness_evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "evidence_id",
                "message_index",
                "quote"
              ],
              "properties": {
                "message_index": {
                  "type": "integer",
                  "minimum": 0
                },
                "quote": {
                  "type": "string",
                  "minLength": 1
                },
                "source": {
                  "type": "string",
                  "minLength": 1
                },
                "source_input_id": {
                  "type": "string",
                  "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"
                },
                "evidence_id": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "dependentRequired": {
                "source": [
                  "source_input_id"
                ],
                "source_input_id": [
                  "source"
                ]
              }
            }
          },
          "numeric_checks": {
            "type": "array",
            "maxItems": 64,
            "description": "记录可直接比较的同口径标准点值，不能仅列错误项；确实未交付该目标时保留 actual=null、matches=false。matches 仅为算术观察，不决定整体正确性。显式容差、区间、上下限及须计算或解码的表达在 correctness_reason 按原规则核验，该目标不入表；最终回答已直接给出的计算结果可按原值入表。无标准或没有直接点值目标时填空数组。",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "label",
                "expected",
                "actual",
                "scale",
                "matches",
                "mode",
                "evidence_index"
              ],
              "properties": {
                "label": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 100
                },
                "expected": {
                  "type": "string",
                  "pattern": "^[+-]?\\d+(?:\\.\\d+)?(?:[eE][+-]?\\d{1,3})?$",
                  "maxLength": 80,
                  "description": "标准中的原数值，保留小数位与科学计数法指数，不展开或改写精度"
                },
                "actual": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "pattern": "^[+-]?\\d+(?:\\.\\d+)?(?:[eE][+-]?\\d{1,3})?$",
                  "maxLength": 80,
                  "description": "最终回答原数值；确实未提供该项时为null，绝不能用0表示缺失"
                },
                "scale": {
                  "type": "string",
                  "pattern": "^[+-]?\\d+(?:\\.\\d+)?(?:[eE][+-]?\\d{1,3})?$",
                  "maxLength": 80,
                  "description": "有证据依据的回答单位到标准单位的正倍率，同单位填1；不能为使数值相等而选择倍率"
                },
                "matches": {
                  "type": "boolean",
                  "description": "仅记录 actual*scale 与 expected 的算术比较：rounded 按标准末位精度四舍五入，exact 精确比较；actual=null 时为false。不表示语义正确性，须结合 correctness_reason 的原题、计算与证据判断"
                },
                "mode": {
                  "enum": [
                    "rounded",
                    "exact"
                  ],
                  "description": "算术观察方式：rounded 按标准末位精度舍入，exact 精确比较，离散计数用exact；精度差异的语义结论由 correctness_reason 说明，容差、区间和上下限不使用此表"
                },
                "evidence_index": {
                  "type": "integer",
                  "minimum": 0,
                  "description": "correctness_evidence 的零起始位置；actual 非 null 时证据包含最终回答原值，actual=null 时证据覆盖待核缺失范围，均须指向本方最终回答"
                }
              }
            }
          },
          "standard_conflict": {
            "type": "boolean",
            "description": "标准答案是否存在已证实的错误；默认 false，证据门槛见评审指引。"
          },
          "table_resolutions": {
            "type": "array",
            "maxItems": 100,
            "description": "An evidence-backed judgment of an unresolved table row.",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "table_id",
                "row_index",
                "outcome",
                "reason",
                "evidence"
              ],
              "properties": {
                "table_id": {
                  "type": "string",
                  "minLength": 1
                },
                "row_index": {
                  "type": "integer",
                  "minimum": 0
                },
                "outcome": {
                  "enum": [
                    "supported",
                    "conflict"
                  ]
                },
                "reason": {
                  "type": "string",
                  "minLength": 1
                },
                "evidence": {
                  "type": "array",
                  "minItems": 2,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "evidence_id",
                      "message_index",
                      "quote"
                    ],
                    "properties": {
                      "message_index": {
                        "type": "integer",
                        "minimum": 0
                      },
                      "quote": {
                        "type": "string",
                        "minLength": 1
                      },
                      "source": {
                        "type": "string",
                        "minLength": 1
                      },
                      "source_input_id": {
                        "type": "string",
                        "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"
                      },
                      "evidence_id": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "dependentRequired": {
                      "source": [
                        "source_input_id"
                      ],
                      "source_input_id": [
                        "source"
                      ]
                    }
                  }
                }
              }
            }
          }
        },
        "additionalProperties": false
      }
    },
    "task_analysis": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "task_type",
        "goal",
        "requirements",
        "scoring_points",
        "red_flags"
      ],
      "properties": {
        "task_type": {
          "type": "string",
          "minLength": 1
        },
        "goal": {
          "type": "string",
          "minLength": 1
        },
        "requirements": {
          "type": "array",
          "minItems": 1,
          "maxItems": 24,
          "items": {
            "$ref": "#/$defs/criterion"
          }
        },
        "scoring_points": {
          "type": "array",
          "maxItems": 24,
          "items": {
            "$ref": "#/$defs/criterion"
          }
        },
        "red_flags": {
          "type": "array",
          "maxItems": 24,
          "items": {
            "$ref": "#/$defs/criterion"
          }
        }
      }
    },
    "source_review": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "reason",
            "requires_review"
          ],
          "properties": {
            "kind": {
              "enum": [
                "unverified",
                "unresolved_conflict",
                "invalid_material"
              ]
            },
            "reason": {
              "type": "string",
              "minLength": 1
            },
            "requires_review": {
              "type": "boolean"
            }
          },
          "allOf": [
            {
              "if": {
                "properties": {
                  "kind": {
                    "enum": [
                      "invalid_material"
                    ]
                  }
                }
              },
              "then": {
                "properties": {
                  "requires_review": {
                    "const": true
                  }
                }
              }
            }
          ]
        }
      }
    }
  },
  "$defs": {
    "criterion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "text",
        "applies_to",
        "acceptance_rule"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]{0,31}$"
        },
        "text": {
          "type": "string",
          "minLength": 1
        },
        "applies_to": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
          }
        },
        "acceptance_rule": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidence_id",
        "message_index",
        "quote"
      ],
      "properties": {
        "evidence_id": {
          "type": "string",
          "minLength": 1
        },
        "message_index": {
          "type": "integer",
          "minimum": 0
        },
        "quote": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "instructionSource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "message_index",
        "path",
        "role",
        "content",
        "evidence"
      ],
      "properties": {
        "message_index": {
          "type": "integer",
          "minimum": 0
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "role": {
          "enum": [
            "system",
            "developer",
            "tool"
          ]
        },
        "content": {},
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidence"
          }
        }
      }
    },
    "citationInventory": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocols",
        "references",
        "document_groups"
      ],
      "properties": {
        "protocols": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "footnote",
              "trace",
              "vis-html"
            ]
          }
        },
        "references": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "reference",
              "format",
              "status",
              "occurrences",
              "sources"
            ],
            "properties": {
              "reference": {
                "type": "string",
                "minLength": 1
              },
              "format": {
                "enum": [
                  "footnote",
                  "trace",
                  "vis-html"
                ]
              },
              "status": {
                "enum": [
                  "resolved",
                  "ambiguous",
                  "unknown"
                ]
              },
              "occurrences": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/citationOccurrence"
                }
              },
              "sources": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/citationSource"
                }
              }
            }
          }
        },
        "document_groups": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "url",
              "references"
            ],
            "properties": {
              "url": {
                "type": "string",
                "minLength": 1
              },
              "references": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "format",
                    "reference"
                  ],
                  "properties": {
                    "format": {
                      "enum": [
                        "footnote",
                        "trace",
                        "vis-html"
                      ]
                    },
                    "reference": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "citationOccurrence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidence_id",
        "message_index",
        "quote",
        "context"
      ],
      "properties": {
        "evidence_id": {
          "$ref": "#/$defs/evidence/properties/evidence_id"
        },
        "message_index": {
          "$ref": "#/$defs/evidence/properties/message_index"
        },
        "quote": {
          "$ref": "#/$defs/evidence/properties/quote"
        },
        "context": {
          "$ref": "#/$defs/citationContext"
        }
      }
    },
    "citationContext": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidence_id",
        "message_index",
        "quote",
        "read_request",
        "end_offset"
      ],
      "properties": {
        "evidence_id": {
          "$ref": "#/$defs/evidence/properties/evidence_id"
        },
        "message_index": {
          "$ref": "#/$defs/evidence/properties/message_index"
        },
        "quote": {
          "$ref": "#/$defs/evidence/properties/quote"
        },
        "read_request": {
          "$ref": "#/$defs/citationSource/properties/read_request"
        },
        "end_offset": {
          "$ref": "#/$defs/citationSource/properties/end_offset"
        }
      }
    },
    "citationSource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidence_id",
        "message_index",
        "quote",
        "origin",
        "read_request",
        "end_offset"
      ],
      "properties": {
        "evidence_id": {
          "type": "string",
          "minLength": 1
        },
        "message_index": {
          "type": "integer",
          "minimum": 0
        },
        "quote": {
          "type": "string",
          "minLength": 1
        },
        "origin": {
          "enum": [
            "tool_return",
            "model_visible"
          ]
        },
        "end_offset": {
          "type": "integer",
          "minimum": 1
        },
        "read_request": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "message_index",
            "path",
            "offset",
            "max_chars"
          ],
          "properties": {
            "message_index": {
              "type": "integer",
              "minimum": 0
            },
            "path": {
              "type": "string"
            },
            "offset": {
              "type": "integer",
              "minimum": 0
            },
            "max_chars": {
              "type": "integer",
              "minimum": 1,
              "maximum": 16000
            }
          }
        },
        "document_url": {
          "type": "string",
          "minLength": 1
        },
        "request_query": {
          "type": "string"
        }
      }
    },
    "answer_generation": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "required": [
        "available",
        "message_type",
        "message_index",
        "captured_final_message_index",
        "matches_captured_final",
        "blocks",
        "input_contexts"
      ],
      "properties": {
        "available": {
          "const": true
        },
        "message_type": {
          "const": "llm_turn"
        },
        "message_index": {
          "type": "integer",
          "minimum": 0
        },
        "captured_final_message_index": {
          "type": "integer",
          "minimum": 0
        },
        "matches_captured_final": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "blocks": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "total_chars",
              "text",
              "reference",
              "read_request"
            ],
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              },
              "total_chars": {
                "type": "integer",
                "minimum": 1
              },
              "text": {
                "type": "string",
                "minLength": 1
              },
              "reference": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "evidence_id"
                ],
                "properties": {
                  "evidence_id": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              },
              "read_request": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "message_index",
                  "path",
                  "offset",
                  "max_chars"
                ],
                "properties": {
                  "message_index": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "path": {
                    "type": "string",
                    "minLength": 1
                  },
                  "offset": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "max_chars": {
                    "type": "integer",
                    "minimum": 1
                  }
                }
              }
            }
          }
        },
        "input_contexts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "message_index",
              "path",
              "total_chars",
              "read_request"
            ],
            "properties": {
              "message_index": {
                "type": "integer",
                "minimum": 0
              },
              "path": {
                "type": "string",
                "minLength": 1
              },
              "total_chars": {
                "type": "integer",
                "minimum": 1
              },
              "read_request": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "message_index",
                  "path",
                  "offset",
                  "max_chars"
                ],
                "properties": {
                  "message_index": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "path": {
                    "type": "string",
                    "minLength": 1
                  },
                  "offset": {
                    "const": 0
                  },
                  "max_chars": {
                    "const": 16000
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
