{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "ground_truth",
    "candidates",
    "attributions",
    "task_analysis"
  ],
  "properties": {
    "ground_truth": {
      "type": "object",
      "required": [
        "available",
        "value"
      ],
      "properties": {
        "available": {
          "type": "boolean"
        },
        "value": {}
      }
    },
    "candidates": {
      "type": "object",
      "required": [
        "A",
        "B"
      ],
      "additionalProperties": {
        "type": "object",
        "required": [
          "final_message_index",
          "deferred_final_material",
          "original_answer_timing",
          "original_answer_usage",
          "candidate_id"
        ],
        "properties": {
          "deferred_final_material": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "message_index",
                "path",
                "total_chars"
              ],
              "properties": {
                "message_index": {
                  "type": "integer",
                  "minimum": 0
                },
                "path": {
                  "type": "string",
                  "minLength": 1
                },
                "total_chars": {
                  "type": "integer",
                  "minimum": 1
                }
              }
            }
          },
          "final_message_index": {
            "type": "integer",
            "minimum": 0
          },
          "original_answer_timing": {
            "type": "object",
            "required": [
              "finish_seconds"
            ],
            "properties": {
              "finish_seconds": {
                "type": [
                  "number",
                  "null"
                ],
                "minimum": 0
              },
              "first_token_seconds": {
                "type": [
                  "number",
                  "null"
                ],
                "minimum": 0
              },
              "first_answer_seconds": {
                "type": [
                  "number",
                  "null"
                ],
                "minimum": 0
              }
            }
          },
          "original_answer_usage": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "input_tokens",
              "output_tokens",
              "total_tokens",
              "cached_input_tokens",
              "total_tokens_basis",
              "source_fields",
              "issues"
            ],
            "properties": {
              "input_tokens": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 0
              },
              "output_tokens": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 0
              },
              "total_tokens": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 0
              },
              "cached_input_tokens": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 0
              },
              "total_tokens_basis": {
                "enum": [
                  "reported",
                  "input_plus_output",
                  null
                ]
              },
              "source_fields": {
                "type": "object",
                "required": [
                  "input_tokens",
                  "output_tokens",
                  "total_tokens",
                  "cached_input_tokens"
                ],
                "additionalProperties": {
                  "type": "string"
                }
              },
              "issues": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          },
          "candidate_id": {
            "type": "string",
            "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
          },
          "instruction_sources": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/instructionSource"
            }
          },
          "citation_inventory": {
            "$ref": "#/$defs/citationInventory"
          },
          "answer_generation": {
            "$ref": "#/$defs/answer_generation"
          }
        }
      },
      "minProperties": 2,
      "maxProperties": 2
    },
    "attributions": {
      "type": "object",
      "required": [
        "A",
        "B"
      ],
      "minProperties": 2,
      "maxProperties": 2,
      "additionalProperties": {
        "type": "object",
        "required": [
          "criterion_assessments",
          "core_assessment",
          "findings",
          "task_analysis"
        ],
        "properties": {
          "criterion_assessments": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "criterion_id",
                "status",
                "evidence_status",
                "summary",
                "evidence"
              ],
              "properties": {
                "criterion_id": {
                  "type": "string",
                  "minLength": 1
                },
                "status": {
                  "enum": [
                    "met",
                    "partial",
                    "unmet",
                    "unknown",
                    "not_applicable"
                  ]
                },
                "evidence_status": {
                  "enum": [
                    "established",
                    "uncertain"
                  ]
                },
                "summary": {
                  "type": "string",
                  "minLength": 1
                },
                "evidence": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "evidence_id",
                      "message_index",
                      "quote"
                    ],
                    "properties": {
                      "message_index": {
                        "type": "integer",
                        "minimum": 0
                      },
                      "quote": {
                        "type": "string",
                        "minLength": 1
                      },
                      "source": {
                        "type": "string",
                        "minLength": 1
                      },
                      "source_input_id": {
                        "type": "string",
                        "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
                      },
                      "evidence_id": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "dependentRequired": {
                      "source": [
                        "source_input_id"
                      ],
                      "source_input_id": [
                        "source"
                      ]
                    }
                  }
                },
                "context_evidence": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "evidence_id",
                      "message_index",
                      "quote"
                    ],
                    "properties": {
                      "message_index": {
                        "type": "integer",
                        "minimum": 0
                      },
                      "quote": {
                        "type": "string",
                        "minLength": 1
                      },
                      "source": {
                        "type": "string",
                        "minLength": 1
                      },
                      "source_input_id": {
                        "type": "string",
                        "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
                      },
                      "evidence_id": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "dependentRequired": {
                      "source": [
                        "source_input_id"
                      ],
                      "source_input_id": [
                        "source"
                      ]
                    }
                  },
                  "minItems": 1
                }
              },
              "additionalProperties": false
            }
          },
          "core_assessment": {
            "type": "object",
            "required": [
              "meets_core",
              "reason",
              "criterion_ids"
            ],
            "properties": {
              "meets_core": {
                "type": [
                  "boolean",
                  "null"
                ]
              },
              "reason": {
                "type": "string",
                "minLength": 1
              },
              "criterion_ids": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "additionalProperties": false
          },
          "findings": {
            "type": "array"
          },
          "task_analysis": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "task_type",
              "goal",
              "requirements",
              "scoring_points",
              "red_flags"
            ],
            "properties": {
              "task_type": {
                "type": "string",
                "minLength": 1
              },
              "goal": {
                "type": "string",
                "minLength": 1
              },
              "requirements": {
                "type": "array",
                "minItems": 1,
                "maxItems": 24,
                "items": {
                  "$ref": "#/$defs/criterion"
                }
              },
              "scoring_points": {
                "type": "array",
                "maxItems": 24,
                "items": {
                  "$ref": "#/$defs/criterion"
                }
              },
              "red_flags": {
                "type": "array",
                "maxItems": 24,
                "items": {
                  "$ref": "#/$defs/criterion"
                }
              }
            }
          }
        }
      }
    },
    "task_analysis": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "task_type",
        "goal",
        "requirements",
        "scoring_points",
        "red_flags"
      ],
      "properties": {
        "task_type": {
          "type": "string",
          "minLength": 1
        },
        "goal": {
          "type": "string",
          "minLength": 1
        },
        "requirements": {
          "type": "array",
          "minItems": 1,
          "maxItems": 24,
          "items": {
            "$ref": "#/$defs/criterion"
          }
        },
        "scoring_points": {
          "type": "array",
          "maxItems": 24,
          "items": {
            "$ref": "#/$defs/criterion"
          }
        },
        "red_flags": {
          "type": "array",
          "maxItems": 24,
          "items": {
            "$ref": "#/$defs/criterion"
          }
        }
      }
    },
    "source_review": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "reason",
            "requires_review"
          ],
          "properties": {
            "kind": {
              "enum": [
                "unverified",
                "unresolved_conflict",
                "invalid_material"
              ]
            },
            "reason": {
              "type": "string",
              "minLength": 1
            },
            "requires_review": {
              "type": "boolean"
            }
          },
          "allOf": [
            {
              "if": {
                "properties": {
                  "kind": {
                    "enum": [
                      "invalid_material"
                    ]
                  }
                }
              },
              "then": {
                "properties": {
                  "requires_review": {
                    "const": true
                  }
                }
              }
            }
          ]
        }
      }
    }
  },
  "$defs": {
    "criterion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "text",
        "applies_to",
        "acceptance_rule"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]{0,31}$"
        },
        "text": {
          "type": "string",
          "minLength": 1
        },
        "applies_to": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
          }
        },
        "acceptance_rule": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidence_id",
        "message_index",
        "quote"
      ],
      "properties": {
        "evidence_id": {
          "type": "string",
          "minLength": 1
        },
        "message_index": {
          "type": "integer",
          "minimum": 0
        },
        "quote": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "instructionSource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "message_index",
        "path",
        "role",
        "content",
        "evidence"
      ],
      "properties": {
        "message_index": {
          "type": "integer",
          "minimum": 0
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "role": {
          "enum": [
            "system",
            "developer"
          ]
        },
        "content": {},
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidence"
          }
        }
      }
    },
    "citationInventory": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocols",
        "references",
        "document_groups"
      ],
      "properties": {
        "protocols": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "footnote",
              "trace",
              "vis-html"
            ]
          }
        },
        "references": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "reference",
              "format",
              "status",
              "occurrences",
              "sources"
            ],
            "properties": {
              "reference": {
                "type": "string",
                "minLength": 1
              },
              "format": {
                "enum": [
                  "footnote",
                  "trace",
                  "vis-html"
                ]
              },
              "status": {
                "enum": [
                  "resolved",
                  "ambiguous",
                  "unknown"
                ]
              },
              "occurrences": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/citationOccurrence"
                }
              },
              "sources": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/citationSource"
                }
              }
            }
          }
        },
        "document_groups": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "url",
              "references"
            ],
            "properties": {
              "url": {
                "type": "string",
                "minLength": 1
              },
              "references": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "format",
                    "reference"
                  ],
                  "properties": {
                    "format": {
                      "enum": [
                        "footnote",
                        "trace",
                        "vis-html"
                      ]
                    },
                    "reference": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "citationOccurrence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidence_id",
        "message_index",
        "quote",
        "context"
      ],
      "properties": {
        "evidence_id": {
          "$ref": "#/$defs/evidence/properties/evidence_id"
        },
        "message_index": {
          "$ref": "#/$defs/evidence/properties/message_index"
        },
        "quote": {
          "$ref": "#/$defs/evidence/properties/quote"
        },
        "context": {
          "$ref": "#/$defs/citationContext"
        }
      }
    },
    "citationContext": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidence_id",
        "message_index",
        "quote",
        "read_request",
        "end_offset"
      ],
      "properties": {
        "evidence_id": {
          "$ref": "#/$defs/evidence/properties/evidence_id"
        },
        "message_index": {
          "$ref": "#/$defs/evidence/properties/message_index"
        },
        "quote": {
          "$ref": "#/$defs/evidence/properties/quote"
        },
        "read_request": {
          "$ref": "#/$defs/citationSource/properties/read_request"
        },
        "end_offset": {
          "$ref": "#/$defs/citationSource/properties/end_offset"
        }
      }
    },
    "citationSource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidence_id",
        "message_index",
        "quote",
        "origin",
        "read_request",
        "end_offset"
      ],
      "properties": {
        "evidence_id": {
          "type": "string",
          "minLength": 1
        },
        "message_index": {
          "type": "integer",
          "minimum": 0
        },
        "quote": {
          "type": "string",
          "minLength": 1
        },
        "origin": {
          "enum": [
            "tool_return",
            "model_visible"
          ]
        },
        "end_offset": {
          "type": "integer",
          "minimum": 1
        },
        "read_request": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "message_index",
            "path",
            "offset",
            "max_chars"
          ],
          "properties": {
            "message_index": {
              "type": "integer",
              "minimum": 0
            },
            "path": {
              "type": "string"
            },
            "offset": {
              "type": "integer",
              "minimum": 0
            },
            "max_chars": {
              "type": "integer",
              "minimum": 1,
              "maximum": 16000
            }
          }
        },
        "document_url": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "answer_generation": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "required": [
        "available",
        "message_type",
        "message_index",
        "captured_final_message_index",
        "matches_captured_final",
        "blocks",
        "input_contexts"
      ],
      "properties": {
        "available": {
          "const": true
        },
        "message_type": {
          "const": "llm_turn"
        },
        "message_index": {
          "type": "integer",
          "minimum": 0
        },
        "captured_final_message_index": {
          "type": "integer",
          "minimum": 0
        },
        "matches_captured_final": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "blocks": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "total_chars",
              "text",
              "reference",
              "read_request"
            ],
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              },
              "total_chars": {
                "type": "integer",
                "minimum": 1
              },
              "text": {
                "type": "string",
                "minLength": 1
              },
              "reference": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "evidence_id"
                ],
                "properties": {
                  "evidence_id": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              },
              "read_request": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "message_index",
                  "path",
                  "offset",
                  "max_chars"
                ],
                "properties": {
                  "message_index": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "path": {
                    "type": "string",
                    "minLength": 1
                  },
                  "offset": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "max_chars": {
                    "type": "integer",
                    "minimum": 1
                  }
                }
              }
            }
          }
        },
        "input_contexts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "message_index",
              "path",
              "total_chars",
              "read_request"
            ],
            "properties": {
              "message_index": {
                "type": "integer",
                "minimum": 0
              },
              "path": {
                "type": "string",
                "minLength": 1
              },
              "total_chars": {
                "type": "integer",
                "minimum": 1
              },
              "read_request": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "message_index",
                  "path",
                  "offset",
                  "max_chars"
                ],
                "properties": {
                  "message_index": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "path": {
                    "type": "string",
                    "minLength": 1
                  },
                  "offset": {
                    "const": 0
                  },
                  "max_chars": {
                    "const": 16000
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
