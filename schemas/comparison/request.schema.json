{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "ground_truth",
    "candidates",
    "attributions",
    "strength_checks",
    "task_analysis"
  ],
  "properties": {
    "ground_truth": {
      "type": "object",
      "required": [
        "available",
        "value"
      ],
      "properties": {
        "available": {
          "type": "boolean"
        },
        "value": {}
      }
    },
    "candidates": {
      "type": "object",
      "required": [
        "A",
        "B"
      ],
      "additionalProperties": {
        "type": "object",
        "required": [
          "final_message_index",
          "deferred_final_material",
          "original_answer_timing",
          "original_answer_usage",
          "candidate_id"
        ],
        "properties": {
          "deferred_final_material": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "message_index",
                "path",
                "total_chars"
              ],
              "properties": {
                "message_index": {
                  "type": "integer",
                  "minimum": 0
                },
                "path": {
                  "type": "string",
                  "minLength": 1
                },
                "total_chars": {
                  "type": "integer",
                  "minimum": 1
                }
              }
            }
          },
          "final_message_index": {
            "type": "integer",
            "minimum": 0
          },
          "original_answer_timing": {
            "type": "object",
            "required": [
              "finish_seconds"
            ],
            "properties": {
              "finish_seconds": {
                "type": [
                  "number",
                  "null"
                ],
                "minimum": 0
              },
              "first_token_seconds": {
                "type": [
                  "number",
                  "null"
                ],
                "minimum": 0
              },
              "first_answer_seconds": {
                "type": [
                  "number",
                  "null"
                ],
                "minimum": 0
              }
            }
          },
          "original_answer_usage": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "input_tokens",
              "output_tokens",
              "total_tokens",
              "cached_input_tokens",
              "total_tokens_basis",
              "source_fields",
              "issues"
            ],
            "properties": {
              "input_tokens": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 0
              },
              "output_tokens": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 0
              },
              "total_tokens": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 0
              },
              "cached_input_tokens": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 0
              },
              "total_tokens_basis": {
                "enum": [
                  "reported",
                  "input_plus_output",
                  null
                ]
              },
              "source_fields": {
                "type": "object",
                "required": [
                  "input_tokens",
                  "output_tokens",
                  "total_tokens",
                  "cached_input_tokens"
                ],
                "additionalProperties": {
                  "type": "string"
                }
              },
              "issues": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          },
          "candidate_id": {
            "type": "string",
            "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
          }
        }
      },
      "minProperties": 2,
      "maxProperties": 2
    },
    "attributions": {
      "type": "object",
      "required": [
        "A",
        "B"
      ],
      "minProperties": 2,
      "maxProperties": 2,
      "additionalProperties": {
        "type": "object",
        "required": [
          "criterion_assessments",
          "core_assessment",
          "findings",
          "task_analysis"
        ],
        "properties": {
          "criterion_assessments": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "criterion_id",
                "status",
                "evidence_status",
                "summary",
                "evidence"
              ],
              "properties": {
                "criterion_id": {
                  "type": "string",
                  "minLength": 1
                },
                "status": {
                  "enum": [
                    "met",
                    "partial",
                    "unmet",
                    "unknown",
                    "not_applicable"
                  ]
                },
                "evidence_status": {
                  "enum": [
                    "established",
                    "uncertain"
                  ]
                },
                "summary": {
                  "type": "string",
                  "minLength": 1
                },
                "evidence": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "message_index",
                      "quote"
                    ],
                    "properties": {
                      "message_index": {
                        "type": "integer",
                        "minimum": 0
                      },
                      "quote": {
                        "type": "string",
                        "minLength": 1
                      }
                    }
                  }
                }
              },
              "additionalProperties": false
            }
          },
          "core_assessment": {
            "type": "object",
            "required": [
              "meets_core",
              "reason",
              "criterion_ids"
            ],
            "properties": {
              "meets_core": {
                "type": [
                  "boolean",
                  "null"
                ]
              },
              "reason": {
                "type": "string",
                "minLength": 1
              },
              "criterion_ids": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "additionalProperties": false
          },
          "findings": {
            "type": "array"
          },
          "task_analysis": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "task_type",
              "goal",
              "requirements",
              "scoring_points",
              "red_flags"
            ],
            "properties": {
              "task_type": {
                "type": "string",
                "minLength": 1
              },
              "goal": {
                "type": "string",
                "minLength": 1
              },
              "requirements": {
                "type": "array",
                "minItems": 1,
                "maxItems": 24,
                "items": {
                  "$ref": "#/$defs/criterion"
                }
              },
              "scoring_points": {
                "type": "array",
                "maxItems": 24,
                "items": {
                  "$ref": "#/$defs/criterion"
                }
              },
              "red_flags": {
                "type": "array",
                "maxItems": 24,
                "items": {
                  "$ref": "#/$defs/criterion"
                }
              }
            }
          }
        }
      }
    },
    "strength_checks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "candidate",
          "finding_index",
          "counterparts"
        ],
        "properties": {
          "candidate": {
            "type": "string",
            "minLength": 1
          },
          "finding_index": {
            "type": "integer",
            "minimum": 0
          },
          "counterparts": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "task_analysis": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "task_type",
        "goal",
        "requirements",
        "scoring_points",
        "red_flags"
      ],
      "properties": {
        "task_type": {
          "type": "string",
          "minLength": 1
        },
        "goal": {
          "type": "string",
          "minLength": 1
        },
        "requirements": {
          "type": "array",
          "minItems": 1,
          "maxItems": 24,
          "items": {
            "$ref": "#/$defs/criterion"
          }
        },
        "scoring_points": {
          "type": "array",
          "maxItems": 24,
          "items": {
            "$ref": "#/$defs/criterion"
          }
        },
        "red_flags": {
          "type": "array",
          "maxItems": 24,
          "items": {
            "$ref": "#/$defs/criterion"
          }
        }
      }
    },
    "source_review": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  },
  "$defs": {
    "criterion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "text",
        "applies_to",
        "acceptance_rule"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]{0,31}$"
        },
        "text": {
          "type": "string",
          "minLength": 1
        },
        "applies_to": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
          }
        },
        "acceptance_rule": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
