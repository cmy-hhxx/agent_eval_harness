{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "concern_matches",
    "source_reviews"
  ],
  "properties": {
    "concern_matches": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "concern_index",
          "finding_indices",
          "observation"
        ],
        "properties": {
          "concern_index": {
            "type": "integer",
            "minimum": 0
          },
          "finding_indices": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "integer",
              "minimum": 0
            }
          },
          "observation": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        }
      }
    },
    "source_reviews": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "slot_index",
          "candidate",
          "reason"
        ],
        "properties": {
          "slot_index": {
            "type": "integer",
            "minimum": 0
          },
          "candidate": {
            "enum": [
              "A",
              "B"
            ]
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        }
      }
    }
  }
}
