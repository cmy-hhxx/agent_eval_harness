{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "a_summary",
    "b_summary",
    "comparisons",
    "relative_preference",
    "a_tradeoff",
    "b_tradeoff"
  ],
  "properties": {
    "comparisons": {
      "type": "array",
      "items": {
        "anyOf": [
          {
            "$ref": "#/$defs/commentary"
          },
          {
            "$ref": "#/$defs/resource"
          }
        ]
      }
    },
    "preference": {
      "enum": [
        "A",
        "B",
        null
      ]
    },
    "a_tradeoff": {
      "type": "string",
      "minLength": 1
    },
    "b_tradeoff": {
      "type": "string",
      "minLength": 1
    },
    "relative_preference": {
      "enum": [
        "A",
        "B"
      ]
    },
    "a_summary": {
      "type": "string",
      "minLength": 1
    },
    "b_summary": {
      "type": "string",
      "minLength": 1
    }
  },
  "$defs": {
    "commentary": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "required": [
        "importance"
      ],
      "properties": {
        "importance": {
          "enum": [
            "high",
            "medium",
            "low"
          ]
        },
        "better_candidate": {
          "enum": [
            "A",
            "B",
            null
          ]
        }
      }
    },
    "resource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "importance"
      ],
      "properties": {
        "importance": {
          "enum": [
            "high",
            "medium",
            "low"
          ]
        }
      }
    }
  }
}
