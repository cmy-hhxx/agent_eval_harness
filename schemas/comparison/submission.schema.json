{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "a_summary",
    "b_summary",
    "comparisons",
    "tradeoff"
  ],
  "properties": {
    "comparisons": {
      "type": "array",
      "items": {
        "type": [
          "object",
          "null"
        ],
        "additionalProperties": false,
        "required": [
          "importance",
          "a_summary",
          "b_summary"
        ],
        "properties": {
          "importance": {
            "enum": [
              "high",
              "medium",
              "low"
            ]
          },
          "better_candidate": {
            "enum": [
              "A",
              "B",
              null
            ]
          },
          "a_summary": {
            "type": "string",
            "minLength": 1
          },
          "b_summary": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "preference": {
      "enum": [
        "A",
        "B",
        null
      ]
    },
    "tradeoff": {
      "type": "string",
      "minLength": 1
    },
    "a_summary": {
      "type": "string",
      "minLength": 1
    },
    "b_summary": {
      "type": "string",
      "minLength": 1
    }
  }
}
