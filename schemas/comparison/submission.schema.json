{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "a_summary",
    "b_summary",
    "comparisons",
    "relative_preference",
    "tradeoff"
  ],
  "properties": {
    "source_reviews": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["slot_index", "candidate", "reason"],
        "properties": {
          "slot_index": { "type": "integer", "minimum": 0 },
          "candidate": { "enum": ["A", "B"] },
          "reason": { "type": "string", "minLength": 1, "pattern": "\\S" }
        }
      }
    },
    "scope_conflicts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["slot_index", "reason"],
        "properties": {
          "slot_index": { "type": "integer", "minimum": 0 },
          "reason": { "type": "string", "minLength": 1, "pattern": "\\S" }
        }
      }
    },
    "comparisons": {
      "type": "array",
      "items": {
        "anyOf": [
          {
            "$ref": "#/$defs/commentary"
          },
          {
            "$ref": "#/$defs/resource"
          }
        ]
      }
    },
    "preference": {
      "enum": [
        "A",
        "B",
        null
      ]
    },
    "tradeoff": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "relative_preference": {
      "enum": [
        "A",
        "B",
        null
      ]
    },
    "a_summary": {
      "type": "string",
      "minLength": 1
    },
    "b_summary": {
      "type": "string",
      "minLength": 1
    }
  },
  "$defs": {
    "commentary": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "required": [
        "importance"
      ],
      "properties": {
        "importance": {
          "enum": [
            "high",
            "medium",
            "low"
          ]
        },
        "better_candidate": {
          "enum": [
            "A",
            "B",
            null
          ]
        }
      }
    },
    "resource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "importance"
      ],
      "properties": {
        "importance": {
          "enum": [
            "high",
            "medium",
            "low"
          ]
        }
      }
    }
  }
}
