{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "comparisons",
    "relative_preference",
    "tradeoff",
    "assessments"
  ],
  "properties": {
    "source_reviews": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "slot_index",
          "candidate",
          "reason"
        ],
        "properties": {
          "slot_index": {
            "type": "integer",
            "minimum": 0
          },
          "candidate": {
            "enum": [
              "A",
              "B"
            ]
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        }
      }
    },
    "scope_conflicts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "slot_index",
          "reason"
        ],
        "properties": {
          "slot_index": {
            "type": "integer",
            "minimum": 0
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        }
      }
    },
    "comparisons": {
      "type": "array",
      "items": {
        "anyOf": [
          {
            "$ref": "#/$defs/commentary"
          },
          {
            "$ref": "#/$defs/resource"
          }
        ]
      }
    },
    "preference": {
      "enum": [
        "A",
        "B",
        null
      ]
    },
    "tradeoff": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "relative_preference": {
      "enum": [
        "A",
        "B",
        null
      ]
    },
    "assessments": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "meets_core",
          "summary",
          "core_failure_refs"
        ],
        "properties": {
          "meets_core": {
            "type": [
              "boolean",
              "null"
            ],
            "description": "照录来源core_assessment；证据不足时仅needs_review可为null。核心失败明确引用已确认的requirements。"
          },
          "summary": {
            "type": "string",
            "minLength": 1
          },
          "core_failure_refs": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    }
  },
  "$defs": {
    "commentary": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "required": [
        "importance",
        "assessments"
      ],
      "properties": {
        "importance": {
          "enum": [
            "high",
            "medium",
            "low"
          ]
        },
        "better_candidate": {
          "enum": [
            "A",
            "B",
            null
          ]
        },
        "assessments": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "summary",
              "finding_indices",
              "status",
              "evidence_status"
            ],
            "properties": {
              "summary": {
                "type": "string",
                "minLength": 1
              },
              "finding_indices": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "type": "integer",
                  "minimum": 0
                }
              },
              "status": {
                "enum": [
                  "met",
                  "partial",
                  "unmet",
                  "unknown",
                  "not_applicable"
                ]
              },
              "evidence_status": {
                "enum": [
                  "established",
                  "uncertain"
                ]
              }
            }
          }
        }
      }
    },
    "resource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "importance"
      ],
      "properties": {
        "importance": {
          "enum": [
            "high",
            "medium",
            "low"
          ]
        }
      }
    }
  }
}
