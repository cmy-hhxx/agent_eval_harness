{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "comparisons",
    "relative_preference",
    "tradeoff",
    "a_core",
    "a_core_refs",
    "a_summary",
    "b_core",
    "b_core_refs",
    "b_summary"
  ],
  "properties": {
    "source_reviews": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "slot_index",
          "candidate",
          "reason"
        ],
        "properties": {
          "slot_index": {
            "type": "integer",
            "minimum": 0
          },
          "candidate": {
            "enum": [
              "A",
              "B"
            ]
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        }
      }
    },
    "scope_conflicts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "slot_index",
          "reason"
        ],
        "properties": {
          "slot_index": {
            "type": "integer",
            "minimum": 0
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        }
      }
    },
    "comparisons": {
      "type": "array",
      "minItems": 1,
      "items": {
        "anyOf": [
          {
            "$ref": "#/$defs/commentary"
          },
          {
            "$ref": "#/$defs/resource"
          }
        ]
      }
    },
    "quality_winner": {
      "enum": [
        "A",
        "B",
        null
      ]
    },
    "tradeoff": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "relative_preference": {
      "enum": [
        "A",
        "B",
        null
      ]
    },
    "a_core": {
      "type": [
        "boolean",
        "null"
      ],
      "description": "独立判断主要交付是否可用；证据不足时仅needs_review可为null。核心失败明确引用已确认的requirements。"
    },
    "a_core_refs": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "a_summary": {
      "type": "string",
      "minLength": 1
    },
    "b_core": {
      "type": [
        "boolean",
        "null"
      ],
      "description": "独立判断主要交付是否可用；证据不足时仅needs_review可为null。核心失败明确引用已确认的requirements。"
    },
    "b_core_refs": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "b_summary": {
      "type": "string",
      "minLength": 1
    }
  },
  "$defs": {
    "commentary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "slot_index",
        "importance",
        "a_status",
        "a_summary",
        "a_findings",
        "b_status",
        "b_summary",
        "b_findings"
      ],
      "properties": {
        "slot_index": {
          "type": "integer",
          "minimum": 0
        },
        "importance": {
          "enum": [
            "high",
            "medium",
            "low"
          ]
        },
        "better_candidate": {
          "enum": [
            "A",
            "B",
            null
          ]
        },
        "a_status": {
          "enum": [
            "met",
            "partial",
            "unmet",
            "unknown",
            "not_applicable"
          ]
        },
        "a_summary": {
          "type": "string",
          "minLength": 1
        },
        "a_findings": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "integer",
            "minimum": 0
          }
        },
        "b_status": {
          "enum": [
            "met",
            "partial",
            "unmet",
            "unknown",
            "not_applicable"
          ]
        },
        "b_summary": {
          "type": "string",
          "minLength": 1
        },
        "b_findings": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "resource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "slot_index",
        "importance"
      ],
      "properties": {
        "slot_index": {
          "type": "integer",
          "minimum": 0
        },
        "importance": {
          "enum": [
            "high",
            "medium",
            "low"
          ]
        }
      }
    }
  }
}
