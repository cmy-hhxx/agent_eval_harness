{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "assessments",
    "comparisons",
    "tradeoff"
  ],
  "properties": {
    "assessments": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "A",
        "B"
      ],
      "properties": {
        "A": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "summary"
          ],
          "properties": {
            "summary": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "B": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "summary"
          ],
          "properties": {
            "summary": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "comparisons": {
      "type": "array",
      "items": {
        "type": [
          "object",
          "null"
        ],
        "additionalProperties": false,
        "required": [
          "importance",
          "assessments"
        ],
        "properties": {
          "importance": {
            "enum": [
              "high",
              "medium",
              "low"
            ]
          },
          "better_candidate": {
            "enum": [
              "A",
              "B",
              null
            ]
          },
          "assessments": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "A",
              "B"
            ],
            "properties": {
              "A": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "summary"
                ],
                "properties": {
                  "summary": {
                    "type": "string",
                    "minLength": 1
                  },
                  "source_review": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "minLength": 1,
                    "pattern": "\\S"
                  }
                }
              },
              "B": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "summary"
                ],
                "properties": {
                  "summary": {
                    "type": "string",
                    "minLength": 1
                  },
                  "source_review": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "minLength": 1,
                    "pattern": "\\S"
                  }
                }
              }
            }
          }
        }
      }
    },
    "preference": {
      "enum": [
        "A",
        "B",
        null
      ]
    },
    "tradeoff": {
      "type": "string",
      "minLength": 1
    }
  }
}
