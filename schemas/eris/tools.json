{
  "list_data": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "runId": {
        "type": "string",
        "minLength": 1,
        "description": "省略时列出评测运行及 currentRun 的完整 summary，当前数量和进度直接使用它；提供时列出该运行的回答输入、任务引用及完整 summary。"
      },
      "query": {
        "type": "string",
        "minLength": 1,
        "description": "可选的字面文本筛选词，用于匹配运行名或输入目录内容；不是数据类别。查看完整输入目录时省略，不传 inputs、tasks 或空字符串。空筛选结果不代表该运行没有数据。"
      },
      "offset": {
        "type": "integer",
        "minimum": 0
      },
      "limit": {
        "type": "integer",
        "minimum": 1,
        "maximum": 100
      }
    },
    "required": []
  },
  "read_data": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "reference": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "runId": {
            "type": "string",
            "minLength": 1
          },
          "inputId": {
            "type": "string",
            "minLength": 1
          },
          "taskId": {
            "type": "string",
            "minLength": 1
          },
          "messageIndex": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [
          "runId"
        ],
        "oneOf": [
          {
            "required": [
              "inputId"
            ],
            "not": {
              "required": [
                "taskId"
              ]
            }
          },
          {
            "required": [
              "taskId"
            ],
            "not": {
              "anyOf": [
                {
                  "required": [
                    "inputId"
                  ]
                },
                {
                  "required": [
                    "messageIndex"
                  ]
                }
              ]
            }
          }
        ]
      },
      "offset": {
        "type": "integer",
        "minimum": 0
      },
      "limit": {
        "type": "integer",
        "minimum": 1,
        "maximum": 16000,
        "description": "消息目录按条，默认30、最多100；正文按 UTF-16 字符，默认8000、最多16000。"
      }
    },
    "required": [
      "reference"
    ],
    "allOf": [
      {
        "if": {
          "properties": {
            "reference": {
              "required": [
                "taskId"
              ]
            }
          }
        },
        "then": {
          "not": {
            "anyOf": [
              {
                "required": [
                  "offset"
                ]
              },
              {
                "required": [
                  "limit"
                ]
              }
            ]
          }
        }
      },
      {
        "if": {
          "properties": {
            "reference": {
              "required": [
                "messageIndex"
              ]
            }
          }
        },
        "else": {
          "properties": {
            "limit": {
              "maximum": 100
            }
          }
        }
      }
    ]
  },
  "search_data": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "reference": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "runId": {
            "type": "string",
            "minLength": 1
          },
          "inputId": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "runId",
          "inputId"
        ]
      },
      "query": {
        "type": "string",
        "minLength": 1
      },
      "offset": {
        "type": "integer",
        "minimum": 0
      },
      "limit": {
        "type": "integer",
        "minimum": 1,
        "maximum": 100
      }
    },
    "required": [
      "reference",
      "query"
    ]
  },
  "search_web": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "queries"
    ],
    "properties": {
      "queries": {
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "query"
          ],
          "properties": {
            "query": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S",
              "maxLength": 500
            },
            "domains": {
              "type": "array",
              "items": {
                "type": "string",
                "maxLength": 253,
                "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9-]{0,61}[A-Za-z0-9])?(?:\\.[A-Za-z0-9](?:[A-Za-z0-9-]{0,61}[A-Za-z0-9])?)+$"
              },
              "uniqueItems": true,
              "minItems": 1,
              "maxItems": 5
            },
            "country": {
              "type": "string",
              "pattern": "^[a-z]{2}$"
            },
            "language": {
              "type": "string",
              "pattern": "^[a-z]{2}(-[a-z]{2})?$"
            },
            "page": {
              "type": "integer",
              "minimum": 1,
              "maximum": 3
            }
          }
        },
        "minItems": 1,
        "maxItems": 4,
        "uniqueItems": true
      },
      "category": {
        "type": "string",
        "enum": [
          "web",
          "news"
        ]
      },
      "timeRange": {
        "type": "string",
        "enum": [
          "day",
          "week",
          "month",
          "year"
        ]
      },
      "dateFrom": {
        "type": "string",
        "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
      },
      "dateTo": {
        "type": "string",
        "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
      },
      "limit": {
        "type": "integer",
        "minimum": 1,
        "maximum": 20
      }
    },
    "allOf": [
      {
        "not": {
          "required": [
            "timeRange",
            "dateFrom"
          ]
        }
      },
      {
        "not": {
          "required": [
            "timeRange",
            "dateTo"
          ]
        }
      }
    ]
  },
  "view_image": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "reference": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "runId": {
            "type": "string",
            "minLength": 1
          },
          "inputId": {
            "type": "string",
            "minLength": 1
          },
          "messageIndex": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [
          "runId",
          "inputId",
          "messageIndex"
        ]
      }
    },
    "required": [
      "reference"
    ]
  },
  "calculate": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "operation": {
        "enum": [
          "add",
          "subtract",
          "multiply",
          "divide"
        ]
      },
      "operands": {
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1
        },
        "minItems": 2,
        "maxItems": 20
      }
    },
    "required": [
      "operation",
      "operands"
    ]
  },
  "call_specialist": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "operationId": {
        "type": "string",
        "minLength": 1,
        "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
      },
      "kind": {
        "enum": [
          "attribution",
          "comparison"
        ]
      },
      "inputs": {
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "runId": {
              "type": "string",
              "minLength": 1
            },
            "inputId": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "runId",
            "inputId"
          ]
        },
        "minItems": 1,
        "maxItems": 3
      },
      "attributions": {
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "inputId": {
              "type": "string",
              "minLength": 1
            },
            "operationId": {
              "type": "string",
              "minLength": 1,
              "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
            },
            "runId": {
              "type": "string",
              "minLength": 1
            },
            "taskId": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "inputId"
          ],
          "oneOf": [
            {
              "required": [
                "operationId"
              ],
              "not": {
                "anyOf": [
                  {
                    "required": [
                      "runId"
                    ]
                  },
                  {
                    "required": [
                      "taskId"
                    ]
                  }
                ]
              }
            },
            {
              "required": [
                "runId",
                "taskId"
              ],
              "not": {
                "required": [
                  "operationId"
                ]
              }
            }
          ]
        },
        "maxItems": 3
      }
    },
    "required": [
      "operationId",
      "kind",
      "inputs"
    ],
    "allOf": [
      {
        "if": {
          "properties": {
            "kind": {
              "const": "attribution"
            }
          }
        },
        "then": {
          "properties": {
            "inputs": {
              "minItems": 1,
              "maxItems": 1
            }
          },
          "not": {
            "required": [
              "attributions"
            ]
          }
        },
        "else": {
          "properties": {
            "inputs": {
              "minItems": 2,
              "maxItems": 3
            }
          }
        }
      }
    ]
  },
  "read_specialist": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "operationId": {
        "type": "string",
        "minLength": 1,
        "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
      }
    },
    "required": [
      "operationId"
    ]
  },
  "save_summary": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "markdown": {
        "type": "string",
        "minLength": 1,
        "maxLength": 200000
      },
      "references": {
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "operationId": {
              "type": "string",
              "minLength": 1,
              "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
            },
            "reference": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "runId": {
                  "type": "string",
                  "minLength": 1
                },
                "taskId": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "runId",
                "taskId"
              ]
            }
          },
          "oneOf": [
            {
              "required": [
                "operationId"
              ],
              "not": {
                "required": [
                  "reference"
                ]
              }
            },
            {
              "required": [
                "reference"
              ],
              "not": {
                "required": [
                  "operationId"
                ]
              }
            }
          ]
        },
        "minItems": 1
      }
    },
    "required": [
      "markdown",
      "references"
    ]
  },
  "read_web": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "url"
    ],
    "properties": {
      "url": {
        "type": "string",
        "minLength": 1,
        "pattern": "^https?://",
        "maxLength": 2048
      },
      "find": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S",
        "maxLength": 200
      },
      "startLine": {
        "type": "integer",
        "minimum": 1,
        "maximum": 100000
      },
      "lineCount": {
        "type": "integer",
        "minimum": 1,
        "maximum": 200
      },
      "page": {
        "type": "integer",
        "minimum": 1,
        "maximum": 1000
      },
      "dateFrom": {
        "type": "string",
        "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
      },
      "dateTo": {
        "type": "string",
        "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
      }
    }
  },
  "show_chart": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "type": {
        "enum": [
          "bar",
          "line",
          "pie",
          "dumbbell",
          "heatmap",
          "scatter",
          "waterfall",
          "histogram"
        ]
      },
      "title": {
        "type": "string",
        "minLength": 1,
        "maxLength": 500,
        "pattern": "\\S"
      },
      "scope": {
        "type": "string",
        "minLength": 1,
        "maxLength": 500,
        "pattern": "\\S"
      },
      "unit": {
        "type": "string",
        "minLength": 1,
        "maxLength": 40,
        "pattern": "\\S"
      },
      "source": {
        "type": "string",
        "minLength": 1,
        "maxLength": 500,
        "pattern": "\\S"
      },
      "categories": {
        "type": "array",
        "minItems": 1,
        "maxItems": 200,
        "uniqueItems": true,
        "items": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120,
          "pattern": "\\S"
        }
      },
      "series": {
        "type": "array",
        "minItems": 1,
        "maxItems": 4,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 120,
              "pattern": "\\S"
            },
            "values": {
              "type": "array",
              "minItems": 1,
              "maxItems": 200,
              "items": {
                "type": [
                  "number",
                  "null"
                ],
                "minimum": -1000000000000000,
                "maximum": 1000000000000000
              }
            }
          },
          "required": [
            "name",
            "values"
          ]
        }
      },
      "references": {
        "type": "array",
        "minItems": 1,
        "maxItems": 60,
        "uniqueItems": true,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "runId": {
              "type": "string",
              "minLength": 1
            },
            "operationId": {
              "type": "string",
              "minLength": 1,
              "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
            },
            "reference": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "runId": {
                  "type": "string",
                  "minLength": 1
                },
                "inputId": {
                  "type": "string",
                  "minLength": 1
                },
                "taskId": {
                  "type": "string",
                  "minLength": 1
                },
                "messageIndex": {
                  "type": "integer",
                  "minimum": 0
                }
              },
              "required": [
                "runId"
              ],
              "oneOf": [
                {
                  "required": [
                    "inputId"
                  ],
                  "not": {
                    "required": [
                      "taskId"
                    ]
                  }
                },
                {
                  "required": [
                    "taskId"
                  ],
                  "not": {
                    "anyOf": [
                      {
                        "required": [
                          "inputId"
                        ]
                      },
                      {
                        "required": [
                          "messageIndex"
                        ]
                      }
                    ]
                  }
                }
              ]
            },
            "statistics": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "runId": {
                  "type": "string",
                  "minLength": 1
                },
                "comparisonTier": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                }
              },
              "required": [
                "runId",
                "comparisonTier"
              ],
              "description": "正式战绩汇总引用；使用 list_data 返回的运行和档位，一次核验并保存该档所有正式结果来源，不逐条复制 taskId。"
            }
          },
          "oneOf": [
            {
              "required": [
                "runId"
              ],
              "not": {
                "anyOf": [
                  {
                    "required": [
                      "operationId"
                    ]
                  },
                  {
                    "required": [
                      "reference"
                    ]
                  },
                  {
                    "required": [
                      "statistics"
                    ]
                  }
                ]
              }
            },
            {
              "required": [
                "operationId"
              ],
              "not": {
                "anyOf": [
                  {
                    "required": [
                      "runId"
                    ]
                  },
                  {
                    "required": [
                      "reference"
                    ]
                  },
                  {
                    "required": [
                      "statistics"
                    ]
                  }
                ]
              }
            },
            {
              "required": [
                "reference"
              ],
              "not": {
                "anyOf": [
                  {
                    "required": [
                      "runId"
                    ]
                  },
                  {
                    "required": [
                      "operationId"
                    ]
                  },
                  {
                    "required": [
                      "statistics"
                    ]
                  }
                ]
              }
            },
            {
              "required": [
                "statistics"
              ],
              "not": {
                "anyOf": [
                  {
                    "required": [
                      "runId"
                    ]
                  },
                  {
                    "required": [
                      "operationId"
                    ]
                  },
                  {
                    "required": [
                      "reference"
                    ]
                  }
                ]
              }
            }
          ]
        }
      },
      "xValues": {
        "type": "array",
        "minItems": 3,
        "maxItems": 200,
        "items": {
          "type": [
            "number",
            "null"
          ],
          "minimum": -1000000000000000,
          "maximum": 1000000000000000
        },
        "description": "散点图横轴值，与 categories 逐项对应；缺失为 null。"
      },
      "xLabel": {
        "type": "string",
        "minLength": 1,
        "maxLength": 80,
        "pattern": "\\S"
      },
      "xUnit": {
        "type": "string",
        "minLength": 1,
        "maxLength": 40,
        "pattern": "\\S"
      },
      "annotations": {
        "type": "array",
        "maxItems": 3,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "categoryIndex": {
              "type": "integer",
              "minimum": 0
            },
            "seriesIndex": {
              "type": "integer",
              "minimum": 0
            },
            "note": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100,
              "pattern": "\\S"
            }
          },
          "required": [
            "categoryIndex",
            "seriesIndex",
            "note"
          ]
        },
        "description": "最多3处有证据的重点标注；用真实数据位置指出异常、差距或拐点，不重复标题。"
      }
    },
    "required": [
      "type",
      "title",
      "scope",
      "unit",
      "source",
      "categories",
      "series",
      "references"
    ],
    "allOf": [
      {
        "if": {
          "properties": {
            "type": {
              "const": "pie"
            }
          }
        },
        "then": {
          "properties": {
            "categories": {
              "maxItems": 6
            },
            "series": {
              "maxItems": 1,
              "items": {
                "properties": {
                  "values": {
                    "items": {
                      "type": "number",
                      "minimum": 0
                    }
                  }
                }
              }
            }
          }
        }
      },
      {
        "if": {
          "properties": {
            "type": {
              "const": "line"
            }
          }
        },
        "then": {
          "properties": {
            "categories": {
              "minItems": 2
            }
          }
        }
      },
      {
        "if": {
          "properties": {
            "type": {
              "const": "scatter"
            }
          }
        },
        "then": {
          "required": [
            "xValues",
            "xLabel",
            "xUnit"
          ],
          "properties": {
            "categories": {
              "minItems": 3
            }
          }
        },
        "else": {
          "not": {
            "anyOf": [
              {
                "required": [
                  "xValues"
                ]
              },
              {
                "required": [
                  "xLabel"
                ]
              },
              {
                "required": [
                  "xUnit"
                ]
              }
            ]
          }
        }
      },
      {
        "if": {
          "properties": {
            "type": {
              "enum": [
                "scatter",
                "histogram"
              ]
            }
          }
        },
        "else": {
          "properties": {
            "categories": {
              "maxItems": 30
            }
          }
        }
      },
      {
        "if": {
          "properties": {
            "type": {
              "const": "dumbbell"
            }
          }
        },
        "then": {
          "properties": {
            "series": {
              "minItems": 2,
              "maxItems": 2
            },
            "categories": {
              "minItems": 2
            }
          }
        }
      },
      {
        "if": {
          "properties": {
            "type": {
              "enum": [
                "waterfall",
                "histogram"
              ]
            }
          }
        },
        "then": {
          "properties": {
            "series": {
              "maxItems": 1
            },
            "categories": {
              "minItems": 2
            }
          }
        }
      }
    ]
  }
}
