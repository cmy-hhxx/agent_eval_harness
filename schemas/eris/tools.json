{
  "list_data": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "runId": {
        "type": "string",
        "minLength": 1
      },
      "query": {
        "type": "string",
        "minLength": 1
      },
      "offset": {
        "type": "integer",
        "minimum": 0
      },
      "limit": {
        "type": "integer",
        "minimum": 1,
        "maximum": 100
      }
    },
    "required": []
  },
  "read_data": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "reference": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "runId": {
            "type": "string",
            "minLength": 1
          },
          "inputId": {
            "type": "string",
            "minLength": 1
          },
          "taskId": {
            "type": "string",
            "minLength": 1
          },
          "messageIndex": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [
          "runId"
        ],
        "oneOf": [
          {
            "required": [
              "inputId"
            ],
            "not": {
              "required": [
                "taskId"
              ]
            }
          },
          {
            "required": [
              "taskId"
            ],
            "not": {
              "anyOf": [
                {
                  "required": [
                    "inputId"
                  ]
                },
                {
                  "required": [
                    "messageIndex"
                  ]
                }
              ]
            }
          }
        ]
      },
      "offset": {
        "type": "integer",
        "minimum": 0
      },
      "limit": {
        "type": "integer",
        "minimum": 1,
        "maximum": 16000,
        "description": "消息目录按条，默认30、最多100；正文按 UTF-16 字符，默认8000、最多16000。"
      }
    },
    "required": [
      "reference"
    ],
    "allOf": [
      {
        "if": {
          "properties": {
            "reference": {
              "required": [
                "taskId"
              ]
            }
          }
        },
        "then": {
          "not": {
            "anyOf": [
              {
                "required": [
                  "offset"
                ]
              },
              {
                "required": [
                  "limit"
                ]
              }
            ]
          }
        }
      },
      {
        "if": {
          "properties": {
            "reference": {
              "required": [
                "messageIndex"
              ]
            }
          }
        },
        "else": {
          "properties": {
            "limit": {
              "maximum": 100
            }
          }
        }
      }
    ]
  },
  "search_data": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "reference": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "runId": {
            "type": "string",
            "minLength": 1
          },
          "inputId": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "runId",
          "inputId"
        ]
      },
      "query": {
        "type": "string",
        "minLength": 1
      },
      "offset": {
        "type": "integer",
        "minimum": 0
      },
      "limit": {
        "type": "integer",
        "minimum": 1,
        "maximum": 100
      }
    },
    "required": [
      "reference",
      "query"
    ]
  },
  "view_image": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "reference": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "runId": {
            "type": "string",
            "minLength": 1
          },
          "inputId": {
            "type": "string",
            "minLength": 1
          },
          "messageIndex": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [
          "runId",
          "inputId",
          "messageIndex"
        ]
      }
    },
    "required": [
      "reference"
    ]
  },
  "calculate": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "operation": {
        "enum": [
          "add",
          "subtract",
          "multiply",
          "divide"
        ]
      },
      "operands": {
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1
        },
        "minItems": 2,
        "maxItems": 20
      }
    },
    "required": [
      "operation",
      "operands"
    ]
  },
  "call_specialist": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "operationId": {
        "type": "string",
        "minLength": 1,
        "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
      },
      "kind": {
        "enum": [
          "attribution",
          "comparison"
        ]
      },
      "inputs": {
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "runId": {
              "type": "string",
              "minLength": 1
            },
            "inputId": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "runId",
            "inputId"
          ]
        },
        "minItems": 1,
        "maxItems": 3
      },
      "attributions": {
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "inputId": {
              "type": "string",
              "minLength": 1
            },
            "operationId": {
              "type": "string",
              "minLength": 1,
              "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
            },
            "runId": {
              "type": "string",
              "minLength": 1
            },
            "taskId": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "inputId"
          ],
          "oneOf": [
            {
              "required": [
                "operationId"
              ],
              "not": {
                "anyOf": [
                  {
                    "required": [
                      "runId"
                    ]
                  },
                  {
                    "required": [
                      "taskId"
                    ]
                  }
                ]
              }
            },
            {
              "required": [
                "runId",
                "taskId"
              ],
              "not": {
                "required": [
                  "operationId"
                ]
              }
            }
          ]
        },
        "maxItems": 3
      }
    },
    "required": [
      "operationId",
      "kind",
      "inputs"
    ],
    "allOf": [
      {
        "if": {
          "properties": {
            "kind": {
              "const": "attribution"
            }
          }
        },
        "then": {
          "properties": {
            "inputs": {
              "minItems": 1,
              "maxItems": 1
            }
          },
          "not": {
            "required": [
              "attributions"
            ]
          }
        },
        "else": {
          "properties": {
            "inputs": {
              "minItems": 2,
              "maxItems": 3
            }
          }
        }
      }
    ]
  },
  "read_specialist": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "operationId": {
        "type": "string",
        "minLength": 1,
        "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
      }
    },
    "required": [
      "operationId"
    ]
  },
  "save_summary": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "markdown": {
        "type": "string",
        "minLength": 1,
        "maxLength": 200000
      },
      "references": {
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "operationId": {
              "type": "string",
              "minLength": 1,
              "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
            },
            "reference": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "runId": {
                  "type": "string",
                  "minLength": 1
                },
                "taskId": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "runId",
                "taskId"
              ]
            }
          },
          "oneOf": [
            {
              "required": [
                "operationId"
              ],
              "not": {
                "required": [
                  "reference"
                ]
              }
            },
            {
              "required": [
                "reference"
              ],
              "not": {
                "required": [
                  "operationId"
                ]
              }
            }
          ]
        },
        "minItems": 1
      }
    },
    "required": [
      "markdown",
      "references"
    ]
  }
}
