{
  "list_data": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "runId": {
        "type": "string",
        "minLength": 1,
        "description": "省略时列出评测运行及 currentRun 的完整 summary，当前数量和进度直接使用它；提供时列出该运行的回答输入、任务引用及完整 summary。 必须是真实运行标识，不是路径；未知时先调用 list_data({})，不要填 .、.. 或占位符。",
        "pattern": "^[a-zA-Z0-9](?!.*\\.\\.)[a-zA-Z0-9_.-]{0,180}$"
      },
      "query": {
        "type": "string",
        "minLength": 1,
        "description": "可选的字面文本筛选词，用于匹配运行名或输入目录内容；不是数据类别。查看完整输入目录时省略，不传 inputs、tasks 或空字符串。空筛选结果不代表该运行没有数据。"
      },
      "offset": {
        "type": "integer",
        "minimum": 0
      },
      "limit": {
        "type": "integer",
        "minimum": 1,
        "maximum": 100
      }
    },
    "required": []
  },
  "read_data": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "reference": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "runId": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[a-zA-Z0-9](?!.*\\.\\.)[a-zA-Z0-9_.-]{0,180}$",
            "description": "原样使用目录返回的 runId。 必须是真实运行标识，不是路径；未知时先调用 list_data({})，不要填 .、.. 或占位符。"
          },
          "inputId": {
            "type": "string",
            "minLength": 1
          },
          "taskId": {
            "type": "string",
            "minLength": 1
          },
          "messageIndex": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [
          "runId"
        ],
        "oneOf": [
          {
            "required": [
              "inputId"
            ],
            "not": {
              "required": [
                "taskId"
              ]
            }
          },
          {
            "required": [
              "taskId"
            ],
            "not": {
              "anyOf": [
                {
                  "required": [
                    "inputId"
                  ]
                },
                {
                  "required": [
                    "messageIndex"
                  ]
                }
              ]
            }
          }
        ]
      },
      "offset": {
        "type": "integer",
        "minimum": 0,
        "description": "顶层字段，与 reference 同级；不要写进 reference。"
      },
      "limit": {
        "type": "integer",
        "minimum": 1,
        "maximum": 16000,
        "description": "顶层字段，与 reference 同级；消息目录按条，默认30、最多100；正文按 UTF-16 字符，默认8000、最多16000。"
      }
    },
    "required": [
      "reference"
    ],
    "allOf": [
      {
        "if": {
          "properties": {
            "reference": {
              "required": [
                "taskId"
              ]
            }
          }
        },
        "then": {
          "not": {
            "anyOf": [
              {
                "required": [
                  "offset"
                ]
              },
              {
                "required": [
                  "limit"
                ]
              }
            ]
          }
        }
      },
      {
        "if": {
          "properties": {
            "reference": {
              "required": [
                "messageIndex"
              ]
            }
          }
        },
        "else": {
          "properties": {
            "limit": {
              "maximum": 100
            }
          }
        }
      }
    ]
  },
  "search_data": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "reference": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "runId": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[a-zA-Z0-9](?!.*\\.\\.)[a-zA-Z0-9_.-]{0,180}$",
            "description": "原样使用目录返回的 runId。 必须是真实运行标识，不是路径；未知时先调用 list_data({})，不要填 .、.. 或占位符。"
          },
          "inputId": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "runId",
          "inputId"
        ]
      },
      "query": {
        "type": "string",
        "minLength": 1
      },
      "offset": {
        "type": "integer",
        "minimum": 0,
        "description": "顶层字段，与 reference 同级。"
      },
      "limit": {
        "type": "integer",
        "minimum": 1,
        "maximum": 100,
        "description": "顶层字段，与 reference 同级。"
      }
    },
    "required": [
      "reference",
      "query"
    ]
  },
  "search_web": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "queries"
    ],
    "properties": {
      "queries": {
        "type": "array",
        "description": "1–4条明确查询计划；单一事实默认只发1条精准查询，多个独立缺口才合并互补查询。",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "query"
          ],
          "properties": {
            "query": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S",
              "maxLength": 500,
              "description": "必填；写明机构或公司 + 期间 + 指标口径。"
            },
            "domains": {
              "type": "array",
              "description": "可选；最多5个完整主机名，不带协议、端口或路径，不确定就省略。",
              "items": {
                "type": "string",
                "maxLength": 253,
                "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9-]{0,61}[A-Za-z0-9])?(?:\\.[A-Za-z0-9](?:[A-Za-z0-9-]{0,61}[A-Za-z0-9])?)+$"
              },
              "uniqueItems": true,
              "minItems": 1,
              "maxItems": 5
            },
            "country": {
              "type": "string",
              "pattern": "^[a-z]{2}$",
              "description": "可选；两位小写国家代码，默认 cn。"
            },
            "language": {
              "type": "string",
              "pattern": "^[a-z]{2}(-[a-z]{2})?$",
              "description": "可选；语言代码，例如 zh-cn 或 en，默认 zh-cn。"
            },
            "page": {
              "type": "integer",
              "minimum": 1,
              "maximum": 3,
              "description": "可选；1–3，默认1；只在必要的查询上翻页。"
            }
          }
        },
        "minItems": 1,
        "maxItems": 4,
        "uniqueItems": true
      },
      "category": {
        "type": "string",
        "enum": [
          "web",
          "news"
        ],
        "description": "只有 web（默认）和 news 两个合法值，没有 finance 等类别；提交其他值会被校验拒绝。"
      },
      "timeRange": {
        "type": "string",
        "enum": [
          "day",
          "week",
          "month",
          "year"
        ],
        "description": "可选；相对检索时点的 day/week/month/year，与 dateFrom / dateTo 互斥。"
      },
      "dateFrom": {
        "type": "string",
        "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
        "description": "可选；包含端点的 YYYY-MM-DD。"
      },
      "dateTo": {
        "type": "string",
        "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
        "description": "可选；包含端点的 YYYY-MM-DD；历史审查设为问题截至日期。"
      },
      "limit": {
        "type": "integer",
        "minimum": 1,
        "maximum": 20,
        "description": "可选；合并输出条数，默认10、最多20。"
      }
    },
    "allOf": [
      {
        "not": {
          "required": [
            "timeRange",
            "dateFrom"
          ]
        }
      },
      {
        "not": {
          "required": [
            "timeRange",
            "dateTo"
          ]
        }
      }
    ]
  },
  "view_image": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
