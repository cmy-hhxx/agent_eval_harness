    ]
  },
  "call_specialist": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "operationId": {
        "type": "string",
        "minLength": 1,
        "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
      },
      "kind": {
        "enum": [
          "attribution",
          "comparison"
        ]
      },
      "inputs": {
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "runId": {
              "type": "string",
              "minLength": 1,
              "pattern": "^[a-zA-Z0-9](?!.*\\.\\.)[a-zA-Z0-9_.-]{0,180}$",
              "description": "原样使用目录返回的 runId。 必须是真实运行标识，不是路径；未知时先调用 list_data({})，不要填 .、.. 或占位符。"
            },
            "inputId": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "runId",
            "inputId"
          ]
        },
        "minItems": 1,
        "maxItems": 3
      },
      "attributions": {
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "inputId": {
              "type": "string",
              "minLength": 1
            },
            "operationId": {
              "type": "string",
              "minLength": 1,
              "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
            },
            "runId": {
              "type": "string",
              "minLength": 1,
              "pattern": "^[a-zA-Z0-9](?!.*\\.\\.)[a-zA-Z0-9_.-]{0,180}$",
              "description": "原样使用目录返回的 runId。 必须是真实运行标识，不是路径；未知时先调用 list_data({})，不要填 .、.. 或占位符。"
            },
            "taskId": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "inputId"
          ],
          "oneOf": [
            {
              "required": [
                "operationId"
              ],
              "not": {
                "anyOf": [
                  {
                    "required": [
                      "runId"
                    ]
                  },
                  {
                    "required": [
                      "taskId"
                    ]
                  }
                ]
              }
            },
            {
              "required": [
                "runId",
                "taskId"
              ],
              "not": {
                "required": [
                  "operationId"
                ]
              }
            }
          ]
        },
        "maxItems": 3
      }
    },
    "required": [
      "operationId",
      "kind",
      "inputs"
    ],
    "allOf": [
      {
        "if": {
          "properties": {
            "kind": {
              "const": "attribution"
            }
          }
        },
        "then": {
          "properties": {
            "inputs": {
              "minItems": 1,
              "maxItems": 1
            }
          },
          "not": {
            "required": [
              "attributions"
            ]
          }
        },
        "else": {
          "properties": {
            "inputs": {
              "minItems": 2,
              "maxItems": 3
            }
          }
        }
      }
    ]
  },
  "read_specialist": {
    "type": "object",
