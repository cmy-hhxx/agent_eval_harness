  "calculate": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "operation": {
        "enum": [
          "add",
          "subtract",
          "multiply",
          "divide"
        ]
      },
      "operands": {
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1
        },
        "minItems": 2,
        "maxItems": 20
      }
    },
    "required": [
