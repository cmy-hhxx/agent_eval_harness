{
  "type": "object",
  "additionalProperties": false,
  "required": ["decisions"],
  "properties": {
    "decisions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["index", "eligible", "reason"],
        "properties": {
          "index": { "type": "integer", "minimum": 0, "maximum": 19 },
          "eligible": { "type": "boolean" },
          "reason": { "type": "string", "minLength": 1, "maxLength": 200, "pattern": "\\S" }
        }
      }
    }
  }
}
