{
  "type": "object",
  "additionalProperties": false,
  "required": ["issues"],
  "properties": {
    "issues": {
      "type": "array",
      "maxItems": 12,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "reason"],
        "properties": {
          "path": {"type": "string", "minLength": 1, "maxLength": 200, "pattern": "^/"},
          "reason": {"type": "string", "minLength": 1, "maxLength": 600}
        }
      }
    }
  }
}
