{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "facts": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "affected_item_ids": {
                "type": "array",
                "items": {
                  "type": "string",
                  "enum": [
                    "T1",
                    "T2",
                    "E1",
                    "E2",
                    "L1",
                    "L2",
                    "A1",
                    "A2",
                    "U1",
                    "U2",
                    "D1",
                    "D2"
                  ]
                },
                "minItems": 0,
                "uniqueItems": true
              },
              "evidence_ids": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "minItems": 1,
                "uniqueItems": true
              }
            },
            "required": [
              "affected_item_ids",
              "evidence_ids"
            ],
            "additionalProperties": false
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "unresolved": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "claim": {
                "type": "string",
                "minLength": 1
              },
              "affected_item_ids": {
                "type": "array",
                "items": {
                  "type": "string",
                  "enum": [
                    "T1",
                    "T2",
                    "E1",
                    "E2",
                    "L1",
                    "L2",
                    "A1",
                    "A2",
                    "U1",
                    "U2",
                    "D1",
                    "D2"
                  ]
                },
                "minItems": 1,
                "uniqueItems": true
              }
            },
            "required": [
              "claim",
              "affected_item_ids"
            ],
            "additionalProperties": false
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "full_rescore_reason": {
          "type": "string",
          "minLength": 1
        },
        "changed_item_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "T1",
              "T2",
              "E1",
              "E2",
              "L1",
              "L2",
              "A1",
              "A2",
              "U1",
              "U2",
              "D1",
              "D2"
            ]
          },
          "minItems": 0,
          "uniqueItems": true
        }
      },
      "required": [
        "facts",
        "unresolved",
        "changed_item_ids"
      ],
      "additionalProperties": false
    },
    {
      "$ref": "#/$defs/exception"
    }
  ],
  "$defs": {
    "exception": {
      "type": "object",
      "properties": {
        "case_id": {
          "type": "string",
          "minLength": 1
        },
        "assessment_status": {
          "enum": [
            "needs_material",
            "blocked_by_rule_conflict",
            "host_empty_response"
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "missing_material": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0
        },
        "affected_units": {
          "type": "array",
          "items": {
            "enum": [
              "T1",
              "T2",
              "E1",
              "E2",
              "L1",
              "L2",
              "A1",
              "A2",
              "U1",
              "U2",
              "D1",
              "D2"
            ]
          },
          "uniqueItems": true
        }
      },
      "required": [
        "case_id",
        "assessment_status",
        "reason",
        "missing_material",
        "affected_units"
      ],
      "additionalProperties": false
    }
  }
}
