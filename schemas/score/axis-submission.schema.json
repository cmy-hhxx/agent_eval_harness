{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "evaluations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/evaluation"
      },
      "minItems": 2,
      "maxItems": 2
    },
    "diagnostics": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/diagnostic"
      },
      "minItems": 4,
      "maxItems": 4
    },
    "findings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/finding"
      },
      "minItems": 0
    },
    "verification_requests": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "claim": {
            "type": "string",
            "minLength": 1
          },
          "affected_item_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "enum": [
                "T1",
                "T2",
                "E1",
                "E2",
                "L1",
                "L2",
                "A1",
                "A2",
                "U1",
                "U2",
                "D1",
                "D2"
              ]
            },
            "minItems": 1,
            "uniqueItems": true
          }
        },
        "required": [
          "claim",
          "affected_item_ids"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    }
  },
  "required": [
    "evaluations",
    "diagnostics",
    "findings",
    "verification_requests"
  ],
  "additionalProperties": false,
  "$defs": {
    "evaluation": {
      "type": "object",
      "properties": {
        "item_id": {
          "enum": [
            "T1",
            "T2",
            "E1",
            "E2",
            "L1",
            "L2",
            "A1",
            "A2",
            "U1",
            "U2",
            "D1",
            "D2"
          ]
        },
        "applicability": {
          "enum": [
            "both",
            "not_triggered",
            "observed_behavior",
            "task_requirement",
            "undetermined"
          ]
        },
        "status": {
          "enum": [
            "met",
            "not_applicable",
            "unverified",
            "violated"
          ]
        },
        "score": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 4
        },
        "score_range": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "array",
              "items": {
                "type": "integer",
                "minimum": 0,
                "maximum": 4
              },
              "minItems": 2,
              "maxItems": 2
            }
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "evidence_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "host_basis": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/host_basis"
          },
          "minItems": 1
        }
      },
      "required": [
        "item_id",
        "applicability",
        "status",
        "score",
        "score_range",
        "reason",
        "evidence_ids"
      ],
      "additionalProperties": false
    },
    "diagnostic": {
      "type": "object",
      "properties": {
        "diagnostic_id": {
          "enum": [
            "T01",
            "T02",
            "T03",
            "T04",
            "E01",
            "E02",
            "E03",
            "E04",
            "L01",
            "L02",
            "L03",
            "L04",
            "A01",
            "A02",
            "A03",
            "A04",
            "U01",
            "U02",
            "U03",
            "U04",
            "D01",
            "D02",
            "D03",
            "D04"
          ]
        },
        "applicability": {
          "enum": [
            "both",
            "not_triggered",
            "observed_behavior",
            "task_requirement",
            "undetermined"
          ]
        },
        "status": {
          "enum": [
            "met",
            "not_applicable",
            "unverified",
            "violated"
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "evidence_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "host_basis": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/host_basis"
          },
          "minItems": 1
        }
      },
      "required": [
        "diagnostic_id",
        "applicability",
        "status",
        "reason",
        "evidence_ids"
      ],
      "additionalProperties": false
    },
    "finding": {
      "type": "object",
      "properties": {
        "finding_id": {
          "type": "string",
          "minLength": 1
        },
        "affected_item_ids": {
          "type": "array",
          "items": {
            "enum": [
              "T1",
              "T2",
              "E1",
              "E2",
              "L1",
              "L2",
              "A1",
              "A2",
              "U1",
              "U2",
              "D1",
              "D2"
            ]
          },
          "uniqueItems": true
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "component": {
          "enum": [
            "candidate_output",
            "tool_call",
            "tool_service",
            "capture",
            "public_rule",
            "unknown"
          ]
        },
        "attribution": {
          "enum": [
            "established",
            "hypothesis",
            "unknown"
          ]
        },
        "primary_diagnostic_id": {
          "enum": [
            "T01",
            "T02",
            "T03",
            "T04",
            "E01",
            "E02",
            "E03",
            "E04",
            "L01",
            "L02",
            "L03",
            "L04",
            "A01",
            "A02",
            "A03",
            "A04",
            "U01",
            "U02",
            "U03",
            "U04",
            "D01",
            "D02",
            "D03",
            "D04",
            "unmapped"
          ]
        },
        "diagnostic_ids": {
          "type": "array",
          "items": {
            "enum": [
              "T01",
              "T02",
              "T03",
              "T04",
              "E01",
              "E02",
              "E03",
              "E04",
              "L01",
              "L02",
              "L03",
              "L04",
              "A01",
              "A02",
              "A03",
              "A04",
              "U01",
              "U02",
              "U03",
              "U04",
              "D01",
              "D02",
              "D03",
              "D04"
            ]
          },
          "uniqueItems": true
        },
        "evidence_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true,
          "minItems": 1
        },
        "unmapped_reason": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        }
      },
      "required": [
        "finding_id",
        "affected_item_ids",
        "description",
        "component",
        "attribution",
        "primary_diagnostic_id",
        "diagnostic_ids",
        "evidence_ids"
      ],
      "additionalProperties": false
    },
    "host_basis": {
      "type": "object",
      "properties": {
        "pointer": {
          "type": "string",
          "minLength": 1
        },
        "value": {},
        "rule_id": {
          "enum": [
            "no_public_or_observed_trigger",
            "unknown_trigger",
            "missing_observation"
          ]
        }
      },
      "required": [
        "pointer",
        "value",
        "rule_id"
      ],
      "additionalProperties": false
    }
  }
}
