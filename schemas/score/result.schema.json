{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Single-question answer evaluation",
  "description": "Structure only; grading, truth, semantic completeness and training fitness are not certified.",
  "oneOf": [
    {
      "$ref": "#/$defs/normal"
    },
    {
      "$ref": "#/$defs/exception"
    }
  ],
  "$defs": {
    "normal": {
      "type": "object",
      "properties": {
        "case_id": {
          "type": "string",
          "minLength": 1
        },
        "final_answer_score": {
          "$ref": "#/$defs/final_score"
        },
        "evaluations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evaluation"
          },
          "minItems": 12,
          "maxItems": 12
        },
        "findings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/finding"
          },
          "minItems": 0
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/shared_evidence"
          },
          "minItems": 0
        },
        "explicit_probability": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "probability_evidence_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "diagnostics": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/diagnostic"
          },
          "minItems": 24,
          "maxItems": 24
        }
      },
      "required": [
        "case_id",
        "final_answer_score",
        "evaluations",
        "findings",
        "evidence",
        "explicit_probability",
        "probability_evidence_ids",
        "diagnostics"
      ],
      "additionalProperties": false
    },
    "exception": {
      "type": "object",
      "properties": {
        "case_id": {
          "type": "string",
          "minLength": 1
        },
        "assessment_status": {
          "enum": [
            "needs_material",
            "blocked_by_rule_conflict",
            "host_empty_response"
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "missing_material": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0
        },
        "affected_units": {
          "type": "array",
          "items": {
            "enum": [
              "T1",
              "T2",
              "E1",
              "E2",
              "L1",
              "L2",
              "A1",
              "A2",
              "U1",
              "U2",
              "D1",
              "D2"
            ]
          },
          "uniqueItems": true
        }
      },
      "required": [
        "case_id",
        "assessment_status",
        "reason",
        "missing_material",
        "affected_units"
      ],
      "additionalProperties": false
    },
    "evaluation": {
      "type": "object",
      "properties": {
        "item_id": {
          "enum": [
            "T1",
            "T2",
            "E1",
            "E2",
            "L1",
            "L2",
            "A1",
            "A2",
            "U1",
            "U2",
            "D1",
            "D2"
          ]
        },
        "item_name": {
          "type": "string",
          "minLength": 1
        },
        "applicability": {
          "enum": [
            "both",
            "not_triggered",
            "observed_behavior",
            "task_requirement",
            "undetermined"
          ]
        },
        "status": {
          "enum": [
            "met",
            "not_applicable",
            "unverified",
            "violated"
          ]
        },
        "grade": {
          "enum": [
            "全部必要要求满足",
            "核心成立且有非关键局部缺陷",
            "部分重要子交付独立可用",
            "仅有实质支持材料或步骤",
            "无实质有效完成",
            "无实质有效交付",
            "只有有效片段或步骤",
            "部分重要结果有效",
            "非关键局部缺陷",
            "全部满足",
            "待核",
            "不适用"
          ]
        },
        "score": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 10
        },
        "score_range": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "array",
              "items": {
                "type": "integer",
                "minimum": 0,
                "maximum": 10
              },
              "minItems": 2,
              "maxItems": 2
            }
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "evidence_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "host_basis": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/host_basis"
          },
          "minItems": 1
        }
      },
      "required": [
        "item_id",
        "item_name",
        "applicability",
        "status",
        "grade",
        "score",
        "score_range",
        "reason",
        "evidence_ids"
      ],
      "additionalProperties": false
    },
    "diagnostic": {
      "type": "object",
      "properties": {
        "diagnostic_id": {
          "enum": [
            "T01",
            "T02",
            "T03",
            "T04",
            "E01",
            "E02",
            "E03",
            "E04",
            "L01",
            "L02",
            "L03",
            "L04",
            "A01",
            "A02",
            "A03",
            "A04",
            "U01",
            "U02",
            "U03",
            "U04",
            "D01",
            "D02",
            "D03",
            "D04"
          ]
        },
        "diagnostic_name": {
          "type": "string",
          "minLength": 1
        },
        "applicability": {
          "enum": [
            "both",
            "not_triggered",
            "observed_behavior",
            "task_requirement",
            "undetermined"
          ]
        },
        "status": {
          "enum": [
            "met",
            "not_applicable",
            "unverified",
            "violated"
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "evidence_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "host_basis": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/host_basis"
          },
          "minItems": 1
        }
      },
      "required": [
        "diagnostic_id",
        "diagnostic_name",
        "applicability",
        "status",
        "reason",
        "evidence_ids"
      ],
      "additionalProperties": false
    },
    "final_score": {
      "type": "object",
      "properties": {
        "status": {
          "enum": [
            "met",
            "not_applicable",
            "unverified",
            "violated"
          ]
        },
        "grade": {
          "enum": [
            "全部必要要求满足",
            "核心成立且有非关键局部缺陷",
            "部分重要子交付独立可用",
            "仅有实质支持材料或步骤",
            "无实质有效完成",
            "无实质有效交付",
            "只有有效片段或步骤",
            "部分重要结果有效",
            "非关键局部缺陷",
            "全部满足",
            "待核",
            "不适用"
          ]
        },
        "score": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 10
        },
        "score_range": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "array",
              "items": {
                "type": "integer",
                "minimum": 0,
                "maximum": 10
              },
              "minItems": 2,
              "maxItems": 2
            }
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "evidence_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "finding_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "host_basis": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/host_basis"
          },
          "minItems": 1
        }
      },
      "required": [
        "status",
        "grade",
        "score",
        "score_range",
        "reason",
        "evidence_ids",
        "finding_ids"
      ],
      "additionalProperties": false
    },
    "finding": {
      "type": "object",
      "properties": {
        "finding_id": {
          "type": "string",
          "minLength": 1
        },
        "affected_item_ids": {
          "type": "array",
          "items": {
            "enum": [
              "T1",
              "T2",
              "E1",
              "E2",
              "L1",
              "L2",
              "A1",
              "A2",
              "U1",
              "U2",
              "D1",
              "D2"
            ]
          },
          "uniqueItems": true
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "component": {
          "enum": [
            "candidate_output",
            "tool_call",
            "tool_service",
            "capture",
            "public_rule",
            "unknown"
          ]
        },
        "attribution": {
          "enum": [
            "established",
            "hypothesis",
            "unknown"
          ]
        },
        "primary_diagnostic_id": {
          "enum": [
            "T01",
            "T02",
            "T03",
            "T04",
            "E01",
            "E02",
            "E03",
            "E04",
            "L01",
            "L02",
            "L03",
            "L04",
            "A01",
            "A02",
            "A03",
            "A04",
            "U01",
            "U02",
            "U03",
            "U04",
            "D01",
            "D02",
            "D03",
            "D04",
            "unmapped"
          ]
        },
        "diagnostic_ids": {
          "type": "array",
          "items": {
            "enum": [
              "T01",
              "T02",
              "T03",
              "T04",
              "E01",
              "E02",
              "E03",
              "E04",
              "L01",
              "L02",
              "L03",
              "L04",
              "A01",
              "A02",
              "A03",
              "A04",
              "U01",
              "U02",
              "U03",
              "U04",
              "D01",
              "D02",
              "D03",
              "D04"
            ]
          },
          "uniqueItems": true
        },
        "evidence_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true,
          "minItems": 1
        },
        "unmapped_reason": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        }
      },
      "required": [
        "finding_id",
        "affected_item_ids",
        "description",
        "component",
        "attribution",
        "primary_diagnostic_id",
        "diagnostic_ids",
        "evidence_ids"
      ],
      "additionalProperties": false
    },
    "shared_evidence": {
      "type": "object",
      "properties": {
        "evidence_id": {
          "type": "string",
          "minLength": 1
        },
        "source_id": {
          "type": "string",
          "minLength": 1
        },
        "start": {
          "type": "integer",
          "minimum": 0
        },
        "end": {
          "type": "integer",
          "minimum": 1
        },
        "quote": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "evidence_id",
        "source_id",
        "start",
        "end",
        "quote"
      ],
      "additionalProperties": false
    },
    "host_basis": {
      "type": "object",
      "properties": {
        "pointer": {
          "type": "string",
          "minLength": 1
        },
        "value": {},
        "rule_id": {
          "enum": [
            "no_public_or_observed_trigger",
            "unknown_trigger",
            "missing_observation"
          ]
        }
      },
      "required": [
        "pointer",
        "value",
        "rule_id"
      ],
      "additionalProperties": false
    }
  }
}
