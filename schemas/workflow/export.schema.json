{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "request_time",
    "has_standard_answer",
    "evaluator_version",
    "evaluation_type",
    "comparison_id",
    "case",
    "ground_truth",
    "models",
    "ranking",
    "assessments",
    "evaluations",
    "verdicts",
    "task_analysis",
    "decision_basis",
    "status",
    "criteria_task_id",
    "attribution_task_ids"
  ],
  "properties": {
    "request_time": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "has_standard_answer": {
      "type": "boolean"
    },
    "evaluator_version": {
      "type": "string",
      "minLength": 1
    },
    "evaluation_type": {
      "const": "group_model_comparison"
    },
    "evaluation_purpose": { "const": "prediction" },
    "prediction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_evaluation_task_id", "source_run_id", "source_comparison_id", "question_id", "question_time", "targets"],
      "properties": {
        "source_evaluation_task_id": { "type": "string", "minLength": 1 },
        "source_run_id": { "type": "string", "minLength": 1 },
        "source_comparison_id": { "type": "string", "minLength": 1 },
        "question_id": { "type": "string", "minLength": 1 },
        "question_time": { "type": "string", "minLength": 1 },
        "targets": {
          "type": "array", "minItems": 1,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["target_id", "start_date", "end_date"],
            "properties": {
              "target_id": { "type": "string", "minLength": 1 },
              "start_date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
              "end_date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" }
            }
          }
        }
      }
    },
    "comparison_id": {
      "type": "string",
      "minLength": 1
    },
    "case": {
      "$ref": "#/$defs/case"
    },
    "ground_truth": {
      "$ref": "#/$defs/ground_truth"
    },
    "models": {
      "type": "object",
      "minProperties": 2,
      "additionalProperties": {
        "$ref": "#/$defs/model"
      },
      "maxProperties": 2
    },
    "ranking": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "assessments": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/assessment"
      }
    },
    "evaluations": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/evaluation"
      }
    },
    "verdicts": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/verdict"
      }
    },
    "task_analysis": {
      "$ref": "#/$defs/task_analysis"
    },
    "decision_basis": {
      "$ref": "#/$defs/decision_basis"
    },
    "status": {
      "const": "decided"
    },
    "criteria_task_id": {
      "type": "string",
      "minLength": 1
    },
    "attribution_task_ids": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "dependentRequired": { "evaluation_purpose": ["prediction"], "prediction": ["evaluation_purpose"] },
  "$defs": {
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "batch_id",
        "case_id"
      ],
      "properties": {
        "batch_id": {
          "type": "string",
          "minLength": 1
        },
        "case_id": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "ground_truth": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "available",
        "value"
      ],
      "properties": {
        "available": {
          "type": "boolean"
        },
        "value": {}
      }
    },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "llm",
        "trace_id"
      ],
      "properties": {
        "version": {
          "type": "string",
          "minLength": 1
        },
        "llm": {
          "type": [
            "string",
            "null"
          ]
        },
        "trace_id": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "assessment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "meets_core",
        "summary",
        "core_failure_refs"
      ],
      "properties": {
        "meets_core": {
          "type": "boolean"
        },
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "core_failure_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "evaluation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "is_correct",
        "correctness_reason",
        "correctness_evidence",
        "numeric_checks",
        "summary",
        "findings",
        "criterion_assessments",
        "core_assessment"
      ],
      "properties": {
        "is_correct": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "correctness_reason": {
          "type": "string"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "is_correct": {
                "type": "boolean"
              }
            }
          },
          "then": {
            "properties": {
              "correctness_reason": {
                "minLength": 1
              }
            }
          }
        }
      ]
    },
    "verdict": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "result",
        "winner_version",
        "winner_name",
        "reason"
      ],
      "properties": {
        "result": {
          "enum": [
            "win",
            "both_good",
            "both_bad"
          ]
        },
        "winner_version": {
          "type": [
            "string",
            "null"
          ]
        },
        "winner_name": {
          "type": [
            "string",
            "null"
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "result": {
                "const": "win"
              }
            }
          },
          "then": {
            "properties": {
              "winner_version": {
                "type": "string",
                "minLength": 1
              },
              "winner_name": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "else": {
            "properties": {
              "winner_version": {
                "type": "null"
              },
              "winner_name": {
                "type": "null"
              }
            }
          }
        }
      ]
    }
  }
}
