{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "request_time",
    "has_standard_answer",
    "evaluator_version",
    "evaluation_type",
    "comparison_id",
    "case",
    "ground_truth",
    "models",
    "ranking",
    "assessments",
    "evaluations",
    "verdicts",
    "task_analysis",
    "decision_basis",
    "status",
    "criteria_task_id",
    "attribution_task_ids"
  ],
  "properties": {
    "request_time": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "has_standard_answer": {
      "type": "boolean"
    },
    "evaluator_version": {
      "type": "string",
      "minLength": 1
    },
    "evaluation_type": {
      "const": "group_model_comparison"
    },
    "evaluation_purpose": {
      "const": "prediction"
    },
    "prediction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_evaluation_task_id",
        "source_run_id",
        "source_comparison_id",
        "question_id",
        "question_time",
        "targets"
      ],
      "properties": {
        "source_evaluation_task_id": {
          "type": "string",
          "minLength": 1
        },
        "source_run_id": {
          "type": "string",
          "minLength": 1
        },
        "source_comparison_id": {
          "type": "string",
          "minLength": 1
        },
        "question_id": {
          "type": "string",
          "minLength": 1
        },
        "question_time": {
          "type": "string",
          "minLength": 1
        },
        "targets": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "target_id",
              "start_date",
              "end_date"
            ],
            "properties": {
              "target_id": {
                "type": "string",
                "minLength": 1
              },
              "start_date": {
                "type": "string",
                "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
              },
              "end_date": {
                "type": "string",
                "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
              }
            }
          }
        }
      }
    },
    "comparison_id": {
      "type": "string",
      "minLength": 1
    },
    "case": {
      "$ref": "#/$defs/case"
    },
    "ground_truth": {
      "$ref": "#/$defs/ground_truth"
    },
    "models": {
      "type": "object",
      "minProperties": 2,
      "additionalProperties": {
        "$ref": "#/$defs/model"
      },
      "maxProperties": 2
    },
    "ranking": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "assessments": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/assessment"
      }
    },
    "evaluations": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/evaluation"
      }
    },
    "verdicts": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/verdict"
      }
    },
    "task_analysis": {
      "$ref": "#/$defs/task_analysis"
    },
    "decision_basis": {
      "$ref": "#/$defs/decision_basis"
    },
    "status": {
      "const": "decided"
    },
    "criteria_task_id": {
      "type": "string",
      "minLength": 1
    },
    "attribution_task_ids": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "dependentRequired": {
    "evaluation_purpose": [
      "prediction"
    ],
    "prediction": [
      "evaluation_purpose"
    ]
  },
  "$defs": {
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "batch_id",
        "case_id"
      ],
      "properties": {
        "batch_id": {
          "type": "string",
          "minLength": 1
        },
        "case_id": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "ground_truth": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "available",
        "value"
      ],
      "properties": {
        "available": {
          "type": "boolean"
        },
        "value": {}
      }
    },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "llm",
        "trace_id"
      ],
      "properties": {
        "version": {
          "type": "string",
          "minLength": 1
        },
        "llm": {
          "type": [
            "string",
            "null"
          ]
        },
        "trace_id": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "assessment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "meets_core",
        "summary",
        "core_failure_refs"
      ],
      "properties": {
        "meets_core": {
          "type": "boolean"
        },
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "core_failure_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "evaluation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "meta",
        "summary",
        "Problem",
        "has_standard_answer",
        "is_correct",
        "correct_reason"
      ],
      "properties": {
        "meta": {
          "type": "object"
        },
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "Problem": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "text",
              "reason",
              "evidence_status",
              "evidence",
              "attribution_reason",
              "problem_id",
              "component"
            ],
            "properties": {
              "problem_id": {
                "type": "string",
                "minLength": 1
              },
              "text": {
                "type": "string",
                "minLength": 1
              },
              "reason": {
                "type": "string",
                "minLength": 1
              },
              "evidence_status": {
                "enum": [
                  "已确认",
                  "待核实"
                ]
              },
              "evidence": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "evidence_id",
                    "message_index",
                    "quote",
                    "purposes"
                  ],
                  "properties": {
                    "message_index": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "quote": {
                      "type": "string",
                      "minLength": 1
                    },
                    "source": {
                      "type": "string",
                      "minLength": 1
                    },
                    "source_input_id": {
                      "type": "string",
                      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"
                    },
                    "evidence_id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "purposes": {
                      "type": "array",
                      "items": {
                        "enum": [
                          "问题",
                          "归因"
                        ]
                      },
                      "minItems": 1,
                      "uniqueItems": true
                    }
                  },
                  "dependentRequired": {
                    "source": [
                      "source_input_id"
                    ],
                    "source_input_id": [
                      "source"
                    ]
                  }
                }
              },
              "attribution_reason": {
                "type": "string",
                "minLength": 1
              },
              "uncertainties": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "uniqueItems": true
              },
              "component": {
                "type": [
                  "string",
                  "null"
                ],
                "minLength": 1,
                "description": "程序按真实调用职责生成的中文名称，如终稿生成轮、Expert 推理轮、finquery 取数服务；确实无法定位才填责任主体未确定。"
              },
              "related_responsibilities": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "attribution_reason",
                    "evidence_ids",
                    "component"
                  ],
                  "properties": {
                    "attribution_reason": {
                      "type": "string",
                      "minLength": 1
                    },
                    "uncertainties": {
                      "type": "array",
                      "minItems": 1,
                      "items": {
                        "type": "string",
                        "minLength": 1
                      },
                      "uniqueItems": true
                    },
                    "evidence_ids": {
                      "type": "array",
                      "minItems": 1,
                      "uniqueItems": true,
                      "items": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "component": {
                      "type": [
                        "string",
                        "null"
                      ],
                      "minLength": 1,
                      "description": "程序按真实调用职责生成的中文名称，如终稿生成轮、Expert 推理轮、finquery 取数服务；确实无法定位才填责任主体未确定。"
                    }
                  }
                }
              },
              "calculations": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "label",
                    "operation",
                    "operands",
                    "result",
                    "scale",
                    "decimal_places",
                    "result_unit",
                    "result_period",
                    "assumptions"
                  ],
                  "properties": {
                    "label": {
                      "type": "string",
                      "minLength": 1
                    },
                    "operation": {
                      "enum": [
                        "比值",
                        "相对变化",
                        "复利增长",
                        "年化",
                        "四则运算"
                      ]
                    },
                    "operands": {
                      "type": "object",
                      "minProperties": 1,
                      "additionalProperties": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                          "value",
                          "evidence_id",
                          "unit",
                          "period",
                          "role"
                        ],
                        "properties": {
                          "value": {
                            "type": "string",
                            "minLength": 1
                          },
                          "evidence_id": {
                            "type": "string",
                            "minLength": 1
                          },
                          "unit": {
                            "type": "string",
                            "minLength": 1
                          },
                          "period": {
                            "type": "string",
                            "minLength": 1
                          },
                          "role": {
                            "type": "string",
                            "minLength": 1
                          }
                        }
                      },
                      "description": "每项value为对应evidence中的完整原数token（可含千分位），unit/period/role明确原始单位、期间及业务角色。比值仅numerator+denominator，区间比值仅numerator+denominator_lower+denominator_upper（分子非负、分母为有序正数、两端同单位同期间），denominator_role精确等于分母role；相对变化仅base+observed（同单位，期间可不同），公式(observed-base)/base，denominator_role=base.role；复利增长必需rate+periods，可选base；rate.unit为比值或%（%自动精确除100），periods.unit=期且1—20整数（有界资源限制）；有base时结果=base*(1+每期增长率)^periods且与base同单位，无base计算增长倍数且result_unit=比值，不需编造值为1的来源；非CAGR；年化仅value，须有正factor、observation_period=value.period、target_period=result_period、result_basis=按当前速度年化及非空assumptions，结果单位与value一致；四则运算用自选合法变量名且每项均参与formula，display_scale为保留名。"
                    },
                    "result": {
                      "type": [
                        "string",
                        "object"
                      ],
                      "minLength": 1,
                      "additionalProperties": false,
                      "required": [
                        "lower",
                        "upper",
                        "include_lower",
                        "include_upper"
                      ],
                      "properties": {
                        "lower": {
                          "type": "string",
                          "minLength": 1
                        },
                        "upper": {
                          "type": "string",
                          "minLength": 1
                        },
                        "include_lower": {
                          "type": "boolean"
                        },
                        "include_upper": {
                          "type": "boolean"
                        }
                      }
                    },
                    "scale": {
                      "enum": [
                        "1",
                        "100"
                      ],
                      "description": "结果显示倍率，仅1或100，不是容差。比值/相对变化的scale=100当且仅当result_unit=%；其他运算也按此倍率乘在公式结果之后。"
                    },
                    "decimal_places": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 12,
                      "description": "结果小数位数0—12：对源数字的精确有理数运算结果一次性按四舍六入五成双舍入，提交result须与该精度相符。区间两端分别核算；不会自动改写模型提交的结果。"
                    },
                    "result_unit": {
                      "type": "string",
                      "minLength": 1
                    },
                    "result_period": {
                      "type": "string",
                      "minLength": 1
                    },
                    "assumptions": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "denominator_role": {
                      "type": "string",
                      "minLength": 1
                    },
                    "formula": {
                      "type": "string",
                      "minLength": 1,
                      "description": "仅四则运算使用具名源数操作数、四则运算和括号。数学常数0/1可直接写；10的整数次幂可作单位换算倍率（如/1000或*1e-3），须用assumptions声明原/目标单位及换算依据。其他数值必须来自operands，不得通过常数绕过证据绑定；数学常量不证明被评模型执行过对应动作。"
                    },
                    "factor": {
                      "type": "string",
                      "minLength": 1
                    },
                    "observation_period": {
                      "type": "string",
                      "minLength": 1
                    },
                    "target_period": {
                      "type": "string",
                      "minLength": 1
                    },
                    "result_basis": {
                      "const": "按当前速度年化"
                    }
                  }
                }
              }
            }
          }
        },
        "has_standard_answer": {
          "type": "boolean"
        },
        "is_correct": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "correct_reason": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "has_standard_answer": {
                "const": false
              }
            }
          },
          "then": {
            "properties": {
              "is_correct": {
                "const": null
              },
              "correct_reason": {
                "const": null
              }
            }
          },
          "else": {
            "properties": {
              "correct_reason": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      ]
    },
    "verdict": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "result",
        "winner_version",
        "winner_name",
        "reason"
      ],
      "properties": {
        "result": {
          "enum": [
            "win",
            "both_good",
            "both_bad"
          ]
        },
        "winner_version": {
          "type": [
            "string",
            "null"
          ]
        },
        "winner_name": {
          "type": [
            "string",
            "null"
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "result": {
                "const": "win"
              }
            }
          },
          "then": {
            "properties": {
              "winner_version": {
                "type": "string",
                "minLength": 1
              },
              "winner_name": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "else": {
            "properties": {
              "winner_version": {
                "type": "null"
              },
              "winner_name": {
                "type": "null"
              }
            }
          }
        }
      ]
    }
  }
}
