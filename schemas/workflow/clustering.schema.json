{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "clustering_type",
    "evaluator_version",
    "task_id",
    "model",
    "batch_id",
    "items",
    "result"
  ],
  "properties": {
    "clustering_type": {
      "enum": [
        "problem_library"
      ]
    },
    "evaluator_version": {
      "type": "string",
      "minLength": 1
    },
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "model": {
      "type": "string",
      "minLength": 1
    },
    "batch_id": {
      "type": "string",
      "minLength": 1
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "component",
          "label",
          "count",
          "established_count",
          "uncertain_count"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "component": {
            "type": "string",
            "minLength": 1
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "count": {
            "type": "integer",
            "minimum": 1
          },
          "established_count": { "type": "integer", "minimum": 0 },
          "uncertain_count": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "result": {}
  }
}
