{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "job_id",
    "task_id",
    "submission_id",
    "evaluator_version",
    "stage",
    "model",
    "batch_ids",
    "items",
    "result"
  ],
  "properties": {
    "job_id": {
      "type": "string",
      "minLength": 1
    },
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "submission_id": {
      "type": "string",
      "minLength": 1
    },
    "evaluator_version": {
      "type": "string",
      "minLength": 1
    },
    "stage": {
      "enum": [
        "clustering",
        "rewrite"
      ]
    },
    "model": {
      "type": "string",
      "minLength": 1
    },
    "batch_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "source_task_id": {
      "type": "string",
      "minLength": 1
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "component",
          "label",
          "count",
          "established_count",
          "uncertain_count",
          "refs",
          "established_answer_ids"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "component": {
            "type": "string",
            "minLength": 1
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "count": {
            "type": "integer",
            "minimum": 1
          },
          "established_count": {
            "type": "integer",
            "minimum": 0
          },
          "uncertain_count": {
            "type": "integer",
            "minimum": 0
          },
          "refs": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "input_id",
                "case_id",
                "batch_id",
                "source",
                "problem_path",
                "message_index",
                "quote",
                "evidence_status",
                "attribution"
              ],
              "properties": {
                "input_id": {
                  "type": "string",
                  "minLength": 1
                },
                "case_id": {
                  "type": "string",
                  "minLength": 1
                },
                "batch_id": {
                  "type": "string",
                  "minLength": 1
                },
                "source": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "file",
                    "line"
                  ],
                  "properties": {
                    "file": {
                      "type": "string",
                      "minLength": 1
                    },
                    "line": {
                      "type": "integer",
                      "minimum": 1
                    }
                  }
                },
                "problem_path": {
                  "type": "string",
                  "minLength": 1
                },
                "message_index": {
                  "type": "integer",
                  "minimum": 0
                },
                "quote": {
                  "type": "string"
                },
                "evidence_status": {
                  "enum": [
                    "已确认",
                    "待核实"
                  ]
                },
                "attribution": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "run",
                    "run_id",
                    "task_id",
                    "submission_id",
                    "evaluator_version"
                  ],
                  "properties": {
                    "run": {
                      "type": "string",
                      "minLength": 1
                    },
                    "run_id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "task_id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "submission_id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "evaluator_version": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                }
              }
            }
          },
          "established_answer_ids": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "result": {}
  }
}
