{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "allOf": [
    {
      "$ref": "../attribution/result.schema.json"
    }
  ],
  "properties": {
    "meta": {
      "type": "object",
      "required": [
        "task_id",
        "submission_id",
        "run_id",
        "evaluator_version",
        "input_id",
        "batch_id",
        "case_id",
        "version",
        "judge",
        "trace_id",
        "answer_model",
        "input_file",
        "input_line",
        "business_date",
        "source_archive",
        "source_member",
        "source_line",
        "source_item"
      ],
      "properties": {
        "task_id": {
          "type": "string",
          "minLength": 1
        },
        "submission_id": {
          "type": "string",
          "minLength": 1
        },
        "run_id": {
          "type": "string",
          "minLength": 1
        },
        "evaluator_version": {
          "type": "string",
          "minLength": 1
        },
        "input_id": {
          "type": "string",
          "minLength": 1
        },
        "batch_id": {
          "type": "string",
          "minLength": 1
        },
        "case_id": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "judge": {
          "type": "string",
          "minLength": 1
        },
        "trace_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "answer_model": {
          "type": [
            "string",
            "null"
          ]
        },
        "input_file": {
          "type": "string",
          "minLength": 1
        },
        "input_line": {
          "type": "integer",
          "minimum": 1
        },
        "business_date": {
          "type": [
            "string",
            "null"
          ]
        },
        "source_archive": {
          "type": [
            "string",
            "null"
          ]
        },
        "source_member": {
          "type": [
            "string",
            "null"
          ]
        },
        "source_line": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "source_item": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        }
      }
    }
  }
}
