{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "evaluation_type",
    "evaluator_version",
    "task_id",
    "submission_id",
    "input_id",
    "batch_id",
    "case_id",
    "version",
    "judge",
    "trace_id",
    "answer_model",
    "input_file",
    "input_line",
    "business_date",
    "source_archive",
    "source_member",
    "source_line",
    "source_item",
    "has_standard_answer",
    "is_correct",
    "correctness_reason",
    "correctness_evidence",
    "task_analysis",
    "summary",
    "findings",
    "numeric_checks",
    "criterion_assessments",
    "core_assessment"
  ],
  "properties": {
    "evaluation_type": {
      "const": "attribution"
    },
    "evaluator_version": {
      "type": "string",
      "minLength": 1
    },
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "submission_id": {
      "type": "string",
      "minLength": 1
    },
    "input_id": {
      "type": "string",
      "minLength": 1
    },
    "batch_id": {
      "type": "string",
      "minLength": 1
    },
    "case_id": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "judge": {
      "type": "string",
      "minLength": 1
    },
    "meta": {},
    "trace_id": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "answer_model": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "input_file": {
      "type": "string",
      "minLength": 1
    },
    "input_line": {
      "type": "integer",
      "minimum": 1
    },
    "business_date": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "source_archive": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "source_member": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "source_line": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1
    },
    "source_item": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1
    },
    "verification": {
      "type": "object"
    },
    "rewritten": {
      "$ref": "../attribution/result.schema.json#/properties/rewritten"
    },
    "has_standard_answer": {
      "$ref": "../attribution/result.schema.json#/properties/has_standard_answer"
    },
    "is_correct": {
      "$ref": "../attribution/result.schema.json#/properties/is_correct"
    },
    "correctness_reason": {
      "$ref": "../attribution/result.schema.json#/properties/correctness_reason"
    },
    "correctness_evidence": {
      "$ref": "../attribution/result.schema.json#/properties/correctness_evidence"
    },
    "standard_conflict": {
      "$ref": "../attribution/result.schema.json#/properties/standard_conflict"
    },
    "task_analysis": {
      "$ref": "../attribution/result.schema.json#/properties/task_analysis"
    },
    "summary": {
      "$ref": "../attribution/result.schema.json#/properties/summary"
    },
    "findings": {
      "$ref": "../attribution/result.schema.json#/properties/findings"
    },
    "numeric_checks": {
      "$ref": "../attribution/result.schema.json#/properties/numeric_checks"
    },
    "criterion_assessments": {
      "$ref": "../attribution/result.schema.json#/properties/criterion_assessments"
    },
    "core_assessment": {
      "$ref": "../attribution/result.schema.json#/properties/core_assessment"
    },
    "table_resolutions": {
      "$ref": "../attribution/result.schema.json#/properties/table_resolutions"
    }
  }
}
