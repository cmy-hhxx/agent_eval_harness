{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "items"
  ],
  "properties": {
    "kind": {
      "enum": [
        "attribution",
        "comparison",
        "clustering"
      ]
    },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "batch_id",
        "case_id"
      ],
      "properties": {
        "batch_id": {
          "type": "string",
          "minLength": 1
        },
        "case_id": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "items": {
      "type": "array",
      "minItems": 0,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "label",
          "text"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "text": {
            "type": "string",
            "minLength": 1
          },
          "constraint": {
            "enum": [
              "no_winner"
            ],
            "description": "该槽位不存在整体胜者，禁止把局部差异改写成整体更好"
          }
        }
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "batch_id",
        "model"
      ],
      "properties": {
        "batch_id": {
          "type": "string",
          "minLength": 1
        },
        "model": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  },
  "oneOf": [
    {
      "properties": {
        "kind": {
          "enum": [
            "attribution",
            "comparison"
          ]
        }
      },
      "required": [
        "case"
      ],
      "not": {
        "required": [
          "scope"
        ]
      }
    },
    {
      "properties": {
        "kind": {
          "const": "clustering"
        }
      },
      "required": [
        "scope"
      ],
      "not": {
        "required": [
          "case"
        ]
      }
    }
  ]
}
