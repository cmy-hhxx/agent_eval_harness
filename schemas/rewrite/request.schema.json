{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "items"
  ],
  "properties": {
    "kind": {
      "enum": [
        "attribution",
        "comparison",
        "clustering"
      ]
    },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "batch_id",
        "case_id"
      ],
      "properties": {
        "batch_id": {
          "type": "string",
          "minLength": 1
        },
        "case_id": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "items": {
      "type": "array",
      "minItems": 0,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "label",
          "text"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "text": {
            "type": "string",
            "minLength": 1
          },
          "preference": {
            "type": "string",
            "minLength": 1,
            "description": "已确定的对局偏好，改写必须以此值加中文冒号开头，不得改变"
          },
          "context": {
            "type": "string",
            "minLength": 1,
            "description": "只读对照信息，不是待改写正文，不复制为开头或结论"
          },
          "forbiddenPrefixes": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            },
            "description": "不能复制到点评开头的呈现标签；正文直接说明本格事实"
          }
        }
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "batch_ids",
        "model"
      ],
      "properties": {
        "model": {
          "type": "string",
          "minLength": 1
        },
        "batch_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  },
  "oneOf": [
    {
      "properties": {
        "kind": {
          "enum": [
            "attribution",
            "comparison"
          ]
        }
      },
      "required": [
        "case"
      ],
      "not": {
        "required": [
          "scope"
        ]
      }
    },
    {
      "properties": {
        "kind": {
          "const": "clustering"
        }
      },
      "required": [
        "scope"
      ],
      "not": {
        "required": [
          "case"
        ]
      }
    }
  ]
}
