{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "assignments",
    "new_classes",
    "merges"
  ],
  "properties": {
    "assignments": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "item_id"
        ],
        "properties": {
          "item_id": {
            "type": "string",
            "pattern": "^O[1-9][0-9]*$"
          },
          "class_label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "new_class_index": {
            "type": "integer",
            "minimum": 0
          },
          "deferred_reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          }
        },
        "oneOf": [
          {
            "required": [
              "class_label"
            ]
          },
          {
            "required": [
              "new_class_index"
            ]
          },
          {
            "required": [
              "deferred_reason"
            ]
          }
        ]
      }
    },
    "new_classes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "component",
          "label",
          "definition",
          "novelty",
          "category_paths"
        ],
        "properties": {
          "component": {
            "type": "string",
            "minLength": 1
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "definition": {
            "type": "string",
            "minLength": 1
          },
          "closest_existing": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^C[1-9][0-9]*$"
          },
          "novelty": {
            "type": "string",
            "minLength": 1
          },
          "category_paths": {
            "type": "array",
            "maxItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "array",
              "minItems": 1,
              "maxItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 80,
                "pattern": "^(?![\\s\\S]*[<>\\[\\]{}\\u0000-\\u001F\\u007F-\\u009F\\u2028\\u2029])"
              }
            },
            "minItems": 1
          }
        }
      }
    },
    "merges": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "into",
          "from",
          "reason"
        ],
        "properties": {
          "into": {
            "type": "string",
            "pattern": "^C[1-9][0-9]*$"
          },
          "from": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "pattern": "^C[1-9][0-9]*$"
            }
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "class_updates": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "class_id",
          "reason"
        ],
        "properties": {
          "class_id": {
            "type": "string",
            "pattern": "^C[1-9][0-9]*$"
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "definition": {
            "type": "string",
            "minLength": 1
          },
          "category_paths": {
            "type": "array",
            "maxItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "array",
              "minItems": 1,
              "maxItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 80,
                "pattern": "^(?![\\s\\S]*[<>\\[\\]{}\\u0000-\\u001F\\u007F-\\u009F\\u2028\\u2029])"
              }
            },
            "minItems": 1
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          }
        },
        "anyOf": [
          {
            "required": [
              "label"
            ]
          },
          {
            "required": [
              "definition"
            ]
          },
          {
            "required": [
              "category_paths"
            ]
          }
        ]
      }
    }
  }
}
