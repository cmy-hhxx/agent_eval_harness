{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "assignments",
    "new_classes",
    "merges"
  ],
  "properties": {
    "assignments": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "item_id"
        ],
        "properties": {
          "item_id": {
            "type": "string",
            "minLength": 1
          },
          "class_id": {
            "type": "string",
            "minLength": 1
          },
          "new_class_key": {
            "type": "string",
            "minLength": 1
          },
          "deferred_reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          }
        },
        "oneOf": [
          {
            "required": [
              "class_id"
            ]
          },
          {
            "required": [
              "new_class_key"
            ]
          },
          {
            "required": [
              "deferred_reason"
            ]
          }
        ]
      }
    },
    "new_classes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "key",
          "component",
          "label",
          "definition",
          "closest_existing",
          "novelty",
          "category_paths"
        ],
        "properties": {
          "key": {
            "type": "string",
            "minLength": 1,
            "maxLength": 40
          },
          "component": {
            "type": "string",
            "minLength": 1
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "definition": {
            "type": "string",
            "minLength": 1
          },
          "closest_existing": {
            "type": [
              "string",
              "null"
            ]
          },
          "novelty": {
            "type": "string",
            "minLength": 1
          },
          "category_paths": {
            "type": "array",
            "maxItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "array",
              "minItems": 1,
              "maxItems": 3,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 80,
                "pattern": "^(?![\\s\\S]*[<>\\[\\]{}\\u0000-\\u001F\\u007F-\\u009F\\u2028\\u2029])"
              }
            },
            "minItems": 1
          }
        }
      }
    },
    "merges": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "into",
          "from",
          "reason"
        ],
        "properties": {
          "into": {
            "type": "string",
            "minLength": 1
          },
          "from": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "rewritten": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evaluator_version",
        "rewrites"
      ],
      "properties": {
        "evaluator_version": {
          "type": "string",
          "minLength": 1
        },
        "rewrites": {
          "type": "array",
          "minItems": 0,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "text"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 80
              },
              "text": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    "class_updates": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "class_id",
          "reason"
        ],
        "properties": {
          "class_id": {
            "type": "string",
            "minLength": 1
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "definition": {
            "type": "string",
            "minLength": 1
          },
          "category_paths": {
            "type": "array",
            "maxItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "array",
              "minItems": 1,
              "maxItems": 3,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 80,
                "pattern": "^(?![\\s\\S]*[<>\\[\\]{}\\u0000-\\u001F\\u007F-\\u009F\\u2028\\u2029])"
              }
            },
            "minItems": 1
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          }
        },
        "anyOf": [
          {
            "required": [
              "label"
            ]
          },
          {
            "required": [
              "definition"
            ]
          },
          {
            "required": [
              "category_paths"
            ]
          }
        ]
      }
    }
  }
}
