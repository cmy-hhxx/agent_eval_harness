{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "model",
    "batch_ids",
    "budget",
    "library",
    "items"
  ],
  "properties": {
    "model": {
      "type": "string",
      "minLength": 1
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "active_classes",
        "max_classes",
        "max_new_classes",
        "active_components",
        "max_components",
        "max_new_components",
        "consolidate",
        "min_support"
      ],
      "properties": {
        "assignment_only": {
          "type": "boolean"
        },
        "active_classes": {
          "type": "integer",
          "minimum": 0
        },
        "max_classes": {
          "type": "integer",
          "minimum": 1
        },
        "max_new_classes": {
          "type": "integer",
          "minimum": 0
        },
        "active_components": {
          "type": "integer",
          "minimum": 0
        },
        "max_components": {
          "type": "integer",
          "minimum": 1
        },
        "max_new_components": {
          "type": "integer",
          "minimum": 0
        },
        "consolidate": {
          "type": "boolean"
        },
        "min_support": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "library": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "components"
      ],
      "properties": {
        "components": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "label",
              "definition",
              "aliases",
              "classes"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "label": {
                "type": "string",
                "minLength": 1
              },
              "definition": {
                "type": "string"
              },
              "aliases": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "classes": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "id",
                    "label",
                    "definition",
                    "aliases",
                    "occurrences",
                    "examples"
                  ],
                  "properties": {
                    "id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "label": {
                      "type": "string",
                      "minLength": 1
                    },
                    "definition": {
                      "type": "string"
                    },
                    "aliases": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "occurrences": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "category_paths": {
                      "type": "array",
                      "maxItems": 1,
                      "uniqueItems": true,
                      "items": {
                        "type": "array",
                        "minItems": 1,
                        "maxItems": 3,
                        "uniqueItems": true,
                        "items": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 80,
                          "pattern": "^(?![\\s\\S]*[<>\\[\\]{}\\u0000-\\u001F\\u007F-\\u009F\\u2028\\u2029])"
                        }
                      }
                    },
                    "examples": {
                      "type": "array",
                      "maxItems": 3,
                      "items": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                          "input_id",
                          "batch_id",
                          "case_id",
                          "finding_id",
                          "evidence_status",
                          "run_id",
                          "task_id",
                          "submission_id"
                        ],
                        "properties": {
                          "input_id": {
                            "type": "string",
                            "minLength": 1
                          },
                          "batch_id": {
                            "type": "string",
                            "minLength": 1
                          },
                          "case_id": {
                            "type": "string",
                            "minLength": 1
                          },
                          "finding_id": {
                            "type": "string",
                            "minLength": 1
                          },
                          "evidence_status": {
                            "enum": [
                              "established",
                              "uncertain"
                            ]
                          },
                          "quote": {
                            "type": "string",
                            "maxLength": 601
                          },
                          "run_id": {
                            "type": "string",
                            "minLength": 1
                          },
                          "task_id": {
                            "type": "string",
                            "minLength": 1
                          },
                          "submission_id": {
                            "type": "string",
                            "minLength": 1
                          },
                          "finding": {
                            "type": "string",
                            "minLength": 1
                          },
                          "reason": {
                            "type": "string"
                          },
                          "attribution": {
                            "type": "object",
                            "additionalProperties": false,
                            "required": [
                              "run",
                              "run_id",
                              "task_id",
                              "submission_id",
                              "evaluator_version"
                            ],
                            "properties": {
                              "run": {
                                "type": "string",
                                "minLength": 1
                              },
                              "run_id": {
                                "type": "string",
                                "minLength": 1
                              },
                              "task_id": {
                                "type": "string",
                                "minLength": 1
                              },
                              "submission_id": {
                                "type": "string",
                                "minLength": 1
                              },
                              "evaluator_version": {
                                "type": "string",
                                "minLength": 1
                              }
                            }
                          },
                          "responsibilities": {
                            "type": "array",
                            "items": {
                              "type": "object",
                              "additionalProperties": false,
                              "required": [
                                "role",
                                "component",
                                "failure_stage",
                                "mechanism",
                                "certainty",
                                "reason",
                                "evidence_gap",
                                "alternatives",
                                "business_component",
                                "chain_index",
                                "chain_step",
                                "field_names",
                                "mechanism_source"
                              ],
                              "properties": {
                                "role": {
                                  "enum": [
                                    "primary",
                                    "contributing"
                                  ]
                                },
                                "component": {
                                  "type": "string"
                                },
                                "failure_stage": {
                                  "type": "string"
                                },
                                "mechanism": {
                                  "type": "string"
                                },
                                "certainty": {
                                  "enum": [
                                    "confirmed",
                                    "inferred"
                                  ]
                                },
                                "reason": {
                                  "type": "string"
                                },
                                "evidence_gap": {
                                  "type": [
                                    "string",
                                    "null"
                                  ]
                                },
                                "alternatives": {
                                  "type": "array",
                                  "items": {
                                    "type": "string"
                                  }
                                },
                                "business_component": {
                                  "type": "string",
                                  "minLength": 1
                                },
                                "chain_index": {
                                  "type": [
                                    "integer",
                                    "null"
                                  ],
                                  "minimum": 1
                                },
                                "chain_step": {
                                  "enum": [
                                    "用户目标",
                                    "查询规划与标的选择",
                                    "工具请求参数",
                                    "原始返回及字段含义",
                                    "返回整理与上下文传递",
                                    "模型实际输入",
                                    "数据解释与计算",
                                    "核验与最终交付"
                                  ]
                                },
                                "field_names": {
                                  "type": "array",
                                  "uniqueItems": true,
                                  "items": {
                                    "type": "string",
                                    "minLength": 1
                                  }
                                },
                                "mechanism_source": {
                                  "enum": [
                                    "explicit_process",
                                    "boundary_comparison"
                                  ]
                                }
                              }
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "component",
          "label",
          "definition",
          "count",
          "established_count",
          "uncertain_count",
          "examples",
          "established_answer_ids"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "component": {
            "type": "string",
            "minLength": 1
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "definition": {
            "type": "string"
          },
          "count": {
            "type": "integer",
            "minimum": 1
          },
          "established_count": {
            "type": "integer",
            "minimum": 0
          },
          "uncertain_count": {
            "type": "integer",
            "minimum": 0
          },
          "examples": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "finding",
                "reason",
                "dimension",
                "importance",
                "stage",
                "evidence_status"
              ],
              "properties": {
                "finding": {
                  "type": "string",
                  "minLength": 1
                },
                "reason": {
                  "type": "string"
                },
                "dimension": {
                  "type": "string"
                },
                "importance": {
                  "type": "string"
                },
                "stage": {
                  "type": "string"
                },
                "evidence_status": {
                  "enum": [
                    "established",
                    "uncertain"
                  ]
                },
                "responsibilities": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "role",
                      "component",
                      "failure_stage",
                      "mechanism",
                      "certainty",
                      "reason",
                      "evidence_gap",
                      "alternatives",
                      "business_component",
                      "chain_index",
                      "chain_step",
                      "field_names",
                      "mechanism_source",
                      "actor_index"
                    ],
                    "properties": {
                      "role": {
                        "enum": [
                          "primary",
                          "contributing"
                        ]
                      },
                      "component": {
                        "type": "string"
                      },
                      "failure_stage": {
                        "type": "string"
                      },
                      "mechanism": {
                        "type": "string"
                      },
                      "certainty": {
                        "enum": [
                          "confirmed",
                          "inferred"
                        ]
                      },
                      "reason": {
                        "type": "string"
                      },
                      "evidence_gap": {
                        "type": [
                          "string",
                          "null"
                        ]
                      },
                      "alternatives": {
                        "type": "array",
                        "items": {
                          "type": "string"
                        }
                      },
                      "business_component": {
                        "type": "string",
                        "minLength": 1
                      },
                      "chain_index": {
                        "type": [
                          "integer",
                          "null"
                        ],
                        "minimum": 1
                      },
                      "chain_step": {
                        "enum": [
                          "用户目标",
                          "查询规划与标的选择",
                          "工具请求参数",
                          "原始返回及字段含义",
                          "返回整理与上下文传递",
                          "模型实际输入",
                          "数据解释与计算",
                          "核验与最终交付"
                        ]
                      },
                      "field_names": {
                        "type": "array",
                        "uniqueItems": true,
                        "items": {
                          "type": "string",
                          "minLength": 1
                        }
                      },
                      "mechanism_source": {
                        "enum": [
                          "explicit_process",
                          "boundary_comparison"
                        ]
                      },
                      "actor_index": {
                        "type": [
                          "integer",
                          "null"
                        ],
                        "minimum": 1
                      }
                    }
                  }
                }
              }
            },
            "maxItems": 3
          },
          "established_answer_ids": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "batch_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
