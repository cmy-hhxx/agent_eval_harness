{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eval.local/attribution/problem.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "component",
    "label",
    "definition",
    "problem_phenomena",
    "reason",
    "severity",
    "severity_reason",
    "evidence"
  ],
  "properties": {
    "component": {
      "type": "string",
      "minLength": 1,
      "description": "程序复制责任组件名称：Compact components_name，或程序为匿名模型按工具命名的「<工具> 请求生成」；跨轮问题从 Compact 联合目录选择。"
    },
    "label": { "type": "string", "minLength": 1, "description": "可复用的短问题名称。" },
    "definition": { "type": "string", "minLength": 1, "description": "可复用的问题定义，写清同类偏差及适用条件。" },
    "problem_phenomena": { "type": "string", "minLength": 1, "description": "可独立读懂的个案说明：具体对象、应有情况与实际表现的偏差。" },
    "reason": { "type": "string", "minLength": 1, "description": "认定该偏差的依据，以及证据能确认的原因。" },
    "severity": { "enum": ["P0", "P1", "P2", "P3", "P4"], "description": "P0–P3 为对最终交付的影响等级，P0 最严重；P4 为已恢复或不影响交付的过程缺陷。" },
    "severity_reason": { "type": "string", "minLength": 1, "description": "具体影响及其为何属于该等级；只写证据支持的影响。" },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["position", "component", "quote", "reason"],
        "properties": {
          "position": { "type": "string", "minLength": 1, "description": "原始消息与字段坐标。" },
          "component": {
            "type": "string",
            "minLength": 1,
            "description": "证据所属位置，例如 reasoning: Expert 推理轮、tool_call: finquery 取数服务。"
          },
          "quote": { "type": "string", "minLength": 1, "maxLength": 400 },
          "reason": { "type": "string", "minLength": 1, "description": "这段原文具体证明了什么。" }
        }
      }
    },
    "calculations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["text"],
        "properties": { "text": { "type": "string", "minLength": 1, "description": "说明哪里算错了以及正确结果。" } }
      }
    }
  }
}
