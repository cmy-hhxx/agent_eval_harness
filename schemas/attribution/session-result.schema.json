{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eval.local/attribution/session-result.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["session_meta", "turns", "session_summary", "session_problem"],
  "properties": {
    "session_meta": { "type": "object" },
    "turns": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "./trace-result.schema.json" }
    },
    "session_summary": { "type": "string", "minLength": 1 },
    "session_problem": {
      "type": "array",
      "items": { "$ref": "./problem.schema.json" }
    }
  }
}
