{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "meta",
    "summary",
    "Problem",
    "has_standard_answer",
    "is_correct",
    "correct_reason"
  ],
  "properties": {
    "meta": {
      "type": "object"
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "description": "用简短中文概括本次评审结论。发现的缺陷也要写进Problem，不能只写摘要；不堆行情数字。"
    },
    "Problem": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "text",
          "reason",
          "evidence_status",
          "evidence",
          "attribution_reason",
          "problem_id",
          "component"
        ],
        "properties": {
          "problem_id": {
            "type": "string",
            "minLength": 1,
            "description": "程序按问题顺序生成编号。"
          },
          "text": {
            "type": "string",
            "minLength": 1,
            "description": "指出哪句回答、哪个操作或哪项交付有什么错。"
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "description": "对照事实说明为什么错、造成什么影响；保留原句的条件和限制，不重复text。"
          },
          "evidence_status": {
            "enum": [
              "已确认",
              "待核实"
            ],
            "description": "缺陷已经证实选“已确认”，缺陷本身还不能确定选“待核实”。不知道谁负责不影响已确认缺陷。"
          },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "evidence_id",
                "message_index",
                "quote",
                "purposes"
              ],
              "properties": {
                "message_index": {
                  "type": "integer",
                  "minimum": 0
                },
                "quote": {
                  "type": "string",
                  "minLength": 1
                },
                "source": {
                  "type": "string",
                  "minLength": 1
                },
                "source_input_id": {
                  "type": "string",
                  "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"
                },
                "evidence_id": {
                  "type": "string",
                  "minLength": 1
                },
                "purposes": {
                  "type": "array",
                  "items": {
                    "enum": [
                      "问题",
                      "归因"
                    ]
                  },
                  "minItems": 1,
                  "uniqueItems": true,
                  "description": "证明缺陷选“问题”，证明谁负责选“归因”；同一原文可以同时选两项。"
                }
              },
              "dependentRequired": {
                "source": [
                  "source_input_id"
                ],
                "source_input_id": [
                  "source"
                ]
              }
            },
            "description": "选择能说明问题和责任的原文。同一段原文只列一次，用purposes标明用途。"
          },
          "attribution_reason": {
            "type": "string",
            "minLength": 1,
            "description": "说明谁在哪次调用中形成了这个问题，所选原文支持到哪里。只看到输入输出变化时，不猜内部推理。无法定位时说清缺少哪段过程。"
          },
          "uncertainties": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true,
            "description": "只写还不知道的事实、不能证实的解释或其他可能原因。没有就省略；责任未知或缺陷待核实时必须写。"
          },
          "component": {
            "type": "string",
            "minLength": 1,
            "description": "程序按真实调用职责生成的中文名称，如终稿生成轮、Expert 推理轮、finquery 取数服务；确实无法定位才填责任主体未确定。"
          },
          "related_responsibilities": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "attribution_reason",
                "evidence_ids",
                "component"
              ],
              "properties": {
                "attribution_reason": {
                  "type": "string",
                  "minLength": 1
                },
                "uncertainties": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "string",
                    "minLength": 1
                  },
                  "uniqueItems": true
                },
                "evidence_ids": {
                  "type": "array",
                  "minItems": 1,
                  "uniqueItems": true,
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "component": {
                  "type": "string",
                  "minLength": 1,
                  "description": "程序按真实调用职责生成的中文名称，如终稿生成轮、Expert 推理轮、finquery 取数服务；确实无法定位才填责任主体未确定。"
                }
              }
            },
            "description": "只有另一个组件独立传播或扩大了同一问题才填写。正常传递、引用或渲染不算；没有就省略。"
          },
          "calculations": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "label",
                "operation",
                "operands",
                "result",
                "scale",
                "decimal_places",
                "result_unit",
                "result_period",
                "assumptions"
              ],
              "properties": {
                "label": {
                  "type": "string",
                  "minLength": 1,
                  "description": "说明这次计算用于核对哪项判断。"
                },
                "operation": {
                  "enum": [
                    "比值",
                    "相对变化",
                    "复利增长",
                    "年化",
                    "四则运算"
                  ],
                  "description": "选择本次实际使用的运算。"
                },
                "operands": {
                  "type": "object",
                  "minProperties": 1,
                  "additionalProperties": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "value",
                      "evidence_id",
                      "unit",
                      "period",
                      "role"
                    ],
                    "properties": {
                      "value": {
                        "type": "string",
                        "minLength": 1,
                        "description": "原数的十进制字符串，如\"9\"，不要填JSON数字。"
                      },
                      "evidence_id": {
                        "type": "string",
                        "minLength": 1
                      },
                      "unit": {
                        "type": "string",
                        "minLength": 1,
                        "description": "原数单位；复利rate用%或比值，periods用“期”。"
                      },
                      "period": {
                        "type": "string",
                        "minLength": 1,
                        "description": "原数对应期间。"
                      },
                      "role": {
                        "type": "string",
                        "minLength": 1,
                        "description": "这项数字代表什么，如累计成本、当前市值或年收益率。"
                      }
                    }
                  },
                  "description": "填写参与计算的原数及其单位、期间、含义和证据编号。比值用numerator、denominator；相对变化用base、observed；复利用rate、periods，可选base；年化用value；四则运算自行命名变量。区间比值将denominator替换为denominator_lower、denominator_upper。"
                },
                "result": {
                  "description": "单值填JSON数字，如2.1，不加引号；区间填写上下界对象，两端也用数字。声明decimal_places，程序精确复算；按声明小数位放大后不得超过安全整数范围。",
                  "type": [
                    "number",
                    "object"
                  ],
                  "additionalProperties": false,
                  "required": [
                    "lower",
                    "upper",
                    "include_lower",
                    "include_upper"
                  ],
                  "properties": {
                    "lower": {
                      "type": "number"
                    },
                    "upper": {
                      "type": "number"
                    },
                    "include_lower": {
                      "type": "boolean"
                    },
                    "include_upper": {
                      "type": "boolean"
                    }
                  }
                },
                "scale": {
                  "enum": [
                    "1",
                    "100"
                  ],
                  "description": "普通结果填\"1\"；结果用百分数显示时填\"100\"。这是显示倍率，不是误差范围。"
                },
                "decimal_places": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 12,
                  "description": "结果保留几位小数，填0至12的整数。程序用精确运算复算，按四舍六入五成双舍入一次。"
                },
                "result_unit": {
                  "type": "string",
                  "minLength": 1,
                  "description": "结果的单位，如美元、%、比值；不能省略。"
                },
                "result_period": {
                  "type": "string",
                  "minLength": 1,
                  "description": "结果对应的日期、季度或其他期间。"
                },
                "assumptions": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  },
                  "description": "写计算用到的假设或单位换算；没有假设填[]。年化必须说明按当前速度外推。"
                },
                "denominator_role": {
                  "type": "string",
                  "minLength": 1,
                  "description": "仅比值和相对变化填写，必须与分母或base的role相同；其他运算省略。"
                },
                "formula": {
                  "type": "string",
                  "minLength": 1,
                  "description": "仅四则运算填写，例如\"amount/divisor\"，使用operands中的变量；其他运算省略，不填空字符串。除0、1和已说明的十进制单位倍率外，数字放入operands。"
                },
                "factor": {
                  "type": "string",
                  "minLength": 1,
                  "description": "仅年化填写正数倍率的字符串，如\"4\"；其他运算省略。"
                },
                "observation_period": {
                  "type": "string",
                  "minLength": 1,
                  "description": "仅年化填写原数所在期间，必须与value.period相同。"
                },
                "target_period": {
                  "type": "string",
                  "minLength": 1,
                  "description": "仅年化填写外推到的期间，必须与result_period相同。"
                },
                "result_basis": {
                  "const": "按当前速度年化",
                  "description": "仅年化填写“按当前速度年化”，不要当成公司全年指引。"
                }
              }
            },
            "description": "问题是否成立确实需要计算时才填写，放在这条Problem内；不需要就省略，不放到顶层。"
          }
        }
      },
      "description": "逐条记录发现的问题。实际评审后没有问题才填空数组。"
    },
    "has_standard_answer": {
      "type": "boolean"
    },
    "is_correct": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "correct_reason": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "has_standard_answer": {
            "const": false
          }
        }
      },
      "then": {
        "properties": {
          "is_correct": {
            "const": null
          },
          "correct_reason": {
            "const": null
          }
        }
      },
      "else": {
        "properties": {
          "correct_reason": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  ]
}
