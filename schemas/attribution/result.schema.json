{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "has_standard_answer",
    "is_correct",
    "correctness_reason",
    "correctness_evidence",
    "task_analysis",
    "summary",
    "findings",
    "numeric_checks",
    "criterion_assessments",
    "core_assessment"
  ],
  "properties": {
    "has_standard_answer": {
      "type": "boolean"
    },
    "is_correct": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "correctness_reason": {
      "type": "string"
    },
    "correctness_evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "evidence_id",
          "message_index",
          "quote"
        ],
        "properties": {
          "message_index": {
            "type": "integer",
            "minimum": 0
          },
          "quote": {
            "type": "string",
            "minLength": 1
          },
          "source": {
            "type": "string",
            "minLength": 1
          },
          "source_input_id": {
            "type": "string",
            "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"
          },
          "evidence_id": {
            "type": "string",
            "minLength": 1
          }
        },
        "dependentRequired": {
          "source": [
            "source_input_id"
          ],
          "source_input_id": [
            "source"
          ]
        }
      }
    },
    "standard_conflict": {
      "type": "boolean",
      "description": "标准答案是否存在已证实的错误；默认 false，证据门槛见评审指引。"
    },
    "task_analysis": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "task_type",
        "goal",
        "requirements",
        "scoring_points",
        "red_flags"
      ],
      "properties": {
        "task_type": {
          "type": "string",
          "minLength": 1
        },
        "goal": {
          "type": "string",
          "minLength": 1
        },
        "requirements": {
          "type": "array",
          "minItems": 1,
          "maxItems": 24,
          "items": {
            "$ref": "#/$defs/criterion"
          }
        },
        "scoring_points": {
          "type": "array",
          "maxItems": 24,
          "items": {
            "$ref": "#/$defs/criterion"
          }
        },
        "red_flags": {
          "type": "array",
          "maxItems": 24,
          "items": {
            "$ref": "#/$defs/criterion"
          }
        }
      }
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "finding_id",
          "type",
          "dimension",
          "stage",
          "importance",
          "text",
          "reason",
          "evidence",
          "assessment",
          "problem"
        ],
        "properties": {
          "finding_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "type": {
            "enum": [
              "strength",
              "problem"
            ]
          },
          "dimension": {
            "enum": [
              "correctness",
              "completeness",
              "instruction_following",
              "evidence_quality",
              "reasoning",
              "format",
              "relevance",
              "efficiency"
            ]
          },
          "stage": {
            "enum": [
              "context_recall",
              "reasoning",
              "execution",
              "final_answer"
            ]
          },
          "importance": {
            "enum": [
              "high",
              "medium",
              "low"
            ]
          },
          "text": {
            "type": "string",
            "minLength": 1
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "evidence_id",
                "message_index",
                "quote"
              ],
              "properties": {
                "message_index": {
                  "type": "integer",
                  "minimum": 0
                },
                "quote": {
                  "type": "string",
                  "minLength": 1
                },
                "source": {
                  "type": "string",
                  "minLength": 1
                },
                "source_input_id": {
                  "type": "string",
                  "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"
                },
                "evidence_id": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "dependentRequired": {
                "source": [
                  "source_input_id"
                ],
                "source_input_id": [
                  "source"
                ]
              }
            }
          },
          "assessment": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "requirement_index",
              "observation",
              "evidence_status",
              "impact"
            ],
            "properties": {
              "requirement_index": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 0
              },
              "observation": {
                "type": "string",
                "minLength": 1
              },
              "evidence_status": {
                "enum": [
                  "established",
                  "uncertain"
                ]
              },
              "impact": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "problem": {
            "description": "type=strength 时填 JSON null；type=problem 时填写责任组件与问题描述。",
            "type": [
              "object",
              "null"
            ],
            "additionalProperties": false,
            "required": [
              "component",
              "label",
              "definition",
              "diagnosis",
              "investigation"
            ],
            "properties": {
              "component": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "technical_domain",
                    "functional_component",
                    "component",
                    "failure_stage",
                    "mechanism",
                    "reason",
                    "role",
                    "certainty",
                    "evidence_gap",
                    "alternatives",
                    "evidence_ids",
                    "business_component",
                    "chain_index",
                    "chain_step",
                    "field_names",
                    "mechanism_source",
                    "actor_index"
                  ],
                  "properties": {
                    "technical_domain": {
                      "type": "string",
                      "minLength": 1
                    },
                    "functional_component": {
                      "type": "string",
                      "minLength": 1
                    },
                    "component": {
                      "type": "string",
                      "minLength": 1
                    },
                    "failure_stage": {
                      "type": "string",
                      "minLength": 1
                    },
                    "mechanism": {
                      "type": "string",
                      "minLength": 1
                    },
                    "reason": {
                      "type": "string",
                      "minLength": 1
                    },
                    "role": {
                      "enum": [
                        "primary",
                        "contributing"
                      ]
                    },
                    "certainty": {
                      "enum": [
                        "confirmed",
                        "inferred"
                      ]
                    },
                    "evidence_gap": {
                      "type": [
                        "string",
                        "null"
                      ],
                      "minLength": 1
                    },
                    "alternatives": {
                      "type": "array",
                      "uniqueItems": true,
                      "items": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "evidence_ids": {
                      "type": "array",
                      "minItems": 1,
                      "uniqueItems": true,
                      "items": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "business_component": {
                      "type": "string",
                      "minLength": 1
                    },
                    "chain_index": {
                      "type": [
                        "integer",
                        "null"
                      ],
                      "minimum": 1
                    },
                    "chain_step": {
                      "enum": [
                        "用户目标",
                        "查询规划与标的选择",
                        "工具请求参数",
                        "原始返回及字段含义",
                        "返回整理与上下文传递",
                        "模型实际输入",
                        "数据解释与计算",
                        "核验与最终交付"
                      ]
                    },
                    "field_names": {
                      "type": "array",
                      "uniqueItems": true,
                      "items": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "mechanism_source": {
                      "enum": [
                        "explicit_process",
                        "boundary_comparison"
                      ]
                    },
                    "actor_index": {
                      "type": [
                        "integer",
                        "null"
                      ],
                      "minimum": 1
                    }
                  }
                }
              },
              "label": {
                "type": "string",
                "minLength": 1
              },
              "definition": {
                "type": "string",
                "minLength": 1
              },
              "diagnosis": {
                "enum": [
                  "entity_or_unit",
                  "source_absence",
                  "context_loss",
                  "other"
                ]
              },
              "investigation": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "chain_index",
                    "steps"
                  ],
                  "properties": {
                    "chain_index": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "steps": {
                      "type": "array",
                      "minItems": 1,
                      "maxItems": 8,
                      "items": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                          "step",
                          "status",
                          "observation",
                          "evidence_ids"
                        ],
                        "properties": {
                          "step": {
                            "enum": [
                              "用户目标",
                              "查询规划与标的选择",
                              "工具请求参数",
                              "原始返回及字段含义",
                              "返回整理与上下文传递",
                              "模型实际输入",
                              "数据解释与计算",
                              "核验与最终交付"
                            ]
                          },
                          "status": {
                            "enum": [
                              "checked",
                              "not_collected"
                            ]
                          },
                          "observation": {
                            "type": "string",
                            "minLength": 1
                          },
                          "evidence_ids": {
                            "type": "array",
                            "uniqueItems": true,
                            "items": {
                              "type": "string",
                              "minLength": 1
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "context_evidence": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "evidence_id",
                "message_index",
                "quote"
              ],
              "properties": {
                "message_index": {
                  "type": "integer",
                  "minimum": 0
                },
                "quote": {
                  "type": "string",
                  "minLength": 1
                },
                "source": {
                  "type": "string",
                  "minLength": 1
                },
                "source_input_id": {
                  "type": "string",
                  "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"
                },
                "evidence_id": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "dependentRequired": {
                "source": [
                  "source_input_id"
                ],
                "source_input_id": [
                  "source"
                ]
              }
            },
            "description": "程序绑定的完整规范上下文，保留条件与例外；不作为直接支持结论的聚焦引用。"
          }
        }
      }
    },
    "numeric_checks": {
      "type": "array",
      "maxItems": 64,
      "description": "记录可直接比较的同口径标准点值，不能仅列错误项；确实未交付该目标时保留 actual=null、matches=false。matches 仅为算术观察，不决定整体正确性。显式容差、区间、上下限及须计算或解码的表达在 correctness_reason 按原规则核验，该目标不入表；最终回答已直接给出的计算结果可按原值入表。无标准或没有直接点值目标时填空数组。",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "label",
          "expected",
          "actual",
          "scale",
          "matches",
          "mode",
          "evidence_index"
        ],
        "properties": {
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "expected": {
            "type": "string",
            "pattern": "^[+-]?\\d+(?:\\.\\d+)?(?:[eE][+-]?\\d{1,3})?$",
            "maxLength": 80,
            "description": "标准中的原数值，保留小数位与科学计数法指数，不展开或改写精度"
          },
          "actual": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^[+-]?\\d+(?:\\.\\d+)?(?:[eE][+-]?\\d{1,3})?$",
            "maxLength": 80,
            "description": "最终回答原数值；确实未提供该项时为null，绝不能用0表示缺失"
          },
          "scale": {
            "type": "string",
            "pattern": "^[+-]?\\d+(?:\\.\\d+)?(?:[eE][+-]?\\d{1,3})?$",
            "maxLength": 80,
            "description": "有证据依据的回答单位到标准单位的正倍率，同单位填1；不能为使数值相等而选择倍率"
          },
          "matches": {
            "type": "boolean",
            "description": "仅记录 actual*scale 与 expected 的算术比较：rounded 按标准末位精度四舍五入，exact 精确比较；actual=null 时为false。不表示语义正确性，须结合 correctness_reason 的原题、计算与证据判断"
          },
          "mode": {
            "enum": [
              "rounded",
              "exact"
            ],
            "description": "算术观察方式：rounded 按标准末位精度舍入，exact 精确比较，离散计数用exact；精度差异的语义结论由 correctness_reason 说明，容差、区间和上下限不使用此表"
          },
          "evidence_index": {
            "type": "integer",
            "minimum": 0,
            "description": "correctness_evidence 的零起始位置；actual 非 null 时证据包含最终回答原值，actual=null 时证据覆盖待核缺失范围，均须指向本方最终回答"
          }
        }
      }
    },
    "criterion_assessments": {
      "type": "array",
      "minItems": 1,
      "maxItems": 24,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "criterion_id",
          "status",
          "evidence_status",
          "summary",
          "evidence"
        ],
        "properties": {
          "criterion_id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]{0,31}$"
          },
          "status": {
            "enum": [
              "met",
              "partial",
              "unmet",
              "unknown",
              "not_applicable"
            ]
          },
          "evidence_status": {
            "enum": [
              "established",
              "uncertain"
            ]
          },
          "summary": {
            "type": "string",
            "minLength": 1
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "evidence_id",
                "message_index",
                "quote"
              ],
              "properties": {
                "message_index": {
                  "type": "integer",
                  "minimum": 0
                },
                "quote": {
                  "type": "string",
                  "minLength": 1
                },
                "source": {
                  "type": "string",
                  "minLength": 1
                },
                "source_input_id": {
                  "type": "string",
                  "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"
                },
                "evidence_id": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "dependentRequired": {
                "source": [
                  "source_input_id"
                ],
                "source_input_id": [
                  "source"
                ]
              }
            }
          },
          "context_evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "evidence_id",
                "message_index",
                "quote"
              ],
              "properties": {
                "message_index": {
                  "type": "integer",
                  "minimum": 0
                },
                "quote": {
                  "type": "string",
                  "minLength": 1
                },
                "source": {
                  "type": "string",
                  "minLength": 1
                },
                "source_input_id": {
                  "type": "string",
                  "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"
                },
                "evidence_id": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "dependentRequired": {
                "source": [
                  "source_input_id"
                ],
                "source_input_id": [
                  "source"
                ]
              }
            },
            "description": "程序绑定的完整规范上下文，保留条件与例外；不作为直接支持结论的聚焦引用。",
            "minItems": 1
          }
        }
      }
    },
    "core_assessment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "meets_core",
        "reason",
        "criterion_ids"
      ],
      "properties": {
        "meets_core": {
          "type": [
            "boolean",
            "null"
          ],
          "description": "true 仅表示所选核心要求全部已确认实际完成（met）；核心 partial/unmet 不能判 true，影响核心的事实待核则为 null；非核心附属缺陷不自动否定完成。"
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "criterion_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]{0,31}$"
          }
        }
      }
    },
    "table_resolutions": {
      "type": "array",
      "maxItems": 100,
      "description": "An evidence-backed judgment of an unresolved table row.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "table_id",
          "row_index",
          "outcome",
          "reason",
          "evidence"
        ],
        "properties": {
          "table_id": {
            "type": "string",
            "minLength": 1
          },
          "row_index": {
            "type": "integer",
            "minimum": 0
          },
          "outcome": {
            "enum": [
              "supported",
              "conflict"
            ]
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "evidence": {
            "type": "array",
            "minItems": 2,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "evidence_id",
                "message_index",
                "quote"
              ],
              "properties": {
                "message_index": {
                  "type": "integer",
                  "minimum": 0
                },
                "quote": {
                  "type": "string",
                  "minLength": 1
                },
                "source": {
                  "type": "string",
                  "minLength": 1
                },
                "source_input_id": {
                  "type": "string",
                  "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"
                },
                "evidence_id": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "dependentRequired": {
                "source": [
                  "source_input_id"
                ],
                "source_input_id": [
                  "source"
                ]
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "criterion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "text",
        "applies_to",
        "acceptance_rule"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]{0,31}$"
        },
        "text": {
          "type": "string",
          "minLength": 1
        },
        "applies_to": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
          }
        },
        "acceptance_rule": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
