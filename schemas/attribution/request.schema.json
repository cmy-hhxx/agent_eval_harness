{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "ground_truth",
    "answer",
    "candidate_id",
    "task_analysis"
  ],
  "properties": {
    "ground_truth": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "available",
        "value"
      ],
      "properties": {
        "available": {
          "type": "boolean"
        },
        "value": {}
      }
    },
    "answer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "identity",
        "question",
        "final_message_index",
        "final_answer",
        "final_evidence",
        "deferred_final_material",
        "initial_material",
        "catalog",
        "input_file",
        "original_answer_timing",
        "table_check_results",
        "note",
        "norm_directory"
      ],
      "properties": {
        "identity": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "version_id",
            "display_name",
            "answer_model"
          ],
          "properties": {
            "version_id": {
              "type": "string",
              "minLength": 1
            },
            "display_name": {
              "type": "string",
              "minLength": 1
            },
            "answer_model": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        },
        "question": {
          "type": "string",
          "minLength": 1
        },
        "final_message_index": {
          "type": "integer",
          "minimum": 0
        },
        "final_answer": {
          "type": "string",
          "description": "当前展示的最终回答原文；全部正文延后读取时为空，完整内容由 deferred_final_material 定位。"
        },
        "final_evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidence"
          }
        },
        "deferred_final_material": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "message_index",
              "path",
              "total_chars"
            ],
            "properties": {
              "message_index": {
                "type": "integer",
                "minimum": 0
              },
              "path": {
                "type": "string",
                "minLength": 1
              },
              "total_chars": {
                "type": "integer",
                "minimum": 1
              }
            }
          }
        },
        "initial_material": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "message_index",
              "value",
              "evidence"
            ],
            "properties": {
              "message_index": {
                "type": "integer",
                "minimum": 0
              },
              "value": {},
              "evidence": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/evidence"
                }
              }
            }
          }
        },
        "catalog": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "message_index",
              "type",
              "chars"
            ],
            "properties": {
              "message_index": {
                "type": "integer",
                "minimum": 0
              },
              "type": {
                "type": "string",
                "minLength": 1
              },
              "role": {
                "type": "string"
              },
              "name": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "call_message_index": {
                "type": "integer",
                "minimum": 0
              },
              "chars": {
                "type": "integer",
                "minimum": 0
              }
            }
          }
        },
        "input_file": {
          "const": "inputs/answer.json"
        },
        "original_answer_timing": {
          "type": "object",
          "required": [
            "finish_seconds"
          ],
          "properties": {
            "finish_seconds": {
              "type": [
                "number",
                "null"
              ]
            }
          }
        },
        "note": {
          "type": "string",
          "minLength": 1
        },
        "table_check_results": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/tableCheckResult"
          }
        },
        "instruction_sources": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/instructionSource"
          }
        },
        "citation_inventory": {
          "$ref": "#/$defs/citationInventory"
        },
        "criterion_instruction_sources": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "evidence_id",
                "message_index",
                "path",
                "quote"
              ],
              "properties": {
                "message_index": {
                  "type": "integer",
                  "minimum": 0
                },
                "path": {
                  "type": "string",
                  "minLength": 1
                },
                "quote": {
                  "type": "string",
                  "minLength": 1
                },
                "evidence_id": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        },
        "answer_generation": {
          "$ref": "#/$defs/answer_generation"
        },
        "norm_directory": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/attributionNorm"
          }
        }
      }
    },
    "candidate_id": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
    },
    "task_analysis": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "task_type",
        "goal",
        "requirements",
        "scoring_points",
        "red_flags"
      ],
      "properties": {
        "task_type": {
          "type": "string",
          "minLength": 1
        },
        "goal": {
          "type": "string",
          "minLength": 1
        },
        "requirements": {
          "type": "array",
          "minItems": 1,
          "maxItems": 24,
          "items": {
            "$ref": "#/$defs/criterion"
          }
        },
        "scoring_points": {
          "type": "array",
          "maxItems": 24,
          "items": {
            "$ref": "#/$defs/criterion"
          }
        },
        "red_flags": {
          "type": "array",
          "maxItems": 24,
          "items": {
            "$ref": "#/$defs/criterion"
          }
        }
      }
    },
    "review_context": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reasons"
      ],
      "properties": {
        "reasons": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "reference_materials": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "type": "string",
        "minLength": 1,
        "not": {
          "const": "answer"
        }
      },
      "additionalProperties": {
        "$ref": "#/$defs/reference_material"
      }
    }
  },
  "$defs": {
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidence_id",
        "message_index",
        "quote"
      ],
      "properties": {
        "evidence_id": {
          "type": "string",
          "minLength": 1
        },
        "message_index": {
          "type": "integer",
          "minimum": 0
        },
        "quote": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "criterion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "text",
        "applies_to",
        "acceptance_rule"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]{0,31}$"
        },
        "text": {
          "type": "string",
          "minLength": 1
        },
        "applies_to": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
          }
        },
        "acceptance_rule": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "tableCheckResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "answer_table_id",
        "rows",
        "summary"
      ],
      "properties": {
        "answer_table_id": {
          "type": "string",
          "minLength": 1
        },
        "rows": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "row_index",
              "status",
              "answer",
              "sources"
            ],
            "properties": {
              "row_index": {
                "type": "integer",
                "minimum": 0
              },
              "status": {
                "enum": [
                  "conflict",
                  "unverified",
                  "ambiguous"
                ]
              },
              "answer": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "cells",
                  "evidence"
                ],
                "properties": {
                  "cells": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "evidence": {
                    "$ref": "#/$defs/evidence"
                  }
                }
              },
              "sources": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "row_index",
                    "cells",
                    "evidence",
                    "table_id",
                    "matched_by"
                  ],
                  "properties": {
                    "row_index": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "cells": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "evidence": {
                      "$ref": "#/$defs/evidence"
                    },
                    "table_id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "matched_by": {
                      "enum": [
                        "key",
                        "value"
                      ]
                    }
                  }
                }
              }
            }
          }
        },
        "summary": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "matched",
            "conflict",
            "unverified",
            "ambiguous"
          ],
          "properties": {
            "matched": {
              "type": "integer",
              "minimum": 0
            },
            "conflict": {
              "type": "integer",
              "minimum": 0
            },
            "unverified": {
              "type": "integer",
              "minimum": 0
            },
            "ambiguous": {
              "type": "integer",
              "minimum": 0
            }
          }
        }
      }
    },
    "instructionSource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "message_index",
        "path",
        "role",
        "content",
        "evidence"
      ],
      "properties": {
        "message_index": {
          "type": "integer",
          "minimum": 0
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "role": {
          "enum": [
            "system",
            "developer"
          ]
        },
        "content": {},
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidence"
          }
        }
      }
    },
    "citationInventory": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocols",
        "references",
        "document_groups"
      ],
      "properties": {
        "protocols": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "footnote",
              "trace",
              "vis-html"
            ]
          }
        },
        "references": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "reference",
              "format",
              "status",
              "occurrences",
              "sources"
            ],
            "properties": {
              "reference": {
                "type": "string",
                "minLength": 1
              },
              "format": {
                "enum": [
                  "footnote",
                  "trace",
                  "vis-html"
                ]
              },
              "status": {
                "enum": [
                  "resolved",
                  "ambiguous",
                  "unknown"
                ]
              },
              "occurrences": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/citationOccurrence"
                }
              },
              "sources": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/citationSource"
                }
              }
            }
          }
        },
        "document_groups": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "url",
              "references"
            ],
            "properties": {
              "url": {
                "type": "string",
                "minLength": 1
              },
              "references": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "format",
                    "reference"
                  ],
                  "properties": {
                    "format": {
                      "enum": [
                        "footnote",
                        "trace",
                        "vis-html"
                      ]
                    },
                    "reference": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "citationOccurrence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidence_id",
        "message_index",
        "quote",
        "context"
      ],
      "properties": {
        "evidence_id": {
          "$ref": "#/$defs/evidence/properties/evidence_id"
        },
        "message_index": {
          "$ref": "#/$defs/evidence/properties/message_index"
        },
        "quote": {
          "$ref": "#/$defs/evidence/properties/quote"
        },
        "context": {
          "$ref": "#/$defs/citationContext"
        }
      }
    },
    "citationContext": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidence_id",
        "message_index",
        "quote",
        "read_request",
        "end_offset"
      ],
      "properties": {
        "evidence_id": {
          "$ref": "#/$defs/evidence/properties/evidence_id"
        },
        "message_index": {
          "$ref": "#/$defs/evidence/properties/message_index"
        },
        "quote": {
          "$ref": "#/$defs/evidence/properties/quote"
        },
        "read_request": {
          "$ref": "#/$defs/citationSource/properties/read_request"
        },
        "end_offset": {
          "$ref": "#/$defs/citationSource/properties/end_offset"
        }
      }
    },
    "citationSource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidence_id",
        "message_index",
        "quote",
        "origin",
        "read_request",
        "end_offset"
      ],
      "properties": {
        "evidence_id": {
          "type": "string",
          "minLength": 1
        },
        "message_index": {
          "type": "integer",
          "minimum": 0
        },
        "quote": {
          "type": "string",
          "minLength": 1
        },
        "origin": {
          "enum": [
            "tool_return",
            "model_visible"
          ]
        },
        "end_offset": {
          "type": "integer",
          "minimum": 1
        },
        "read_request": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "message_index",
            "path",
            "offset",
            "max_chars"
          ],
          "properties": {
            "message_index": {
              "type": "integer",
              "minimum": 0
            },
            "path": {
              "type": "string"
            },
            "offset": {
              "type": "integer",
              "minimum": 0
            },
            "max_chars": {
              "type": "integer",
              "minimum": 1,
              "maximum": 16000
            }
          }
        },
        "document_url": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "reference_material": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "question",
        "final_message_index",
        "final_answer",
        "final_evidence",
        "deferred_final_material",
        "initial_material",
        "catalog",
        "input_file",
        "original_answer_timing",
        "table_check_results",
        "note",
        "source_input_id",
        "original_user_timestamp",
        "grader_only"
      ],
      "properties": {
        "identity": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "version_id",
            "display_name",
            "answer_model"
          ],
          "properties": {
            "version_id": {
              "type": "string",
              "minLength": 1
            },
            "display_name": {
              "type": "string",
              "minLength": 1
            },
            "answer_model": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        },
        "question": {
          "type": "string",
          "minLength": 1
        },
        "final_message_index": {
          "type": "integer",
          "minimum": 0
        },
        "final_answer": {
          "type": "string",
          "description": "当前展示的最终回答原文；全部正文延后读取时为空，完整内容由 deferred_final_material 定位。"
        },
        "final_evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidence"
          }
        },
        "deferred_final_material": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "message_index",
              "path",
              "total_chars"
            ],
            "properties": {
              "message_index": {
                "type": "integer",
                "minimum": 0
              },
              "path": {
                "type": "string",
                "minLength": 1
              },
              "total_chars": {
                "type": "integer",
                "minimum": 1
              }
            }
          }
        },
        "initial_material": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "message_index",
              "value",
              "evidence"
            ],
            "properties": {
              "message_index": {
                "type": "integer",
                "minimum": 0
              },
              "value": {},
              "evidence": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/evidence"
                }
              }
            }
          }
        },
        "catalog": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "message_index",
              "type",
              "chars"
            ],
            "properties": {
              "message_index": {
                "type": "integer",
                "minimum": 0
              },
              "type": {
                "type": "string",
                "minLength": 1
              },
              "role": {
                "type": "string"
              },
              "name": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "call_message_index": {
                "type": "integer",
                "minimum": 0
              },
              "chars": {
                "type": "integer",
                "minimum": 0
              }
            }
          }
        },
        "input_file": {
          "type": "string",
          "minLength": 1
        },
        "original_answer_timing": {
          "type": "object",
          "required": [
            "finish_seconds"
          ],
          "properties": {
            "finish_seconds": {
              "type": [
                "number",
                "null"
              ]
            }
          }
        },
        "note": {
          "type": "string",
          "minLength": 1
        },
        "table_check_results": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/tableCheckResult"
          }
        },
        "citation_inventory": {
          "$ref": "#/$defs/citationInventory"
        },
        "source_input_id": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"
        },
        "original_user_timestamp": {
          "type": [
            "string",
            "null"
          ]
        },
        "grader_only": {
          "const": true
        },
        "answer_generation": {
          "$ref": "#/$defs/answer_generation"
        }
      }
    },
    "answer_generation": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "available",
            "message_type",
            "message_index",
            "captured_final_message_index",
            "matches_captured_final",
            "blocks",
            "input_contexts"
          ],
          "properties": {
            "available": {
              "const": true
            },
            "message_type": {
              "const": "llm_turn"
            },
            "message_index": {
              "type": "integer",
              "minimum": 0
            },
            "captured_final_message_index": {
              "type": "integer",
              "minimum": 0
            },
            "matches_captured_final": {
              "type": [
                "boolean",
                "null"
              ]
            },
            "blocks": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "path",
                  "total_chars",
                  "text",
                  "reference",
                  "read_request"
                ],
                "properties": {
                  "path": {
                    "type": "string",
                    "minLength": 1
                  },
                  "total_chars": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "text": {
                    "type": "string"
                  },
                  "reference": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "evidence_id"
                    ],
                    "properties": {
                      "evidence_id": {
                        "type": "string",
                        "minLength": 1
                      }
                    }
                  },
                  "read_request": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "message_index",
                      "path",
                      "offset",
                      "max_chars"
                    ],
                    "properties": {
                      "message_index": {
                        "type": "integer",
                        "minimum": 0
                      },
                      "path": {
                        "type": "string",
                        "minLength": 1
                      },
                      "offset": {
                        "const": 0
                      },
                      "max_chars": {
                        "const": 16000
                      }
                    }
                  }
                }
              }
            },
            "input_contexts": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "message_index",
                  "path",
                  "total_chars",
