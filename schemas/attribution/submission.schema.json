{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "criterion_assessments": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "status": {
            "enum": [
              "met",
              "partial",
              "unmet",
              "unknown"
            ]
          },
          "evidence_status": {
            "enum": [
              "established",
              "uncertain"
            ]
          },
          "summary": {
            "type": "string",
            "minLength": 1
          },
          "evidence_indices": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "required": [
          "status",
          "evidence_status",
          "summary",
          "evidence_indices"
        ]
      },
      "minItems": 1,
      "maxItems": 24
    },
    "meets_core": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "core_reason": {
      "type": "string",
      "minLength": 1
    },
    "core_requirements": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "integer",
        "minimum": 1
      }
    },
    "numeric_checks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "reference_index": {
            "type": "integer",
            "minimum": 1
          },
          "actual": {
            "type": [
              "string",
              "number",
              "null"
            ],
            "pattern": "^[+-]?\\d+(?:\\.\\d+)?(?:[eE][+-]?\\d{1,3})?$",
            "maxLength": 80
          },
          "scale": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[+-]?\\d+(?:\\.\\d+)?(?:[eE][+-]?\\d{1,3})?$",
            "maxLength": 80
          },
          "mode": {
            "enum": [
              "rounded",
              "exact"
            ]
          },
          "evidence_index": {
            "type": "integer",
            "minimum": 1
          }
        },
        "required": [
          "label",
          "reference_index",
          "actual",
          "scale",
          "mode",
          "evidence_index"
        ]
      },
      "maxItems": 64
    },
    "is_correct": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "correctness_reason": {
      "type": "string"
    },
    "correctness_evidence_indices": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 1
      }
    },
    "standard_conflict": {
      "type": "boolean",
      "description": "仅在已核实本方工具返回或独立来源支持回答值、而导入标准与之冲突（口径不同或上游数据不一致）时填 true；模型自身错误、口径未核实或标准已正确应用时填 false。"
    },
    "image_observations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "image_number": {
            "type": "integer",
            "minimum": 1
          },
          "text": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "image_number",
          "text"
        ]
      }
    },
    "table_resolutions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "table_index": {
            "type": "integer",
            "minimum": 1
          },
          "row_index": {
            "type": "integer",
            "minimum": 0
          },
          "outcome": {
            "enum": [
              "supported",
              "conflict"
            ]
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "evidence_indices": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 1
            },
            "minItems": 2
          }
        },
        "required": [
          "table_index",
          "row_index",
          "outcome",
          "reason",
          "evidence_indices"
        ]
      },
      "maxItems": 100
    },
    "strengths": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "dimension": {
            "enum": [
              "correctness",
              "completeness",
              "instruction_following",
              "evidence_quality",
              "reasoning",
              "format",
              "relevance",
              "efficiency"
            ]
          },
          "stage": {
            "enum": [
              "context_recall",
              "reasoning",
              "execution",
              "final_answer"
            ]
          },
          "importance": {
            "enum": [
              "high",
              "medium",
              "low"
            ]
          },
          "text": {
            "type": "string",
            "minLength": 1
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "evidence_status": {
            "enum": [
              "established",
              "uncertain"
            ]
          },
          "evidence_indices": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 1
            }
          },
          "basis_index": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1
          }
        },
        "required": [
          "dimension",
          "stage",
          "importance",
          "text",
          "reason",
          "evidence_status",
          "evidence_indices",
          "basis_index"
        ]
      }
    },
    "problems": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "dimension": {
            "enum": [
              "correctness",
              "completeness",
              "instruction_following",
              "evidence_quality",
              "reasoning",
              "format",
              "relevance",
              "efficiency"
            ]
          },
          "stage": {
            "enum": [
              "context_recall",
              "reasoning",
              "execution",
              "final_answer"
            ]
          },
          "importance": {
            "enum": [
              "high",
              "medium",
              "low"
            ]
          },
          "text": {
            "type": "string",
            "minLength": 1
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "impact": {
            "type": "string",
            "minLength": 1
          },
          "evidence_status": {
            "enum": [
              "established",
              "uncertain"
            ]
          },
          "evidence_indices": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 1
            }
          },
          "basis_index": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1
          },
          "model_responsible": {
            "type": "boolean"
          },
          "tool_evidence_indices": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 1
            }
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "definition": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "dimension",
          "stage",
          "importance",
          "text",
          "reason",
          "impact",
          "evidence_status",
          "evidence_indices",
          "basis_index",
          "model_responsible",
          "tool_evidence_indices",
          "label",
          "definition"
        ]
      }
    }
  },
  "required": [
    "summary",
    "criterion_assessments",
    "meets_core",
    "core_reason",
    "core_requirements",
    "numeric_checks",
    "strengths",
    "problems",
    "is_correct",
    "correctness_reason",
    "correctness_evidence_indices"
  ]
}
