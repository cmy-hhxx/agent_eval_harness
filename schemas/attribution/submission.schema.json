{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "summary",
    "Problem"
  ],
  "properties": {
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "Problem": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "text",
          "reason",
          "evidence_status",
          "evidence_indices",
          "checks",
          "causes"
        ],
        "properties": {
          "text": {
            "type": "string",
            "minLength": 1
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "evidence_status": {
            "enum": [
              "established",
              "uncertain"
            ]
          },
          "evidence_indices": {
            "type": "array",
            "items": {
              "oneOf": [
                {
                  "type": "integer",
                  "minimum": 1
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "image_number",
                    "observation"
                  ],
                  "properties": {
                    "image_number": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "observation": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                }
              ]
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "checks": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "transition_index",
                "outcome",
                "observation",
                "before_evidence_indices",
                "after_evidence_indices"
              ],
              "properties": {
                "transition_index": {
                  "type": "integer",
                  "minimum": 1
                },
                "outcome": {
                  "enum": [
                    "preserved",
                    "changed",
                    "recovered",
                    "unresolved"
                  ]
                },
                "observation": {
                  "type": "string",
                  "minLength": 1
                },
                "before_evidence_indices": {
                  "type": "array",
                  "uniqueItems": true,
                  "items": {
                    "type": "integer",
                    "minimum": 1
                  }
                },
                "after_evidence_indices": {
                  "type": "array",
                  "uniqueItems": true,
                  "items": {
                    "type": "integer",
                    "minimum": 1
                  }
                }
              }
            }
          },
          "causes": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "transition_index",
                "basis",
                "mechanism_source",
                "reason",
                "certainty"
              ],
              "properties": {
                "transition_index": {
                  "type": "integer",
                  "minimum": 1
                },
                "basis": {
                  "enum": [
                    "input_deviation",
                    "independent_addition",
                    "unknown_transition"
                  ]
                },
                "mechanism_source": {
                  "enum": [
                    "explicit_process",
                    "boundary_comparison"
                  ]
                },
                "reason": {
                  "type": "string",
                  "minLength": 1
                },
                "certainty": {
                  "enum": [
                    "confirmed",
                    "inferred"
                  ]
                },
                "uncertainty": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "evidence_gap",
                    "alternatives"
                  ],
                  "properties": {
                    "evidence_gap": {
                      "type": "string",
                      "minLength": 1
                    },
                    "alternatives": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "minLength": 1
                      },
                      "minItems": 1
                    }
                  }
                }
              }
            }
          },
          "uncertainty": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "evidence_gap",
              "alternatives"
            ],
            "properties": {
              "evidence_gap": {
                "type": "string",
                "minLength": 1
              },
              "alternatives": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "minItems": 1
              }
            }
          },
          "calculations": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "label",
                "operation",
                "operands",
                "result",
                "scale",
                "decimal_places",
                "result_unit",
                "result_period",
                "assumptions"
              ],
              "properties": {
                "label": {
                  "type": "string",
                  "minLength": 1
                },
                "operation": {
                  "enum": [
                    "ratio",
                    "relative_change",
                    "compound_growth",
                    "annualization",
                    "arithmetic"
                  ]
                },
                "operands": {
                  "type": "object",
                  "minProperties": 1,
                  "additionalProperties": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "value",
                      "evidence_index",
                      "unit",
                      "period",
                      "role"
                    ],
                    "properties": {
                      "value": {
                        "type": "string",
                        "minLength": 1
                      },
                      "evidence_index": {
                        "type": "integer",
                        "minimum": 1
                      },
                      "unit": {
                        "type": "string",
                        "minLength": 1
                      },
                      "period": {
                        "type": "string",
                        "minLength": 1
                      },
                      "role": {
                        "type": "string",
                        "minLength": 1
                      }
                    }
                  },
                  "description": "每项value为对应evidence中的完整原数token（可含千分位），unit/period/role明确原始单位、期间及业务角色。ratio仅numerator+denominator，区间比值仅numerator+denominator_lower+denominator_upper（分子非负、分母为有序正数、两端同单位同期间），denominator_role精确等于分母role；relative_change仅base+observed（同单位，期间可不同），公式(observed-base)/base，denominator_role=base.role；compound_growth必需rate+periods，可选base；rate.unit为ratio或%（%自动精确除100），periods.unit=periods且1—20整数（有界资源限制）；有base时结果=base*(1+每期增长率)^periods且与base同单位，无base计算增长倍数且result_unit=ratio，不需编造值为1的来源；非CAGR；annualization仅value，须有正factor、observation_period=value.period、target_period=result_period、result_basis=run_rate及非空assumptions，结果单位与value一致；arithmetic用自选合法变量名且每项均参与formula，display_scale为保留名。"
                },
                "result": {
                  "oneOf": [
                    {
                      "type": "string",
                      "minLength": 1
                    },
                    {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "lower",
                        "upper",
                        "include_lower",
                        "include_upper"
                      ],
                      "properties": {
                        "lower": {
                          "type": "string",
                          "minLength": 1
                        },
                        "upper": {
                          "type": "string",
                          "minLength": 1
                        },
                        "include_lower": {
                          "type": "boolean"
                        },
                        "include_upper": {
                          "type": "boolean"
                        }
                      }
                    }
                  ]
                },
                "scale": {
                  "enum": [
                    "1",
                    "100"
                  ],
                  "description": "结果显示倍率，仅1或100，不是容差。ratio/relative_change的scale=100当且仅当result_unit=%；其他运算也按此倍率乘在公式结果之后。"
                },
                "decimal_places": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 12,
                  "description": "结果小数位数0—12：对源数字的精确有理数运算结果一次性按四舍六入五成双舍入，提交result须与该精度相符。区间两端分别核算；不会自动改写模型提交的结果。"
                },
                "result_unit": {
                  "type": "string",
                  "minLength": 1
                },
                "result_period": {
                  "type": "string",
                  "minLength": 1
                },
                "assumptions": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "denominator_role": {
                  "type": "string",
                  "minLength": 1
                },
                "formula": {
                  "type": "string",
                  "minLength": 1,
                  "description": "仅arithmetic使用具名源数操作数、四则运算和括号。数学常数0/1可直接写；10的整数次幂可作单位换算倍率（如/1000或*1e-3），须用assumptions声明原/目标单位及换算依据。其他数值必须来自operands，不得通过常数绕过证据绑定；数学常量不证明被评模型执行过对应动作。"
                },
                "factor": {
                  "type": "string",
                  "minLength": 1
                },
                "observation_period": {
                  "type": "string",
                  "minLength": 1
                },
                "target_period": {
                  "type": "string",
                  "minLength": 1
                },
                "result_basis": {
                  "const": "run_rate"
                }
              }
            }
          }
        }
      }
    },
    "is_correct": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "correct_reason": {
      "type": "string",
      "minLength": 1
    }
  }
}
