{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "is_correct",
    "correctness_reason",
    "correctness_evidence",
    "task_analysis",
    "summary",
    "findings",
    "numeric_checks"
  ],
  "properties": {
    "is_correct": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "correctness_reason": {
      "type": "string"
    },
    "correctness_evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "evidence_id"
        ],
        "properties": {
          "evidence_id": {
            "type": "string",
            "minLength": 1
          },
          "observation": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "task_analysis": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "task_type",
        "goal",
        "requirements",
        "scoring_points",
        "red_flags"
      ],
      "properties": {
        "task_type": {
          "type": "string",
          "minLength": 1
        },
        "goal": {
          "type": "string",
          "minLength": 1
        },
        "requirements": {
          "type": "array",
          "minItems": 1,
          "maxItems": 6,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "scoring_points": {
          "type": "array",
          "maxItems": 6,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "red_flags": {
          "type": "array",
          "maxItems": 6,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "findings": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "type",
          "dimension",
          "stage",
          "importance",
          "text",
          "reason",
          "evidence",
          "assessment",
          "finding_id",
          "problem"
        ],
        "properties": {
          "type": {
            "enum": [
              "strength",
              "problem"
            ]
          },
          "dimension": {
            "enum": [
              "correctness",
              "completeness",
              "instruction_following",
              "evidence_quality",
              "reasoning",
              "format",
              "relevance",
              "efficiency"
            ]
          },
          "stage": {
            "enum": [
              "context_recall",
              "reasoning",
              "execution",
              "final_answer"
            ]
          },
          "importance": {
            "enum": [
              "high",
              "medium",
              "low"
            ]
          },
          "text": {
            "type": "string",
            "minLength": 1
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "evidence_id"
              ],
              "properties": {
                "evidence_id": {
                  "type": "string",
                  "minLength": 1
                },
                "observation": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          },
          "assessment": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "requirement_index",
              "observation",
              "evidence_status",
              "impact"
            ],
            "properties": {
              "requirement_index": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 0
              },
              "observation": {
                "type": "string",
                "minLength": 1
              },
              "evidence_status": {
                "enum": [
                  "established",
                  "uncertain"
                ]
              },
              "impact": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "finding_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "problem": {
            "type": [
              "object",
              "null"
            ],
            "additionalProperties": false,
            "required": [
              "component",
              "label",
              "definition"
            ],
            "properties": {
              "component": {
                "type": "array",
                "minItems": 0,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "description": "有证据支持的责任组件；使用确切工具名或模型自身推理，逐个在 definition 中说明责任；根因尚未定位时为空数组，在 definition 说明已知来源和待查原因。"
              },
              "label": {
                "type": "string",
                "minLength": 1
              },
              "definition": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    "numeric_checks": {
      "type": "array",
      "maxItems": 64,
      "description": "逐项核对标准答案的数值。所有同口径数值均列出，不能仅列错误项；无标准、未提供结果或非数值任务填空数组。明确区间/容差任务用 correctness_reason 单独说明。",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "label",
          "expected",
          "actual",
          "scale",
          "matches",
          "mode",
          "evidence_index"
        ],
        "properties": {
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "expected": {
            "type": "string",
            "pattern": "^[+-]?\\d+(?:\\.\\d+)?(?:[eE][+-]?\\d{1,3})?$",
            "maxLength": 80,
            "description": "标准中的原数值，保留小数位与科学计数法指数，不展开或改写精度"
          },
          "actual": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^[+-]?\\d+(?:\\.\\d+)?(?:[eE][+-]?\\d{1,3})?$",
            "maxLength": 80,
            "description": "最终回答原数值；确实未提供该项时为null，绝不能用0表示缺失"
          },
          "scale": {
            "type": "string",
            "pattern": "^[+-]?\\d+(?:\\.\\d+)?(?:[eE][+-]?\\d{1,3})?$",
            "maxLength": 80,
            "description": "回答单位转换到标准单位的正比例，同单位填1"
          },
          "matches": {
            "type": "boolean",
            "description": "actual*scale 按 expected 的末位精度四舍五入后是否相等，由程序复算"
          },
          "mode": {
            "enum": [
              "rounded",
              "exact"
            ],
            "description": "连续量按标准精度rounded；整数计数等离散结果用exact"
          },
          "evidence_index": {
            "type": "integer",
            "minimum": 0,
            "description": "包含actual的 correctness_evidence 条目的零起始索引，证据必须指向最终回答"
          }
        }
      }
    }
  }
}
