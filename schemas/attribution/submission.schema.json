{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "只提交本对象 properties 定义的判断字段，required 字段必须全部填写；candidate 是读取工具参数，禁止作为提交字段，也不附加 case_id、findings 等导出包装。",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "criterion_assessments": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "status": {
            "enum": [
              "met",
              "partial",
              "unmet",
              "unknown"
            ]
          },
          "evidence_status": {
            "enum": [
              "established",
              "uncertain"
            ]
          },
          "summary": {
            "type": "string",
            "minLength": 1
          },
          "evidence_indices": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "required": [
          "status",
          "evidence_status",
          "summary",
          "evidence_indices"
        ]
      },
      "minItems": 1,
      "maxItems": 24
    },
    "meets_core": {
      "type": [
        "boolean",
        "null"
      ],
      "description": "true 仅表示所选核心要求全部已确认实际完成（met）；核心 partial/unmet 不能判 true，影响核心的事实待核则为 null；非核心附属缺陷不自动否定完成。"
    },
    "core_reason": {
      "type": "string",
      "minLength": 1
    },
    "core_requirements": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "integer",
        "minimum": 1
      }
    },
    "numeric_checks": {
      "type": "array",
      "description": "记录有原文证据的直接点值及换算，程序仅计算算术比较；整体正确性在 correctness_reason 结合原题、计算与证据判断。",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "reference_index": {
            "type": "integer",
            "minimum": 1
          },
          "actual": {
            "type": [
              "string",
              "number",
              "null"
            ],
            "pattern": "^[+-]?\\d+(?:\\.\\d+)?(?:[eE][+-]?\\d{1,3})?$",
            "maxLength": 80
          },
          "scale": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[+-]?\\d+(?:\\.\\d+)?(?:[eE][+-]?\\d{1,3})?$",
            "maxLength": 80
          },
          "mode": {
            "description": "算术观察方式：rounded 按标准末位精度舍入，exact 精确比较；不代替语义正确性判断。",
            "enum": [
              "rounded",
              "exact"
            ]
          },
          "evidence_index": {
            "type": "integer",
            "minimum": 1
          }
        },
        "required": [
          "label",
          "reference_index",
          "actual",
          "scale",
          "mode",
          "evidence_index"
        ]
      },
      "maxItems": 64
    },
    "is_correct": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "correctness_reason": {
      "type": "string"
    },
    "correctness_evidence_indices": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 1
      }
    },
    "standard_conflict": {
      "type": "boolean",
      "description": "默认 false。初评有原始披露或完整底层复算直接反证时填 true 提请复核，无须当时已看到对方答案；独立复核仅在双方最终所求结果一致且直接反证成立时保留 true。"
    },
    "image_observations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "image_number": {
            "type": "integer",
            "minimum": 1
          },
          "text": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "image_number",
          "text"
        ]
      }
    },
    "table_resolutions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "table_index": {
            "type": "integer",
            "minimum": 1
          },
          "row_index": {
            "type": "integer",
            "minimum": 0
          },
          "outcome": {
            "enum": [
              "supported",
              "conflict"
            ]
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "evidence_indices": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 1
            },
            "minItems": 2
          }
        },
        "required": [
          "table_index",
          "row_index",
          "outcome",
          "reason",
          "evidence_indices"
        ]
      },
      "maxItems": 100
    },
    "strengths": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "dimension": {
            "enum": [
              "correctness",
              "completeness",
              "instruction_following",
              "evidence_quality",
              "reasoning",
              "format",
              "relevance",
              "efficiency"
            ]
          },
          "stage": {
            "enum": [
              "context_recall",
              "reasoning",
              "execution",
              "final_answer"
            ]
          },
          "importance": {
            "enum": [
              "high",
              "medium",
              "low"
            ]
          },
          "text": {
            "type": "string",
            "minLength": 1
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "evidence_status": {
            "enum": [
              "established",
              "uncertain"
            ]
          },
          "evidence_indices": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 1
            },
            "minItems": 1
          },
          "basis_index": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1
          }
        },
        "required": [
          "dimension",
          "stage",
          "importance",
          "text",
          "reason",
          "evidence_status",
          "evidence_indices",
          "basis_index"
        ]
      }
    },
    "problems": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "dimension": {
            "enum": [
              "correctness",
              "completeness",
              "instruction_following",
              "evidence_quality",
              "reasoning",
              "format",
              "relevance",
              "efficiency"
            ]
          },
          "stage": {
            "enum": [
              "context_recall",
              "reasoning",
              "execution",
              "final_answer"
            ]
          },
          "importance": {
            "enum": [
              "high",
              "medium",
              "low"
            ]
          },
          "text": {
            "type": "string",
            "minLength": 1
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "impact": {
            "type": "string",
            "minLength": 1
          },
          "evidence_status": {
            "enum": [
              "established",
              "uncertain"
            ]
          },
          "evidence_indices": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 1
            },
            "minItems": 1
          },
          "basis_index": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "component": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "actor_index",
                "function_index",
                "business_component",
                "chain_index",
                "step_index",
                "failure_stage_index",
                "field_names",
                "mechanism_source",
                "mechanism",
                "certainty",
                "evidence_indices"
              ],
              "properties": {
                "actor_index": {
                  "type": "integer",
                  "minimum": 1
                },
                "function_index": {
                  "type": "integer",
                  "minimum": 1
                },
                "business_component": {
                  "type": "string",
                  "minLength": 1
                },
                "chain_index": {
                  "type": [
                    "integer",
                    "null"
                  ],
                  "minimum": 1
                },
                "step_index": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 8
                },
                "failure_stage_index": {
                  "type": "integer",
                  "minimum": 1
                },
                "field_names": {
                  "type": "array",
                  "uniqueItems": true,
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "mechanism_source": {
                  "enum": [
                    "explicit_process",
                    "boundary_comparison"
                  ]
                },
                "mechanism": {
                  "description": "说明所选真实节点对哪个事实、字段、来源或计算，在什么处理动作上发生偏离及输入输出边界。模型推理问题、模型能力不足、模型推断与生成、模型理解错误或终稿有问题只说明标签/位置，不能作为原因；未知责任明确待查边界，隐藏机制保留推断、缺口及替代解释。",
                  "type": "string",
                  "minLength": 1
                },
                "certainty": {
                  "enum": [
                    "confirmed",
                    "inferred"
                  ]
                },
                "evidence_indices": {
                  "type": "array",
                  "uniqueItems": true,
                  "items": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "minItems": 1
                },
                "evidence_gap": {
                  "type": "string",
                  "minLength": 1
                },
                "alternatives": {
                  "type": "array",
                  "minItems": 1,
                  "uniqueItems": true,
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              },
              "allOf": [
                {
                  "if": {
                    "properties": {
                      "certainty": {
                        "const": "inferred"
                      }
                    },
                    "required": [
                      "certainty"
                    ]
                  },
                  "then": {
                    "required": [
                      "evidence_gap",
                      "alternatives"
                    ]
                  },
                  "else": {
                    "properties": {
                      "evidence_gap": false,
                      "alternatives": false
                    }
                  }
                }
              ]
            },
            "minItems": 1
          },
          "diagnosis": {
            "enum": [
              "entity_or_unit",
              "source_absence",
              "context_loss",
              "other"
            ]
          },
          "investigation_fact_indices": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "required": [
          "dimension",
          "stage",
          "importance",
          "text",
          "reason",
          "impact",
          "evidence_status",
          "evidence_indices",
          "basis_index",
          "label",
          "component",
          "diagnosis",
          "investigation_fact_indices"
        ]
      }
    },
    "investigation_facts": {
      "description": "只填写已核实且与问题有关的边界，不补八步空模板。每行必须完整提交 chain_index、step_index、field_names、observation、evidence_indices，禁止额外字段；相同事实可供多个问题引用。",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "chain_index",
          "step_index",
          "field_names",
          "observation",
          "evidence_indices"
        ],
        "properties": {
          "chain_index": {
            "type": "integer",
            "minimum": 1
          },
          "step_index": {
            "type": "integer",
            "minimum": 1,
            "maximum": 8
          },
          "field_names": {
            "description": "仅列本事实所选链路/环节的所引原文或路径中实际存在的字段；纯正文分析填 []，不能借用父对象未引用的字段或其他边界字段。",
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "observation": {
            "type": "string",
            "minLength": 1
          },
          "evidence_indices": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "integer",
              "minimum": 1
            },
            "minItems": 1
          }
        }
      }
    }
  },
  "required": [
    "summary",
    "criterion_assessments",
    "meets_core",
    "core_reason",
    "core_requirements",
    "numeric_checks",
    "strengths",
    "problems",
    "investigation_facts"
  ]
}
