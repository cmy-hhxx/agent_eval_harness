{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "只提交本对象 properties 定义的判断字段，required 字段必须全部填写；candidate 是读取工具参数，禁止作为提交字段，也不附加 case_id、findings 等导出包装。 所有点评字段使用简体中文，专有名词和证据原文保留原语言。",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "criterion_assessments": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "status": {
            "enum": [
              "met",
              "partial",
              "unmet",
              "unknown"
            ]
          },
          "evidence_status": {
            "enum": [
              "established",
              "uncertain"
            ]
          },
          "summary": {
            "type": "string",
            "minLength": 1
          },
          "evidence_indices": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "required": [
          "status",
          "evidence_status",
          "summary",
          "evidence_indices"
        ]
      },
      "minItems": 1,
      "maxItems": 24
    },
    "meets_core": {
      "type": [
        "boolean",
        "null"
      ],
      "description": "true 仅表示所选核心要求全部已确认实际完成（met）；核心 partial/unmet 不能判 true，影响核心的事实待核则为 null；非核心附属缺陷不自动否定完成。"
    },
    "core_reason": {
      "type": "string",
      "minLength": 1
    },
    "core_requirements": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "integer",
        "minimum": 1
      }
    },
    "numeric_checks": {
      "type": "array",
      "description": "记录有原文证据的直接点值及换算，程序仅计算算术比较；整体正确性在 correctness_reason 结合原题、计算与证据判断。",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "reference_index": {
            "type": "integer",
            "minimum": 1
          },
          "actual": {
            "type": [
              "string",
              "number",
              "null"
            ],
            "pattern": "^[+-]?\\d+(?:\\.\\d+)?(?:[eE][+-]?\\d{1,3})?$",
            "maxLength": 80
          },
          "scale": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[+-]?\\d+(?:\\.\\d+)?(?:[eE][+-]?\\d{1,3})?$",
            "maxLength": 80
          },
          "mode": {
            "description": "算术观察方式：rounded 按标准末位精度舍入，exact 精确比较；不代替语义正确性判断。",
            "enum": [
              "rounded",
              "exact"
            ]
          },
          "evidence_index": {
            "type": "integer",
            "minimum": 1
          }
        },
        "required": [
          "label",
          "reference_index",
          "actual",
          "scale",
          "mode",
          "evidence_index"
        ]
      },
      "maxItems": 64
    },
    "is_correct": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "correctness_reason": {
      "type": "string"
    },
    "correctness_evidence_indices": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 1
      }
    },
    "standard_conflict": {
      "type": "boolean",
      "description": "默认 false。初评有原始披露或完整底层复算直接反证时填 true 提请复核，无须当时已看到对方答案；独立复核仅在双方最终所求结果一致且直接反证成立时保留 true。"
    },
    "image_observations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "image_number": {
            "type": "integer",
            "minimum": 1
          },
          "text": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "image_number",
          "text"
        ]
      }
    },
    "table_resolutions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "table_index": {
            "type": "integer",
            "minimum": 1
          },
          "row_index": {
            "type": "integer",
            "minimum": 0
          },
          "outcome": {
            "enum": [
              "supported",
              "conflict"
            ]
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "evidence_indices": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 1
            },
            "minItems": 2
          }
        },
        "required": [
          "table_index",
          "row_index",
          "outcome",
          "reason",
          "evidence_indices"
        ]
      },
      "maxItems": 100
    },
    "strengths": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "dimension": {
            "enum": [
              "correctness",
              "completeness",
              "instruction_following",
              "evidence_quality",
              "reasoning",
              "format",
              "relevance",
              "efficiency"
            ]
          },
          "stage": {
            "enum": [
              "context_recall",
              "reasoning",
              "execution",
              "final_answer"
            ]
          },
          "importance": {
            "enum": [
              "high",
              "medium",
              "low"
            ]
          },
          "text": {
            "type": "string",
            "minLength": 1
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "evidence_status": {
            "enum": [
              "established",
              "uncertain"
            ]
          },
          "evidence_indices": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 1
            },
            "minItems": 1
          },
          "basis_index": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1
          }
        },
        "required": [
          "dimension",
          "stage",
          "importance",
          "text",
          "reason",
          "evidence_status",
          "evidence_indices",
          "basis_index"
        ]
      },
      "description": "优点仅提交本项 Schema 允许的字段，不允许 impact；impact 仅属于 problems。"
    },
    "problems": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "dimension": {
            "enum": [
              "correctness",
              "completeness",
              "instruction_following",
              "evidence_quality",
              "reasoning",
              "format",
              "relevance",
              "efficiency"
            ]
          },
          "stage": {
            "enum": [
              "context_recall",
              "reasoning",
              "execution",
              "final_answer"
            ]
          },
          "importance": {
            "enum": [
              "high",
              "medium",
              "low"
            ]
          },
          "text": {
            "type": "string",
            "minLength": 1
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "impact": {
            "type": "string",
            "minLength": 1
          },
          "evidence_status": {
            "enum": [
              "established",
              "uncertain"
            ]
          },
          "evidence_indices": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 1
            },
            "minItems": 1
          },
          "basis_index": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "diagnosis": {
            "enum": [
              "entity_or_unit",
              "source_absence",
              "context_loss",
              "other"
            ]
          },
          "causes": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "transition_index",
                "function_index",
                "business_component",
                "basis",
                "mechanism_source",
                "mechanism",
                "certainty"
              ],
              "properties": {
                "function_index": {
                  "type": "integer",
                  "minimum": 1
                },
                "business_component": {
                  "type": "string",
                  "minLength": 1
                },
                "mechanism_source": {
                  "enum": [
                    "explicit_process",
                    "boundary_comparison"
                  ]
                },
                "mechanism": {
                  "description": "说明所选真实节点对哪个事实、字段、来源或计算，在什么处理动作上发生偏离及输入输出边界。模型推理问题、模型能力不足、模型推断与生成、模型理解错误或终稿有问题只说明标签/位置，不能作为原因；未知责任明确待查边界，隐藏机制保留推断、缺口及替代解释。",
                  "type": "string",
                  "minLength": 1
                },
                "certainty": {
                  "enum": [
                    "confirmed",
                    "inferred"
                  ]
                },
                "evidence_gap": {
                  "type": "string",
                  "minLength": 1
                },
                "alternatives": {
                  "type": "array",
                  "minItems": 1,
                  "uniqueItems": true,
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "transition_index": {
                  "type": "integer",
                  "minimum": 1
                },
                "basis": {
                  "enum": [
                    "input_deviation",
                    "independent_addition",
                    "unknown_transition"
                  ]
                }
              },
              "allOf": [
                {
                  "if": {
                    "properties": {
                      "certainty": {
                        "const": "inferred"
                      }
                    },
                    "required": [
                      "certainty"
                    ]
                  },
                  "then": {
                    "required": [
                      "evidence_gap",
                      "alternatives"
                    ]
                  },
                  "else": {
                    "properties": {
                      "evidence_gap": false,
                      "alternatives": false
                    }
                  }
                }
              ]
            }
          },
          "checks": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "transition_index",
                "outcome",
                "observation",
                "before_evidence_indices",
                "after_evidence_indices"
              ],
              "properties": {
                "transition_index": {
                  "type": "integer",
                  "minimum": 1
                },
                "outcome": {
                  "enum": [
                    "preserved",
                    "changed",
                    "recovered",
                    "unresolved"
                  ]
                },
                "observation": {
                  "type": "string",
                  "minLength": 1
                },
                "before_evidence_indices": {
                  "type": "array",
                  "uniqueItems": true,
                  "items": {
                    "type": "integer",
                    "minimum": 1
                  }
                },
                "after_evidence_indices": {
                  "type": "array",
                  "uniqueItems": true,
                  "items": {
                    "type": "integer",
                    "minimum": 1
                  }
                }
              }
            }
          },
          "calculations": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "label",
                "operation",
                "operands",
                "result",
                "scale",
                "decimal_places",
                "result_unit",
                "result_period",
                "assumptions"
              ],
              "properties": {
                "label": {
                  "type": "string",
                  "minLength": 1
                },
                "operation": {
                  "enum": [
                    "ratio",
                    "relative_change",
                    "compound_growth",
                    "annualization",
                    "arithmetic"
                  ]
                },
                "operands": {
                  "type": "object",
                  "minProperties": 1,
                  "additionalProperties": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "value",
                      "evidence_index",
                      "unit",
                      "period",
                      "role"
                    ],
                    "properties": {
                      "value": {
                        "type": "string",
                        "minLength": 1
                      },
                      "evidence_index": {
                        "type": "integer",
                        "minimum": 1
                      },
                      "unit": {
                        "type": "string",
                        "minLength": 1
                      },
                      "period": {
                        "type": "string",
                        "minLength": 1
                      },
                      "role": {
                        "type": "string",
                        "minLength": 1
                      }
                    }
                  },
                  "description": "每项value为对应evidence中的完整原数token（可含千分位），unit/period/role明确原始单位、期间及业务角色。ratio仅numerator+denominator，区间比值仅numerator+denominator_lower+denominator_upper（分子非负、分母为有序正数、两端同单位同期间），denominator_role精确等于分母role；relative_change仅base+observed（同单位，期间可不同），公式(observed-base)/base，denominator_role=base.role；compound_growth必需rate+periods，可选base；rate.unit为ratio或%（%自动精确除100），periods.unit=periods且1—20整数（有界资源限制）；有base时结果=base*(1+每期增长率)^periods且与base同单位，无base计算增长倍数且result_unit=ratio，不需编造值为1的来源；非CAGR；annualization仅value，须有正factor、observation_period=value.period、target_period=result_period、result_basis=run_rate及非空assumptions，结果单位与value一致；arithmetic用自选合法变量名且每项均参与formula，display_scale为保留名。"
                },
                "result": {
                  "oneOf": [
                    {
                      "type": "string",
                      "minLength": 1
                    },
                    {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "lower",
                        "upper",
                        "include_lower",
                        "include_upper"
                      ],
                      "properties": {
                        "lower": {
                          "type": "string",
                          "minLength": 1
                        },
                        "upper": {
                          "type": "string",
                          "minLength": 1
                        },
                        "include_lower": {
                          "type": "boolean"
                        },
                        "include_upper": {
                          "type": "boolean"
                        }
                      }
                    }
                  ]
                },
                "scale": {
                  "enum": [
                    "1",
                    "100"
                  ],
                  "description": "结果显示倍率，仅1或100，不是容差。ratio/relative_change的scale=100当且仅当result_unit=%；其他运算也按此倍率乘在公式结果之后。"
                },
                "decimal_places": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 12,
                  "description": "结果小数位数0—12：对源数字的精确有理数运算结果一次性按四舍六入五成双舍入，提交result须与该精度相符。区间两端分别核算；不会自动改写模型提交的结果。"
                },
                "result_unit": {
                  "type": "string",
                  "minLength": 1
                },
                "result_period": {
                  "type": "string",
                  "minLength": 1
                },
                "assumptions": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "denominator_role": {
                  "type": "string",
                  "minLength": 1
                },
                "formula": {
                  "type": "string",
                  "minLength": 1,
                  "description": "仅arithmetic使用具名源数操作数、四则运算和括号。数学常数0/1可直接写；10的整数次幂可作单位换算倍率（如/1000或*1e-3），须用assumptions声明原/目标单位及换算依据。其他数值必须来自operands，不得通过常数绕过证据绑定；数学常量不证明被评模型执行过对应动作。"
                },
                "factor": {
                  "type": "string",
                  "minLength": 1
                },
                "observation_period": {
                  "type": "string",
                  "minLength": 1
                },
                "target_period": {
                  "type": "string",
                  "minLength": 1
                },
                "result_basis": {
                  "const": "run_rate"
                }
              }
            }
          }
        },
        "required": [
          "dimension",
          "stage",
          "importance",
          "text",
          "reason",
          "impact",
          "evidence_status",
          "evidence_indices",
          "basis_index",
          "label",
          "diagnosis",
          "checks",
          "causes",
          "calculations"
        ]
      }
    }
  },
  "required": [
    "summary",
    "criterion_assessments",
    "meets_core",
    "core_reason",
    "core_requirements",
    "numeric_checks",
    "strengths",
    "problems"
  ]
}
