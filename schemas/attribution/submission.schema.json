{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "criterion_assessments": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "status": {
            "enum": [
              "met",
              "partial",
              "unmet",
              "unknown"
            ]
          },
          "evidence_status": {
            "enum": [
              "established",
              "uncertain"
            ]
          },
          "summary": {
            "type": "string",
            "minLength": 1
          },
          "evidence_indices": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "required": [
          "status",
          "evidence_status",
          "summary",
          "evidence_indices"
        ]
      },
      "minItems": 1,
      "maxItems": 24
    },
    "meets_core": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "core_reason": {
      "type": "string",
      "minLength": 1
    },
    "core_requirements": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "integer",
        "minimum": 1
      }
    },
    "numeric_checks": {
      "type": "array",
      "description": "记录有原文证据的直接点值及换算，程序仅计算算术比较；整体正确性在 correctness_reason 结合原题、计算与证据判断。",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "reference_index": {
            "type": "integer",
            "minimum": 1
          },
          "actual": {
            "type": [
              "string",
              "number",
              "null"
            ],
            "pattern": "^[+-]?\\d+(?:\\.\\d+)?(?:[eE][+-]?\\d{1,3})?$",
            "maxLength": 80
          },
          "scale": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[+-]?\\d+(?:\\.\\d+)?(?:[eE][+-]?\\d{1,3})?$",
            "maxLength": 80
          },
          "mode": {
            "description": "算术观察方式：rounded 按标准末位精度舍入，exact 精确比较；不代替语义正确性判断。",
            "enum": [
              "rounded",
              "exact"
            ]
          },
          "evidence_index": {
            "type": "integer",
            "minimum": 1
          }
        },
        "required": [
          "label",
          "reference_index",
          "actual",
          "scale",
          "mode",
          "evidence_index"
        ]
      },
      "maxItems": 64
    },
    "is_correct": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "correctness_reason": {
      "type": "string"
    },
    "correctness_evidence_indices": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 1
      }
    },
    "standard_conflict": {
      "type": "boolean",
      "description": "默认 false。初评有原始披露或完整底层复算直接反证时填 true 提请复核，无须当时已看到对方答案；独立复核仅在双方最终所求结果一致且直接反证成立时保留 true。"
    },
    "image_observations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "image_number": {
            "type": "integer",
            "minimum": 1
          },
          "text": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "image_number",
          "text"
        ]
      }
    },
    "table_resolutions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "table_index": {
            "type": "integer",
            "minimum": 1
          },
          "row_index": {
            "type": "integer",
            "minimum": 0
          },
          "outcome": {
            "enum": [
              "supported",
              "conflict"
            ]
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "evidence_indices": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 1
            },
            "minItems": 2
          }
        },
        "required": [
          "table_index",
          "row_index",
          "outcome",
          "reason",
          "evidence_indices"
        ]
      },
      "maxItems": 100
    },
    "strengths": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "dimension": {
            "enum": [
              "correctness",
              "completeness",
              "instruction_following",
              "evidence_quality",
              "reasoning",
              "format",
              "relevance",
              "efficiency"
            ]
          },
          "stage": {
            "enum": [
              "context_recall",
              "reasoning",
              "execution",
              "final_answer"
            ]
          },
          "importance": {
            "enum": [
              "high",
              "medium",
              "low"
            ]
          },
          "text": {
            "type": "string",
            "minLength": 1
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "evidence_status": {
            "enum": [
              "established",
              "uncertain"
            ]
          },
          "evidence_indices": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 1
            },
            "minItems": 1
          },
          "basis_index": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1
          }
        },
        "required": [
          "dimension",
          "stage",
          "importance",
          "text",
          "reason",
          "evidence_status",
          "evidence_indices",
          "basis_index"
        ]
      }
    },
    "problems": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "dimension": {
            "enum": [
              "correctness",
              "completeness",
              "instruction_following",
              "evidence_quality",
              "reasoning",
              "format",
              "relevance",
              "efficiency"
            ]
          },
          "stage": {
            "enum": [
              "context_recall",
              "reasoning",
              "execution",
              "final_answer"
            ]
          },
          "importance": {
            "enum": [
              "high",
              "medium",
              "low"
            ]
          },
          "text": {
            "type": "string",
            "minLength": 1
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "impact": {
            "type": "string",
            "minLength": 1
          },
          "evidence_status": {
            "enum": [
              "established",
              "uncertain"
            ]
          },
          "evidence_indices": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 1
            },
            "minItems": 1
          },
          "basis_index": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "definition": {
            "type": "string",
            "minLength": 1
          },
          "component": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "technical_domain",
                "functional_component",
                "component",
                "failure_stage",
                "mechanism",
                "reason",
                "role",
                "certainty",
                "evidence_gap",
                "alternatives",
                "evidence_indices",
                "business_component",
                "chain_index",
                "chain_step",
                "field_names",
                "mechanism_source"
              ],
              "properties": {
                "technical_domain": {
                  "type": "string",
                  "minLength": 1
                },
                "functional_component": {
                  "type": "string",
                  "minLength": 1
                },
                "component": {
                  "type": "string",
                  "minLength": 1
                },
                "failure_stage": {
                  "type": "string",
                  "minLength": 1
                },
                "mechanism": {
                  "type": "string",
                  "minLength": 1
                },
                "reason": {
                  "type": "string",
                  "minLength": 1
                },
                "role": {
                  "enum": [
                    "primary",
                    "contributing"
                  ]
                },
                "certainty": {
                  "enum": [
                    "confirmed",
                    "inferred"
                  ]
                },
                "evidence_gap": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "minLength": 1
                },
                "alternatives": {
                  "type": "array",
                  "uniqueItems": true,
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "evidence_indices": {
                  "type": "array",
                  "minItems": 1,
                  "uniqueItems": true,
                  "items": {
                    "type": "integer",
                    "minimum": 1
                  }
                },
                "business_component": {
                  "type": "string",
                  "minLength": 1
                },
                "chain_index": {
                  "type": [
                    "integer",
                    "null"
                  ],
                  "minimum": 1
                },
                "chain_step": {
                  "enum": [
                    "用户目标",
                    "查询规划与标的选择",
                    "工具请求参数",
                    "原始返回及字段含义",
                    "返回整理与上下文传递",
                    "模型实际输入",
                    "数据解释与计算",
                    "核验与最终交付"
                  ]
                },
                "field_names": {
                  "type": "array",
                  "uniqueItems": true,
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "mechanism_source": {
                  "enum": [
                    "explicit_process",
                    "boundary_comparison"
                  ]
                }
              }
            },
            "minItems": 1
          },
          "diagnosis": {
            "enum": [
              "entity_or_unit",
              "source_absence",
              "context_loss",
              "other"
            ]
          },
          "investigation": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "chain_index",
                "steps"
              ],
              "properties": {
                "chain_index": {
                  "type": "integer",
                  "minimum": 1
                },
                "steps": {
                  "type": "array",
                  "minItems": 8,
                  "maxItems": 8,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "step",
                      "status",
                      "observation",
                      "evidence_indices"
                    ],
                    "properties": {
                      "step": {
                        "enum": [
                          "用户目标",
                          "查询规划与标的选择",
                          "工具请求参数",
                          "原始返回及字段含义",
                          "返回整理与上下文传递",
                          "模型实际输入",
                          "数据解释与计算",
                          "核验与最终交付"
                        ]
                      },
                      "status": {
                        "enum": [
                          "checked",
                          "not_collected"
                        ]
                      },
                      "observation": {
                        "type": "string",
                        "minLength": 1
                      },
                      "evidence_indices": {
                        "type": "array",
                        "uniqueItems": true,
                        "items": {
                          "type": "integer",
                          "minimum": 1
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "required": [
          "dimension",
          "stage",
          "importance",
          "text",
          "reason",
          "impact",
          "evidence_status",
          "evidence_indices",
          "basis_index",
          "label",
          "definition",
          "component",
          "diagnosis",
          "investigation"
        ]
      }
    }
  },
  "required": [
    "summary",
    "criterion_assessments",
    "meets_core",
    "core_reason",
    "core_requirements",
    "numeric_checks",
    "strengths",
    "problems",
    "is_correct",
    "correctness_reason",
    "correctness_evidence_indices"
  ]
}
