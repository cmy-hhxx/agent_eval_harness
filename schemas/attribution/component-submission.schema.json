{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "content",
    "evidence",
    "tool_error_reviews",
    "problems"
  ],
  "properties": {
    "content": {
      "type": "string",
      "minLength": 1,
      "maxLength": 600
    },
    "evidence": {
      "type": "array",
      "minItems": 0,
      "uniqueItems": true,
      "items": {
        "type": "integer",
        "minimum": 1
      }
    },
    "tool_error_reviews": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "tool_error_idx",
          "status",
          "content",
          "evidence"
        ],
        "properties": {
          "tool_error_idx": {
            "type": "integer",
            "minimum": 1
          },
          "status": {
            "enum": [
              "unresolved_impact",
              "recovered_impact",
              "recovered_no_impact",
              "no_delivery_impact",
              "uncertain"
            ]
          },
          "content": {
            "type": "string",
            "minLength": 1,
            "maxLength": 600
          },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "integer",
              "minimum": 1
            }
          }
        }
      }
    },
    "problems": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "actor_index",
          "label",
          "definition",
          "problem_phenomena",
          "reason",
          "severity",
          "severity_reason",
          "evidence",
          "tool_error_indices"
        ],
        "properties": {
          "actor_index": {
            "type": "integer",
            "minimum": 1
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "definition": {
            "type": "string",
            "minLength": 1
          },
          "problem_phenomena": {
            "type": "string",
            "minLength": 1
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "severity": {
            "enum": [
              "P0",
              "P1",
              "P2",
              "P3",
              "P4"
            ]
          },
          "severity_reason": {
            "type": "string",
            "minLength": 1
          },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "index",
                "reason"
              ],
              "properties": {
                "index": {
                  "type": "integer",
                  "minimum": 1
                },
                "reason": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          },
          "calculations": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "text"
              ],
              "properties": {
                "text": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          },
          "tool_error_indices": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "integer",
              "minimum": 1
            }
          }
        }
      }
    }
  }
}
