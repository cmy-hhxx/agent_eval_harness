{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "components",
    "content",
    "evidence",
    "tool_error_reviews",
    "problem"
  ],
  "properties": {
    "components": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "content": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1200
    },
    "evidence": {
      "type": "array",
      "minItems": 0,
      "uniqueItems": true,
      "items": {
        "type": "integer",
        "minimum": 1
      }
    },
    "tool_error_reviews": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "tool_error_idx",
          "status",
          "content",
          "evidence"
        ],
        "properties": {
          "tool_error_idx": {
            "type": "integer",
            "minimum": 1
          },
          "status": {
            "enum": [
              "unresolved_impact",
              "recovered_impact",
              "recovered_no_impact",
              "no_delivery_impact",
              "uncertain"
            ]
          },
          "content": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1200
          },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "integer",
              "minimum": 1
            }
          }
        }
      }
    },
    "problem": {
      "type": "array",
      "items": {
        "$ref": "problem.schema.json"
      }
    }
  }
}
