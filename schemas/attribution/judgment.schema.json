{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "summary",
    "findings",
    "numeric_checks",
    "criterion_assessments",
    "core_assessment"
  ],
  "properties": {
    "is_correct": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "correctness_reason": {
      "type": "string"
    },
    "correctness_evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "evidence_id"
        ],
        "properties": {
          "evidence_id": {
            "type": "string",
            "minLength": 1
          },
          "observation": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "standard_conflict": {
      "type": "boolean",
      "description": "默认 false。初评有原始披露或完整底层复算直接反证时填 true 提请复核，无须当时已看到对方答案；独立复核仅在双方最终所求结果一致且直接反证成立时保留 true。"
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "type",
          "dimension",
          "stage",
          "importance",
          "text",
          "reason",
          "evidence",
          "assessment"
        ],
        "properties": {
          "type": {
            "enum": [
              "strength",
              "problem"
            ]
          },
          "dimension": {
            "enum": [
              "correctness",
              "completeness",
              "instruction_following",
              "evidence_quality",
              "reasoning",
              "format",
              "relevance",
              "efficiency"
            ]
          },
          "stage": {
            "enum": [
              "context_recall",
              "reasoning",
              "execution",
              "final_answer"
            ]
          },
          "importance": {
            "enum": [
              "high",
              "medium",
              "low"
            ]
          },
          "text": {
            "type": "string",
            "minLength": 1
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "evidence_id"
              ],
              "properties": {
                "evidence_id": {
                  "type": "string",
                  "minLength": 1
                },
                "observation": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "minItems": 1
          },
          "assessment": {
            "type": "object",
            "description": "本条观察、确定性与影响；instruction_following 时只填 observation/evidence_status/impact，norm_index 放在 findings[i] 顶层，与 dimension 同级。其他维度可关联 requirement_index。",
            "additionalProperties": false,
            "required": [
              "observation",
              "evidence_status",
              "impact"
            ],
            "properties": {
              "requirement_index": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 0
              },
              "observation": {
                "type": "string",
                "minLength": 1
              },
              "evidence_status": {
                "enum": [
                  "established",
                  "uncertain"
                ]
              },
              "impact": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "problem": {
            "description": "仅 type=problem 时必填，描述责任组件与问题；type=strength 时禁止提交此字段。",
            "type": "object",
            "additionalProperties": false,
            "required": [
              "label",
              "definition",
              "component",
              "diagnosis",
              "investigation",
              "calculations"
            ],
            "properties": {
              "label": {
                "type": "string",
                "minLength": 1
              },
              "definition": {
                "type": "string",
                "minLength": 1
              },
              "component": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "technical_domain",
                    "functional_component",
                    "component",
                    "failure_stage",
                    "mechanism",
                    "reason",
                    "role",
                    "certainty",
                    "evidence_gap",
                    "alternatives",
                    "evidence_ids",
                    "business_component",
                    "chain_index",
                    "chain_step",
                    "field_names",
                    "mechanism_source",
                    "actor_index",
                    "transition_index",
                    "basis"
                  ],
                  "properties": {
                    "technical_domain": {
                      "type": "string",
                      "minLength": 1
                    },
                    "functional_component": {
                      "type": "string",
                      "minLength": 1
                    },
                    "component": {
                      "type": "string",
                      "minLength": 1
                    },
                    "failure_stage": {
                      "type": "string",
                      "minLength": 1
                    },
                    "mechanism": {
                      "type": "string",
                      "minLength": 1
                    },
                    "reason": {
                      "type": "string",
                      "minLength": 1
                    },
                    "role": {
                      "enum": [
                        "primary",
                        "contributing"
                      ]
                    },
                    "certainty": {
                      "enum": [
                        "confirmed",
                        "inferred"
                      ]
                    },
                    "evidence_gap": {
                      "type": [
                        "string",
                        "null"
                      ],
                      "minLength": 1
                    },
                    "alternatives": {
                      "type": "array",
                      "uniqueItems": true,
                      "items": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "evidence_ids": {
                      "type": "array",
                      "minItems": 1,
                      "uniqueItems": true,
                      "items": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "business_component": {
                      "type": "string",
                      "minLength": 1
                    },
                    "chain_index": {
                      "type": [
                        "integer",
                        "null"
                      ],
                      "minimum": 1
                    },
                    "chain_step": {
                      "enum": [
                        "用户目标",
                        "查询规划与标的选择",
                        "工具请求参数",
                        "原始返回及字段含义",
                        "返回整理与上下文传递",
                        "模型实际输入",
                        "数据解释与计算",
                        "核验与最终交付"
                      ]
                    },
                    "field_names": {
                      "type": "array",
                      "uniqueItems": true,
                      "items": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "mechanism_source": {
                      "enum": [
                        "explicit_process",
                        "boundary_comparison"
                      ]
                    },
                    "actor_index": {
                      "type": [
                        "integer",
                        "null"
                      ],
                      "minimum": 1
                    },
                    "transition_index": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "basis": {
                      "enum": [
                        "input_deviation",
                        "independent_addition",
                        "unknown_transition"
                      ]
                    }
                  }
                },
                "minItems": 1
              },
              "diagnosis": {
                "enum": [
                  "entity_or_unit",
                  "source_absence",
                  "context_loss",
                  "other"
                ]
              },
              "investigation": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "transition_index",
                    "kind",
                    "outcome",
                    "observation",
                    "before_evidence_ids",
                    "after_evidence_ids"
                  ],
                  "properties": {
                    "transition_index": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "kind": {
                      "enum": [
                        "request_formation",
                        "execution",
                        "transfer",
                        "generation",
                        "delivery"
                      ]
                    },
                    "outcome": {
                      "enum": [
                        "preserved",
                        "changed",
                        "recovered",
                        "unresolved"
                      ]
                    },
                    "observation": {
                      "type": "string",
                      "minLength": 1
                    },
                    "before_evidence_ids": {
                      "type": "array",
                      "uniqueItems": true,
                      "items": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "after_evidence_ids": {
                      "type": "array",
                      "uniqueItems": true,
                      "items": {
                        "type": "string",
                        "minLength": 1
                      }
                    }
                  }
                }
              },
              "calculations": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "label",
                    "operation",
                    "operands",
                    "result",
                    "scale",
                    "decimal_places",
                    "result_unit",
                    "result_period",
                    "assumptions"
                  ],
                  "properties": {
                    "label": {
                      "type": "string",
                      "minLength": 1
                    },
                    "operation": {
                      "enum": [
                        "ratio",
                        "relative_change",
                        "compound_growth",
                        "annualization",
                        "arithmetic"
                      ]
                    },
                    "operands": {
                      "type": "object",
                      "minProperties": 1,
                      "additionalProperties": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                          "value",
                          "evidence_id",
                          "unit",
                          "period",
                          "role"
                        ],
                        "properties": {
                          "value": {
                            "type": "string",
                            "minLength": 1
                          },
                          "evidence_id": {
                            "type": "string",
                            "minLength": 1
                          },
                          "unit": {
                            "type": "string",
                            "minLength": 1
                          },
                          "period": {
                            "type": "string",
                            "minLength": 1
                          },
                          "role": {
                            "type": "string",
                            "minLength": 1
                          }
                        }
                      },
                      "description": "每项value为对应evidence中的完整原数token（可含千分位），unit/period/role明确原始单位、期间及业务角色。ratio仅numerator+denominator，区间比值仅numerator+denominator_lower+denominator_upper（分子非负、分母为有序正数、两端同单位同期间），denominator_role精确等于分母role；relative_change仅base+observed（同单位，期间可不同），公式(observed-base)/base，denominator_role=base.role；compound_growth必需rate+periods，可选base；rate.unit为ratio或%（%自动精确除100），periods.unit=periods且1—20整数（有界资源限制）；有base时结果=base*(1+每期增长率)^periods且与base同单位，无base计算增长倍数且result_unit=ratio，不需编造值为1的来源；非CAGR；annualization仅value，须有正factor、observation_period=value.period、target_period=result_period、result_basis=run_rate及非空assumptions，结果单位与value一致；arithmetic用自选合法变量名且每项均参与formula，display_scale为保留名。"
                    },
                    "result": {
                      "oneOf": [
                        {
                          "type": "string",
                          "minLength": 1
                        },
                        {
                          "type": "object",
                          "additionalProperties": false,
                          "required": [
                            "lower",
                            "upper",
                            "include_lower",
                            "include_upper"
                          ],
                          "properties": {
                            "lower": {
                              "type": "string",
                              "minLength": 1
                            },
                            "upper": {
                              "type": "string",
                              "minLength": 1
                            },
                            "include_lower": {
                              "type": "boolean"
                            },
                            "include_upper": {
                              "type": "boolean"
                            }
                          }
                        }
                      ]
                    },
                    "scale": {
                      "enum": [
                        "1",
                        "100"
                      ],
                      "description": "结果显示倍率，仅1或100，不是容差。ratio/relative_change的scale=100当且仅当result_unit=%；其他运算也按此倍率乘在公式结果之后。"
                    },
                    "decimal_places": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 12,
                      "description": "结果小数位数0—12：对源数字的精确有理数运算结果一次性按四舍六入五成双舍入，提交result须与该精度相符。区间两端分别核算；不会自动改写模型提交的结果。"
                    },
                    "result_unit": {
                      "type": "string",
                      "minLength": 1
                    },
                    "result_period": {
                      "type": "string",
                      "minLength": 1
                    },
                    "assumptions": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "denominator_role": {
                      "type": "string",
                      "minLength": 1
                    },
                    "formula": {
                      "type": "string",
                      "minLength": 1,
                      "description": "仅arithmetic使用具名源数操作数、四则运算和括号。数学常数0/1可直接写；10的整数次幂可作单位换算倍率（如/1000或*1e-3），须用assumptions声明原/目标单位及换算依据。其他数值必须来自operands，不得通过常数绕过证据绑定；数学常量不证明被评模型执行过对应动作。"
                    },
                    "factor": {
                      "type": "string",
                      "minLength": 1
                    },
                    "observation_period": {
                      "type": "string",
                      "minLength": 1
                    },
                    "target_period": {
                      "type": "string",
                      "minLength": 1
                    },
                    "result_basis": {
                      "const": "run_rate"
                    }
                  }
                }
              }
            }
          },
          "norm_index": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0,
            "description": "仅 instruction_following 必填 findings[i].norm_index，与 dimension 同级，不放进 assessment。选择 answer.norm_directory 的原 norm_index；没有合适目录关联时用 null，确定性按实际证据填写，不另填 assessment.requirement_index。"
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "type": {
                  "const": "problem"
                }
              },
              "required": [
                "type"
              ]
            },
            "then": {
              "required": [
                "problem"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "type": {
                  "const": "strength"
                }
              },
              "required": [
                "type"
              ]
            },
            "then": {
              "properties": {
                "problem": false
              }
            }
          },
          {
            "if": {
              "properties": {
                "dimension": {
                  "const": "instruction_following"
                }
              },
              "required": [
                "dimension"
              ]
            },
            "then": {
              "required": [
                "norm_index"
              ],
              "properties": {
                "assessment": {
                  "properties": {
                    "requirement_index": false
                  }
                }
              }
            }
          }
        ]
      }
    },
    "numeric_checks": {
      "type": "array",
      "maxItems": 64,
      "description": "记录 numeric_references 中可直接比较的同口径点值；选择原零起始 reference_index，不提交 expected 或 matches。程序计算的 matches 仅为算术观察，不决定整体正确性。显式容差、区间、上下限及须计算或解码的表达在 correctness_reason 按原规则核验，该目标不入表。目录为空或没有直接点值目标时填空数组；最终回答已直接给出的计算结果可按原值入表。",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "label",
          "actual",
          "scale",
          "mode",
          "evidence_index",
          "reference_index"
        ],
        "properties": {
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "actual": {
            "type": [
              "string",
              "number",
              "null"
            ],
            "pattern": "^[+-]?\\d+(?:\\.\\d+)?(?:[eE][+-]?\\d{1,3})?$",
            "maxLength": 80,
            "description": "最终回答原数值；确实未提供该项时为null，绝不能用0表示缺失"
          },
          "scale": {
            "type": "string",
            "pattern": "^[+-]?\\d+(?:\\.\\d+)?(?:[eE][+-]?\\d{1,3})?$",
            "maxLength": 80,
            "description": "有证据依据的回答单位到标准单位的正倍率，同单位填1；不能为使数值相等而选择倍率"
          },
          "mode": {
            "enum": [
              "rounded",
              "exact"
            ],
            "description": "算术观察方式：rounded 按标准末位精度舍入，exact 精确比较，离散计数用exact；精度差异的语义结论由 correctness_reason 说明，容差、区间和上下限不使用此表"
          },
          "evidence_index": {
            "type": "integer",
            "minimum": 0,
            "description": "correctness_evidence 数组中的零起始位置，不是 reference.evidence_index；actual 非 null 时选包含原值的本方最终回答证据，actual=null 时选覆盖待核缺失范围的本方最终回答证据"
          },
          "reference_index": {
            "type": "integer",
            "minimum": 0,
            "description": "numeric_references 中所核对标准数值的零起始 reference_index，须与实际值口径相同"
          }
        }
      }
    },
    "criterion_assessments": {
      "type": "array",
      "description": "对 task_analysis 中本方适用的每条 requirements、scoring_points 和 red_flags 各提交一项；不提交他方条款或 not_applicable。",
      "minItems": 1,
      "maxItems": 24,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "criterion_id",
          "status",
          "evidence_status",
          "summary",
          "evidence"
        ],
        "properties": {
          "criterion_id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]{0,31}$"
          },
          "status": {
            "enum": [
              "met",
              "partial",
              "unmet",
              "unknown"
            ]
          },
          "evidence_status": {
            "enum": [
              "established",
              "uncertain"
            ]
          },
          "summary": {
            "type": "string",
            "minLength": 1
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "evidence_id"
              ],
              "properties": {
                "evidence_id": {
                  "type": "string",
                  "minLength": 1
                },
                "observation": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          },
          "uncertainty": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "claim": {
                "type": "string",
                "minLength": 1,
                "description": "从本项所选本方最终交付证据逐字引用的完整待核主张；允许保留原文语言。"
              },
              "missing_evidence": {
                "type": "string",
                "minLength": 1,
                "description": "说明判定此主张仍缺的具体证据；可读材料须实际定向核查，不得把未读称为未采集。"
              },
              "impact": {
                "type": "string",
                "minLength": 1,
                "description": "该缺口如何影响本项要求和实际交付的判断。"
              }
            },
            "required": [
              "claim",
              "missing_evidence",
              "impact"
            ],
            "description": "unknown 或 uncertain 必填；确定项不得填。claim 必须绑定本项实际交付证据。"
          }
        }
      }
    },
    "core_assessment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "meets_core",
        "reason",
        "requirement_indices"
      ],
      "properties": {
        "meets_core": {
          "type": [
            "boolean",
            "null"
          ],
          "description": "true 仅表示所选核心要求全部已确认实际完成（met）；核心 partial/unmet 不能判 true，影响核心的事实待核则为 null；非核心附属缺陷不自动否定完成。"
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "requirement_indices": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "table_resolutions": {
      "type": "array",
      "maxItems": 100,
      "description": "An evidence-backed judgment of an unresolved table row.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "table_index",
          "row_index",
          "outcome",
          "reason",
          "evidence"
        ],
        "properties": {
          "table_index": {
            "type": "integer",
            "minimum": 1
          },
          "row_index": {
            "type": "integer",
            "minimum": 0
          },
          "outcome": {
            "enum": [
              "supported",
              "conflict"
            ]
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "evidence": {
            "type": "array",
            "minItems": 2,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "evidence_id"
              ],
              "properties": {
                "evidence_id": {
                  "type": "string",
                  "minLength": 1
                },
                "observation": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        }
      }
    }
  }
}
