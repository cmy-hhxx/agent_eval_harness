{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "summary",
    "findings",
    "numeric_checks",
    "criterion_assessments",
    "core_assessment"
  ],
  "properties": {
    "is_correct": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "correctness_reason": {
      "type": "string"
    },
    "correctness_evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "evidence_id"
        ],
        "properties": {
          "evidence_id": {
            "type": "string",
            "minLength": 1
          },
          "observation": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "standard_conflict": {
      "type": "boolean",
      "description": "默认 false。初评有原始披露或完整底层复算直接反证时填 true 提请复核，无须当时已看到对方答案；独立复核仅在双方最终所求结果一致且直接反证成立时保留 true。"
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "type",
          "dimension",
          "stage",
          "importance",
          "text",
          "reason",
          "evidence",
          "assessment"
        ],
        "properties": {
          "type": {
            "enum": [
              "strength",
              "problem"
            ]
          },
          "dimension": {
            "enum": [
              "correctness",
              "completeness",
              "instruction_following",
              "evidence_quality",
              "reasoning",
              "format",
              "relevance",
              "efficiency"
            ]
          },
          "stage": {
            "enum": [
              "context_recall",
              "reasoning",
              "execution",
              "final_answer"
            ]
          },
          "importance": {
            "enum": [
              "high",
              "medium",
              "low"
            ]
          },
          "text": {
            "type": "string",
            "minLength": 1
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "evidence_id"
              ],
              "properties": {
                "evidence_id": {
                  "type": "string",
                  "minLength": 1
                },
                "observation": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "minItems": 1
          },
          "assessment": {
            "type": "object",
            "description": "本条观察、确定性与影响；instruction_following 时只填 observation/evidence_status/impact，norm_index 放在 findings[i] 顶层，与 dimension 同级。其他维度可关联 requirement_index。",
            "additionalProperties": false,
            "required": [
              "observation",
              "evidence_status",
              "impact"
            ],
            "properties": {
              "requirement_index": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 0
              },
              "observation": {
                "type": "string",
                "minLength": 1
              },
              "evidence_status": {
                "enum": [
                  "established",
                  "uncertain"
                ]
              },
              "impact": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "problem": {
            "description": "仅 type=problem 时必填，描述责任组件与问题；type=strength 时禁止提交此字段。",
            "type": "object",
            "additionalProperties": false,
            "required": [
              "label",
              "definition",
              "component"
            ],
            "properties": {
              "label": {
                "type": "string",
                "minLength": 1
              },
              "definition": {
                "type": "string",
                "minLength": 1
              },
              "component": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "description": "选择本方材料支持的实际出错环节或真实工具名。回答呈现与采集、执行环境与权限配置须同时引用本方实际过程及相关最终交付；规范、参考材料或纯最终回答不能代替过程。引用正确来源不等于给来源记责；未定位填 []。"
              }
            }
          },
          "norm_index": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0,
            "description": "仅 instruction_following 必填 findings[i].norm_index，与 dimension 同级，不放进 assessment。选择 answer.norm_directory 的原 norm_index；没有合适目录关联时用 null，确定性按实际证据填写，不另填 assessment.requirement_index。"
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "type": {
                  "const": "problem"
                }
              },
              "required": [
                "type"
              ]
            },
            "then": {
              "required": [
                "problem"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "type": {
                  "const": "strength"
                }
              },
              "required": [
                "type"
              ]
            },
            "then": {
              "properties": {
                "problem": false
              }
            }
          },
          {
            "if": {
              "properties": {
                "dimension": {
                  "const": "instruction_following"
                }
              },
              "required": [
                "dimension"
              ]
            },
            "then": {
              "required": [
                "norm_index"
              ],
              "properties": {
                "assessment": {
                  "properties": {
                    "requirement_index": false
                  }
                }
              }
            }
          }
        ]
      }
    },
    "numeric_checks": {
      "type": "array",
      "maxItems": 64,
      "description": "记录 numeric_references 中可直接比较的同口径点值；选择原零起始 reference_index，不提交 expected 或 matches。程序计算的 matches 仅为算术观察，不决定整体正确性。显式容差、区间、上下限及须计算或解码的表达在 correctness_reason 按原规则核验，该目标不入表。目录为空或没有直接点值目标时填空数组；最终回答已直接给出的计算结果可按原值入表。",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "label",
          "actual",
          "scale",
          "mode",
          "evidence_index",
          "reference_index"
        ],
        "properties": {
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "actual": {
            "type": [
              "string",
              "number",
              "null"
            ],
            "pattern": "^[+-]?\\d+(?:\\.\\d+)?(?:[eE][+-]?\\d{1,3})?$",
            "maxLength": 80,
            "description": "最终回答原数值；确实未提供该项时为null，绝不能用0表示缺失"
          },
          "scale": {
            "type": "string",
            "pattern": "^[+-]?\\d+(?:\\.\\d+)?(?:[eE][+-]?\\d{1,3})?$",
            "maxLength": 80,
            "description": "有证据依据的回答单位到标准单位的正倍率，同单位填1；不能为使数值相等而选择倍率"
          },
          "mode": {
            "enum": [
              "rounded",
              "exact"
            ],
            "description": "算术观察方式：rounded 按标准末位精度舍入，exact 精确比较，离散计数用exact；精度差异的语义结论由 correctness_reason 说明，容差、区间和上下限不使用此表"
          },
          "evidence_index": {
            "type": "integer",
            "minimum": 0,
            "description": "correctness_evidence 数组中的零起始位置，不是 reference.evidence_index；actual 非 null 时选包含原值的本方最终回答证据，actual=null 时选覆盖待核缺失范围的本方最终回答证据"
          },
          "reference_index": {
            "type": "integer",
            "minimum": 0,
            "description": "numeric_references 中所核对标准数值的零起始 reference_index，须与实际值口径相同"
          }
        }
      }
    },
    "criterion_assessments": {
      "type": "array",
      "description": "对 task_analysis 中本方适用的每条 requirements、scoring_points 和 red_flags 各提交一项；不提交他方条款或 not_applicable。",
      "minItems": 1,
      "maxItems": 24,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "criterion_id",
          "status",
          "evidence_status",
          "summary",
          "evidence"
        ],
        "properties": {
          "criterion_id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]{0,31}$"
          },
          "status": {
            "enum": [
              "met",
              "partial",
              "unmet",
              "unknown"
            ]
          },
          "evidence_status": {
            "enum": [
              "established",
              "uncertain"
            ]
          },
          "summary": {
            "type": "string",
            "minLength": 1
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "evidence_id"
              ],
              "properties": {
                "evidence_id": {
                  "type": "string",
                  "minLength": 1
                },
                "observation": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        }
      }
    },
    "core_assessment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "meets_core",
        "reason",
        "requirement_indices"
      ],
      "properties": {
        "meets_core": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "requirement_indices": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "table_resolutions": {
      "type": "array",
      "maxItems": 100,
      "description": "An evidence-backed judgment of an unresolved table row.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "table_index",
          "row_index",
          "outcome",
          "reason",
          "evidence"
        ],
        "properties": {
          "table_index": {
            "type": "integer",
            "minimum": 1
          },
          "row_index": {
            "type": "integer",
            "minimum": 0
          },
          "outcome": {
            "enum": [
              "supported",
              "conflict"
            ]
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "evidence": {
            "type": "array",
            "minItems": 2,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "evidence_id"
              ],
              "properties": {
                "evidence_id": {
                  "type": "string",
                  "minLength": 1
                },
                "observation": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        }
      }
    }
  }
}
