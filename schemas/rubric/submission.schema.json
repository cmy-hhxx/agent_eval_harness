{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "case_id",
    "verdicts"
  ],
  "properties": {
    "case_id": {
      "type": "string",
      "minLength": 1
    },
    "verdicts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "item_index",
          "state",
          "reason",
          "evidence"
        ],
        "properties": {
          "item_index": {
            "type": "integer",
            "minimum": 1
          },
          "state": {
            "enum": [
              "pass",
              "partial",
              "fail",
              "na"
            ]
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "na_reason": {
            "type": "string",
            "minLength": 1
          },
          "evidence": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "integer",
              "minimum": 1
            }
          }
        }
      }
    }
  }
}
