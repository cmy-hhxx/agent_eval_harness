{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "case_id",
    "batch_id",
    "version",
    "counts",
    "traces"
  ],
  "properties": {
    "case_id": {
      "type": "string",
      "minLength": 1
    },
    "batch_id": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pass",
        "partial",
        "fail",
        "na"
      ],
      "properties": {
        "pass": {
          "type": "integer",
          "minimum": 0
        },
        "partial": {
          "type": "integer",
          "minimum": 0
        },
        "fail": {
          "type": "integer",
          "minimum": 0
        },
        "na": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "traces": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "additionalProperties": false,
        "required": [
          "case_id",
          "trace_index",
          "batch_id",
          "version",
          "category_id",
          "category_name",
          "checklist_size",
          "counts",
          "verdicts",
          "l1_id",
          "l1_name"
        ],
        "properties": {
          "case_id": {
            "type": "string",
            "minLength": 1
          },
          "trace_index": {
            "type": "integer",
            "minimum": 0
          },
          "batch_id": {
            "type": "string",
            "minLength": 1
          },
          "version": {
            "type": "string",
            "minLength": 1
          },
          "category_id": {
            "type": "string",
            "pattern": "^FIN-L2-[0-9]{3}$"
          },
          "category_name": {
            "type": "string",
            "minLength": 1
          },
          "checklist_size": {
            "type": "integer",
            "minimum": 1
          },
          "counts": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "pass",
              "partial",
              "fail",
              "na"
            ],
            "properties": {
              "pass": {
                "type": "integer",
                "minimum": 0
              },
              "partial": {
                "type": "integer",
                "minimum": 0
              },
              "fail": {
                "type": "integer",
                "minimum": 0
              },
              "na": {
                "type": "integer",
                "minimum": 0
              }
            }
          },
          "verdicts": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "item_index",
                "item_id",
                "source",
                "state",
                "reason",
                "evidence"
              ],
              "properties": {
                "item_index": {
                  "type": "integer",
                  "minimum": 1
                },
                "item_id": {
                  "type": "string",
                  "minLength": 1
                },
                "source": {
                  "enum": [
                    "generic",
                    "category"
                  ]
                },
                "kind": {
                  "enum": [
                    "gate",
                    "quality"
                  ]
                },
                "state": {
                  "enum": [
                    "pass",
                    "partial",
                    "fail",
                    "na"
                  ]
                },
                "reason": {
                  "type": "string",
                  "minLength": 1
                },
                "na_reason": {
                  "type": "string",
                  "minLength": 1
                },
                "evidence": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "evidence_id",
                      "message_index",
                      "quote"
                    ],
                    "properties": {
                      "evidence_id": {
                        "type": "string",
                        "minLength": 1
                      },
                      "message_index": {
                        "type": "integer",
                        "minimum": 0
                      },
                      "quote": {
                        "type": "string",
                        "minLength": 1
                      }
                    }
                  }
                }
              }
            }
          },
          "l1_id": {
            "type": "string",
            "pattern": "^FIN-L1-[0-9]{2}$"
          },
          "l1_name": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
