{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["task_type", "goal", "requirements", "scoring_points", "red_flags"],
  "properties": {
    "task_type": { "type": "string", "minLength": 1 },
    "goal": { "type": "string", "minLength": 1 },
    "requirements": { "type": "array", "minItems": 1, "maxItems": 24, "items": { "$ref": "#/$defs/criterion" } },
    "scoring_points": { "type": "array", "maxItems": 24, "items": { "$ref": "#/$defs/criterion" } },
    "red_flags": { "type": "array", "maxItems": 24, "items": { "$ref": "#/$defs/criterion" } }
  },
  "$defs": {
    "criterion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "text", "applies_to", "acceptance_rule"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9_-]{0,31}$" },
        "text": { "type": "string", "minLength": 1 },
        "applies_to": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
          }
        },
        "acceptance_rule": { "type": "string", "minLength": 1 }
      }
    }
  }
}
