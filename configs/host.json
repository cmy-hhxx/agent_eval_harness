{
  "evaluatorVersion": "r6",
  "inputs": {
    "timing_unit": "ms",
    "versions": [
      {
        "id": "a_fast",
        "name": "A Fast",
        "display_name": "A组Fast",
        "adapter": "a",
        "sources": [
          { "kind": "directory", "path": "../data/sources/model-answers/a_fast" }
        ]
      },
      {
        "id": "a_expert",
        "name": "A Expert",
        "display_name": "A组Expert",
        "adapter": "a",
        "sources": [
          { "kind": "directory", "path": "../data/sources/model-answers/a_expert" }
        ]
      },
      {
        "id": "aa_fast",
        "name": "AA Fast",
        "display_name": "AA组Fast",
        "adapter": "aa",
        "sources": [
          { "kind": "directory", "path": "../data/sources/model-answers/aa_fast" }
        ]
      },
      {
        "id": "aa_expert",
        "name": "AA Expert",
        "display_name": "AA组Expert",
        "adapter": "aa",
        "sources": [
          { "kind": "directory", "path": "../data/sources/model-answers/aa_expert" }
        ]
      }
    ]
  },
  "comparisons": [
    ["a_fast", "a_expert", "aa_fast", "aa_expert"]
  ],
  "rewrite": {
    "comparison": true,
    "attribution": true
  },
  "clustering": {
    "enabled": true,
    "maxClassesPerModel": 80,
    "maxNewClassesPerTask": 8,
    "maxComponentsPerModel": 12,
    "maxNewComponentsPerTask": 1,
    "consolidateAt": 60,
    "minSupport": 1,
    "maxCasesPerTask": 100
  },
  "models": {
    "judge": {
      "provider": "evaluation-gateway",
      "baseUrlEnv": "EVAL_BASE_URL",
      "api": "openai-completions",
      "apiKeyEnv": "EVAL_API_KEY",
      "thinking": "low",
      "contextWindow": 524288,
      "maxOutputTokens": 8192
    }
  },
  "bindings": {
    "attribution": {
      "profile": "judge",
      "maxOutputTokens": 4096
    },
    "comparison": {
      "profile": "judge"
    },
    "rewrite": {
      "profile": "judge"
    },
    "clustering": {
      "profile": "judge"
    }
  },
  "execution": {
    "concurrency": 4,
    "timeoutSeconds": 900,
    "idleTimeoutSeconds": 600,
    "maxToolCalls": 12,
    "repairAttempts": 2,
    "retries": 1,
    "retryDelaySeconds": 10,
    "codeTimeoutSeconds": 60,
    "maxOutputChars": 16000,
    "initialContextChars": 16000
  },
  "output": { "kind": "directory", "path": "../data/runs/comparison" },
  "problemLibrary": { "kind": "directory", "path": "../data/problems" }
}
