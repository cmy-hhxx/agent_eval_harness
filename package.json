{
  "name": "dual-agent-eval",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.14.1",
    "npm": "11.11.0"
  },
  "packageManager": "npm@11.11.0",
  "workspaces": [
    "apps/*",
    "packages/*",
    "agent"
  ],
  "imports": {
    "#pi-sdk": "./vendor/pi/packages/coding-agent/dist/index.js"
  },
  "scripts": {
    "bootstrap": "node scripts/bootstrap.mjs",
    "build": "node scripts/build.mjs",
    "build:app": "node scripts/build-app.mjs",
    "build:test": "node scripts/build-test.mjs",
    "typecheck": "tsc --noEmit",
    "doctor": "node scripts/doctor.mjs",
    "eval": "node dist/apps/host/src/cli.js",
    "attribution:check-language": "node dist/apps/host/src/attribution-language-check.js",
    "automations": "node dist/apps/host/src/automations.js",
    "workbench": "bash workbench.sh",
    "workbench:init": "node scripts/workbench-init.mjs",
    "workbench:configure-daily": "node scripts/configure-daily-workbench.mjs",
    "deploy:workbench": "node scripts/deploy-workbench.mjs",
    "report:relay": "node dist/apps/host/src/report-relay.js",
    "benchmark": "node scripts/benchmark.mjs",
    "test": "npm run build:test && node scripts/test.mjs --fast",
    "test:full": "npm run build:app && node scripts/test.mjs --full",
    "test:integration": "npm run build:app && node --test --test-concurrency=2 dist/tests/integration/*.test.js",
    "build:pi": "node scripts/build.mjs pi",
    "worker": "node dist/apps/worker/src/cli.js",
    "build:agent": "node scripts/build-agent.mjs",
    "agent": "node dist/apps/host/src/agent.js",
    "test:agent:upstream": "node scripts/apply-agent-dependency-patches.mjs && vitest run --config agent/vitest.config.mjs",
    "test:agent:browser": "node agent/tests/browser-auth.mjs && node agent/tests/browser-smoke.mjs && node agent/tests/browser-model-channels.mjs && node agent/tests/browser-conversation.mjs && node agent/tests/browser-prediction.mjs && node agent/tests/browser-case.mjs && node agent/tests/browser-evidence.mjs && node agent/tests/browser-diagrams.mjs && node agent/tests/chart-loading.mjs && node agent/tests/chart-resilience.mjs && node agent/tests/chart-layout.mjs",
    "test:agent:performance": "node scripts/build-agent-benchmarks.mjs && vitest run --config agent/benchmarks.config.mjs benchmarks/",
    "deploy:eris": "node scripts/deploy-eris.mjs"
  },
  "dependencies": {
    "@lexical/history": "0.49.0",
    "@lexical/plain-text": "0.49.0",
    "@lexical/text": "0.49.0",
    "@lexical/utils": "0.49.0",
    "@mozilla/readability": "0.6.0",
    "@shikijs/langs": "4.4.3",
    "@tabler/core": "1.7.0",
    "@tanstack/react-virtual": "3.14.13",
    "ajv": "8.17.1",
    "anser": "2.3.5",
    "clsx": "2.1.1",
    "diff": "9.0.0",
    "echarts": "6.1.0",
    "immer": "10.2.0",
    "jsdom": "29.1.1",
    "katex": "0.18.7",
    "lexical": "0.49.0",
    "mdast-util-from-markdown": "2.0.3",
    "mdast-util-gfm": "3.1.0",
    "mdast-util-math": "3.0.0",
    "micromark-core-commonmark": "2.0.4",
    "micromark-extension-gfm": "3.0.0",
    "micromark-extension-math": "3.1.0",
    "micromark-factory-space": "2.1.0",
    "micromark-util-character": "2.1.1",
    "micromark-util-classify-character": "2.0.1",
    "micromark-util-sanitize-uri": "2.0.1",
    "micromark-util-symbol": "2.0.1",
    "mime": "4.1.1",
    "mongodb": "7.6.0",
    "pdfjs-dist": "6.3.289",
    "picomatch": "4.0.7",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "shiki": "4.4.3",
    "simple-icons": "16.31.0",
    "undici": "7.30.0",
    "use-sync-external-store": "1.6.0",
    "ws": "8.22.0",
    "zod": "4.6.5",
    "zustand": "4.5.7"
  },
  "devDependencies": {
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/jsdom": "30.0.0",
    "@types/node": "24.10.0",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@types/ws": "8.18.1",
    "@vitest/spy": "4.1.11",
    "esbuild": "0.25.12",
    "fast-check": "4.10.2",
    "js-yaml": "4.3.2",
    "playwright": "1.63.0",
    "typescript": "5.9.3",
    "vite": "6.4.3",
    "vitest": "4.1.11"
  }
}
