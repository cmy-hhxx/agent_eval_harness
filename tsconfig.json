{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noUncheckedIndexedAccess": false,
    "esModuleInterop": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "skipLibCheck": true,
    "rootDir": ".",
    "outDir": "dist",
    "declaration": true,
    "sourceMap": true,
    "resolveJsonModule": true,
    "paths": {
      "@eval/automations": [
        "./packages/automations/src/index.ts"
      ],
      "#pi-sdk": [
        "./vendor/pi/packages/coding-agent/dist/index.d.ts"
      ],
      "#prime-sdk": [
        "./vendor/prime-agent/packages/coding-agent/dist/index.d.ts"
      ],
      "#prime-ai": [
        "./vendor/prime-agent/packages/ai/dist/index.d.ts"
      ],
      "@eval/contracts": [
        "./packages/contracts/src/index.ts"
      ],
      "@eval/data": [
        "./packages/data/src/index.ts"
      ],
      "@eval/host": [
        "./packages/host/src/index.ts"
      ],
      "@eval/tools": [
        "./packages/tools/src/index.ts"
      ],
      "@eval/prompts": [
        "./packages/prompts/src/index.ts"
      ],
      "@eval/agents/comparison": [
        "./packages/agents/src/comparison/index.ts"
      ],
      "@eval/agents/criteria": [
        "./packages/agents/src/criteria/index.ts"
      ],
      "@eval/agents/attribution": [
        "./packages/agents/src/attribution/index.ts"
      ],
      "@eval/agents/rewrite": [
        "./packages/agents/src/rewrite/index.ts"
      ],
      "@eval/agents/clustering": [
        "./packages/agents/src/clustering/index.ts"
      ],
      "@eval/workflows/comparison": [
        "./packages/workflows/src/comparison/index.ts"
      ],
      "@eval/runtime/client": [
        "./packages/runtime/src/client-entry.ts"
      ],
      "@eval/runtime/http": [
        "./packages/runtime/src/http.ts"
      ],
      "@eval/runtime/worker": [
        "./packages/runtime/src/server.ts"
      ],
      "@eval/runtime/pi": [
        "./packages/runtime/src/adapters/pi.ts"
      ],
      "@eval/runtime/prime": [
        "./packages/runtime/src/adapters/prime.ts"
      ],
      "@eval/host-app/config": [
        "./apps/host/src/config.ts"
      ],
      "@eval/host-app/composition": [
        "./apps/host/src/composition.ts"
      ],
      "@eval/runtime/assistant": [
        "./packages/runtime/src/assistant.ts"
      ],
      "@eval/assistant": [
        "./agent/src/core/index.ts"
      ],
      "@eval/assistant/server": [
        "./agent/src/server/index.ts"
      ],
      "@eval/host-app/settings": [
        "./apps/host/src/settings.ts"
      ],
      "@eval/agents/score": [
        "./packages/agents/src/score/index.ts"
      ],
      "@eval/workflows/answer-review": [
        "./packages/workflows/src/answer-review/index.ts"
      ],
      "@eval/agents/instruction-review": [
        "./packages/agents/src/instruction-review/index.ts"
      ],
      "@eval/workflows/inputs": [
        "./packages/workflows/src/inputs/index.ts"
      ],
      "@eval/workflows/review": [
        "./packages/workflows/src/review/index.ts"
      ]
    }
  },
  "include": [
    "apps/*/src/**/*.ts",
    "packages/*/src/**/*.ts",
    "tests/**/*.ts",
    "agent/src/**/*.ts",
    "agent/tests/**/*.ts"
  ],
  "exclude": [
    "vendor",
    "node_modules",
    "dist"
  ]
}
