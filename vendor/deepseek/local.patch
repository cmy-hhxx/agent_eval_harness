+.card { --effort-accent: #b74a3d; --effort-tint: #fbefeb; box-sizing: border-box; width: min(304px, calc(100vw - 26px)); padding: 14px 12px 12px; }
+.card[data-maximum="true"] { --effort-accent: #9f3338; --effort-tint: #f9ede7; }
+.heading { display: grid; grid-template-columns: 28px minmax(0, 1fr) 28px; align-items: start; gap: 8px; }
+.icon { color: #929296; margin: 5px; }
+.copy { min-width: 0; text-align: center; }
+.level { display: block; text-transform: capitalize; color: var(--effort-accent); font-size: 18px; font-weight: 600; line-height: 26px; overflow-wrap: anywhere; }
+.hint { color: #747478; margin-top: 4px; font-size: 12px; line-height: 18px; }
+.reset { display: grid; place-items: center; width: 28px; height: 28px; margin: 0; padding: 0; color: #929296; background: none; border: 0; border-radius: 50%; cursor: pointer; }
+.reset:hover:not(:disabled) { color: var(--effort-accent); background: var(--effort-tint); }
+.reset:focus-visible { outline: 2px solid var(--effort-accent); outline-offset: 3px; }
+.reset:disabled { cursor: default; opacity: .55; }
+.control { position: relative; height: 36px; margin-top: 12px; }
+.track { position: absolute; inset: 5px 0; overflow: hidden; border-radius: 999px; background: #f1ebe7; }
+.fill { width: var(--effort-progress); min-width: 18px; height: 100%; overflow: hidden; border-radius: inherit; background: var(--effort-accent); }
+.card[data-maximum="true"] .fill { background: linear-gradient(100deg, #8f303d 0%, #c94f3e 55%, #d69a52 100%); }
+.particles { position: relative; width: 100%; height: 100%; }
+.particles i { position: absolute; border-radius: 50%; background: #fff4d6; opacity: .65; animation: effort-drift 3.8s ease-in-out infinite alternate; }
+@keyframes effort-drift { from { transform: translate(0, 3px); opacity: .25; } to { transform: translate(5px, -3px); opacity: .8; } }
+.slider { appearance: none; -webkit-appearance: none; position: absolute; inset: 0; margin: 0; width: 100%; height: 36px; border: 0; padding: 0; background: transparent; cursor: pointer; touch-action: pan-y; }
+.slider::-webkit-slider-runnable-track { height: 36px; background: transparent; }
+.slider::-webkit-slider-thumb { appearance: none; -webkit-appearance: none; box-sizing: border-box; width: 36px; height: 36px; margin-top: 0; border-radius: 50%; border: 1px solid #d9d9df; background: #fff; box-shadow: 0 2px 5px #24243818; }
+.slider::-moz-range-track { height: 36px; background: transparent; }
+.slider::-moz-range-thumb { box-sizing: border-box; width: 36px; height: 36px; border-radius: 50%; border: 1px solid #d9d9df; background: #fff; box-shadow: 0 2px 5px #24243818; }
+.slider:focus-visible { outline: 2px solid var(--effort-accent); outline-offset: 4px; border-radius: 999px; }
+.slider:disabled { cursor: default; }
+.control:has(.slider:disabled) { opacity: .6; }
+@media (prefers-reduced-motion: reduce) { .particles i { animation: none; opacity: .6; } }
+@media (forced-colors: active) { .track { border: 1px solid CanvasText; } .fill, .card[data-maximum="true"] .fill { background: Highlight; } .slider::-webkit-slider-thumb { background: ButtonFace; border-color: ButtonText; } .particles { display: none; } }
