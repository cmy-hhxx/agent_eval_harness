+.card { --effort-accent: #b74a3d; --effort-tint: #fbefeb; width: min(336px, calc(100vw - 60px)); padding: 16px 12px 12px; }
+.card[data-maximum="true"] { --effort-accent: #9f3338; --effort-tint: #f9ede7; }
+.heading { display: grid; grid-template-columns: 24px minmax(0, 1fr) 24px; align-items: start; gap: 8px; }
+.icon { color: #929296; margin-top: 3px; }
+.copy { min-width: 0; text-align: center; }
+.level { display: block; text-transform: capitalize; color: var(--effort-accent); font-size: 20px; font-weight: 500; line-height: 26px; overflow-wrap: anywhere; }
+.hint { color: #747478; margin-top: 3px; font-size: 13px; line-height: 20px; }
+.reset { display: grid; place-items: center; width: 28px; height: 28px; margin: -1px -2px 0; padding: 0; color: #929296; background: none; border: 0; border-radius: 50%; cursor: pointer; }
+.reset:hover:not(:disabled) { color: var(--effort-accent); background: var(--effort-tint); }
+.reset:focus-visible { outline: 2px solid var(--effort-accent); outline-offset: 3px; }
+.reset:disabled { cursor: default; opacity: .55; }
+.control { position: relative; height: 44px; margin-top: 18px; }
+.track { position: absolute; inset: 6px 0; overflow: hidden; border-radius: 999px; background: #f1ebe7; }
+.fill { width: var(--effort-progress); min-width: 22px; height: 100%; overflow: hidden; border-radius: inherit; background: var(--effort-accent); }
+.card[data-maximum="true"] .fill { background: linear-gradient(100deg, #8f303d 0%, #c94f3e 55%, #d69a52 100%); }
+.particles { position: relative; width: 310px; max-width: 100%; height: 100%; }
+.particles i { position: absolute; border-radius: 50%; background: #fff4d6; opacity: .65; animation: effort-drift 3.8s ease-in-out infinite alternate; }
+@keyframes effort-drift { from { transform: translate(0, 3px); opacity: .25; } to { transform: translate(5px, -3px); opacity: .8; } }
+.slider { appearance: none; -webkit-appearance: none; position: absolute; inset: 0; margin: 0; width: 100%; height: 44px; border: 0; padding: 0; background: transparent; cursor: pointer; touch-action: pan-y; }
+.slider::-webkit-slider-runnable-track { height: 44px; background: transparent; }
+.slider::-webkit-slider-thumb { appearance: none; -webkit-appearance: none; width: 44px; height: 44px; border-radius: 50%; border: 1px solid #e3e3e7; background: #fff; box-shadow: 0 1px 3px #24243820; }
+.slider::-moz-range-track { height: 44px; background: transparent; }
+.slider::-moz-range-thumb { width: 42px; height: 42px; border-radius: 50%; border: 1px solid #e3e3e7; background: #fff; box-shadow: 0 1px 3px #24243820; }
+.slider:focus-visible { outline: 2px solid var(--effort-accent); outline-offset: 4px; border-radius: 999px; }
+.slider:disabled { cursor: default; }
+.control:has(.slider:disabled) { opacity: .6; }
+@media (prefers-reduced-motion: reduce) { .particles i { animation: none; opacity: .6; } }
+@media (forced-colors: active) { .track { border: 1px solid CanvasText; } .fill, .card[data-maximum="true"] .fill { background: Highlight; } .slider::-webkit-slider-thumb { background: ButtonFace; border-color: ButtonText; } .particles { display: none; } }
