# Pi and Prime share the same model gateway and credential.
# Copy to .env, set your gateway URL and key, then use npm run eval.
EVAL_BASE_URL=https://api.openai.com/v1
EVAL_API_KEY=

# Initial assistant model; otherwise use the Attribution model binding.
# The Agent reads this gateway's /models endpoint; select favorites in the Web UI.
# AGENT_MODEL=your-gateway-model-id
# AGENT_CONTEXT_WINDOW=131072
# AGENT_MAX_TOKENS=8192

# Eris external web/news search via Serper; keep the key on the server.
SEARCH_API_KEY=

# Automations publication: application connection to the existing comparison collection.
# Keep credentials in .env; use a reachable MongoDB URI (or your locally managed SSH tunnel).
AUTOMATIONS_MONGODB_URI=
# Optional absolute path to the MongoDB TLS CA certificate.
AUTOMATIONS_MONGODB_TLS_CA_FILE=
