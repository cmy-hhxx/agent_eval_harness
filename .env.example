# Pi and Prime share the same model gateway and credential.
# Copy to .env, set your gateway URL and key, then use npm run eval.
EVAL_BASE_URL=https://api.openai.com/v1
EVAL_API_KEY=

# Eris also exposes DeepSeek V4.1 Flash when both values are configured.
# The official model ID is deepseek-flash; credentials remain on the server.
# DEEPSEEK_URL=https://api.deepseek.com
# DEEPSEEK_KEY=

# Initial assistant model; DeepSeek Flash is the default when configured,
# otherwise use the Attribution model binding. User favorites choose their default.
# Both the gateway's initial model and DeepSeek Flash appear in default favorites.
# Eris reads the configured endpoints' /models lists; select favorites in the Web UI.
# AGENT_MODEL=deepseek-flash
# AGENT_MODEL=your-gateway-model-id
# Context default: 1048576 for DeepSeek Flash, 131072 for an AGENT_MODEL gateway override.
# AGENT_CONTEXT_WINDOW=1048576
# AGENT_MAX_TOKENS=8192

# Eris external web/news search via Serper; keep the key on the server.
SEARCH_API_KEY=

# Automations publication: application connection to the existing comparison collection.
# Keep credentials in .env; use a reachable MongoDB URI (or your locally managed SSH tunnel).
AUTOMATIONS_MONGODB_URI=
# Optional absolute path to the MongoDB TLS CA certificate.
AUTOMATIONS_MONGODB_TLS_CA_FILE=
