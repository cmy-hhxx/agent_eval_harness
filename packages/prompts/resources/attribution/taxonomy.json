      ]
    },
    "other-tools": {
      "label": "其他工具",
      "group": "渲染与运行时",
      "stage": "工具执行与数据获取",
      "definition": "未单列的已采集工具；按真实工具名补充展示，不猜测业务职责。",
      "optional": "unlisted_tool",
      "exclusions": [
        "未采集的工具"
      ]
    }
