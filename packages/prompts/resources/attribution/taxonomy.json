    "planner-search": {
      "label": "planner-search 检索规划子模型",
      "group": "模型规划",
      "stage": "任务规划",
      "definition": "检索规划子模型；负责把原问改写成检索词、选择渠道和数量。不对检索执行结果负责。",
      "exclusions": [
        "检索工具召回质量",
        "终稿对检索结果的使用"
      ]
    },
    "planner-finquery": {
      "label": "planner-finquery 取数规划子模型",
      "group": "模型规划",
      "stage": "任务规划",
      "definition": "取数规划子模型；负责把原问改写成取数请求、选择标的与字段。不对取数执行与返回负责。",
      "exclusions": [
        "finquery 解析与 SQL 执行",
        "终稿对返回的解释"
      ]
    },
    "expert-reasoning": {
      "label": "Expert 推理轮",
      "group": "模型规划",
      "stage": "工具选择与调用",
      "definition": "主模型的中间推理与工具参数形成调用；负责查询、脚本、图表参数的生成与下一步决策。不含最终交付正文。",
      "exclusions": [
        "最终交付正文",
        "工具忠实执行错误参数"
      ]
    },
    "finquery": {
      "label": "finquery 取数服务",
      "group": "金融数据取数",
      "stage": "工具执行与数据获取",
      "definition": "直连 finquery 取数服务；负责问句解析、字段映射、SQL 生成与执行、零行与状态码语义。",
      "exclusions": [
        "调用方传入的错误参数",
        "终稿对返回的取舍"
      ]
    },
    "finquery-script": {
      "label": "finquery.py 脚本（经 shell）",
      "group": "金融数据取数",
      "stage": "工具执行与数据获取",
      "definition": "Expert 通过 shell 调用 finquery.py 的脚本层；负责脚本报错、临时文件竞态、退出码与 stdout 不一致、路径与依赖。",
      "exclusions": [
        "查询参数由 Expert 生成",
        "返回数据由终稿解释"
      ]
    },
    "web-search": {
      "label": "web_search 网页检索",
      "group": "检索与抓取",
      "stage": "工具执行与数据获取",
      "definition": "网页检索执行；负责召回、时效、来源质量、正文缺失与重复结果。",
      "exclusions": [
        "检索词由规划子模型生成",
        "终稿把摘要当正文"
      ]
    },
    "web-fetch": {
      "label": "web_fetch 网页抓取",
      "group": "检索与抓取",
      "stage": "工具执行与数据获取",
      "definition": "网页抓取执行；负责抓取失败、反爬/限流、正文为空与 URL 无效。",
      "exclusions": [
        "未调用 web_fetch",
        "抓取成功但终稿误读"
      ]
    },
    "shell": {
      "label": "shell 代码解释器",
      "group": "代码执行",
      "stage": "工具执行与数据获取",
      "definition": "通用代码执行；负责脚本异常、路径、依赖、超时与输出截断。",
      "exclusions": [
        "经 shell 调用的 finquery.py 与 data-visualizer 单独归类"
      ]
    },
    "data-visualizer": {
      "label": "data-visualizer 图表渲染",
      "group": "代码执行",
      "stage": "结果组织与交付",
      "definition": "图表参数与渲染脚本层；负责渲染失败、参数与序列不符、标题/序列错配。",
      "exclusions": [
        "正文对图表的解释",
        "终稿文字与图表不一致"
      ]
    },
    "view-skill": {
      "label": "view_skill / read_file 技能加载",
      "group": "代码执行",
      "stage": "工具选择与调用",
      "definition": "技能文档与本地文件读取；负责参数校验、路径与读取失败。",
      "exclusions": [
        "技能内容本身的质量",
        "终稿对技能内容的误用"
      ]
    },
    "context-transfer": {
      "label": "上下文组装与传递",
      "group": "上下文与记忆",
      "stage": "上下文组装与传递",
      "definition": "原始工具返回进入终稿实际输入前的选择、裁剪、压缩、拼接与注入；只在观察到材料缺失、截断或改写时可选。",
      "optional": "material_change",
      "exclusions": [
        "工具本身未返回",
        "终稿独立新增"
      ]
    },
    "stock-ner": {
      "label": "stock_ner_parse 实体识别",
      "group": "上下文与记忆",
      "stage": "需求理解",
      "definition": "问句实体识别；负责标的识别、消歧与实体缺失。",
      "exclusions": [
        "取数规划未覆盖识别结果"
      ]
    },
    "memory": {
      "label": "记忆与用户上下文工具",
      "group": "上下文与记忆",
      "stage": "工具执行与数据获取",
      "definition": "记忆、持仓与用户上下文服务；负责服务报错、鉴权失败与参数 schema 错误。",
      "exclusions": [
        "终稿复述内部画像"
      ]
    },
    "final-generation": {
      "label": "终稿生成轮",
      "group": "终稿生成",
      "stage": "结果组织与交付",
      "definition": "最终交付正文的生成调用；只在输入完整时对新增、改错、遗漏、错配负责。输入材料变化或上游错误沿用不自动承担主责。",
      "exclusions": [
        "上下文组装与传递",
        "上游执行错误",
        "工具未返回"
      ]
    },
    "tool-runtime": {
      "label": "工具调用运行时",
      "group": "渲染与运行时",
      "stage": "工具选择与调用",
      "definition": "工具注册、守卫、重复调用与分发；负责工具不存在、守卫跳过与调用协议错误。",
      "exclusions": [
        "具体工具业务实现"
      ]
    },
    "output-render": {
      "label": "输出后处理与渲染",
      "group": "渲染与运行时",
      "stage": "结果组织与交付",
      "definition": "引用标签、可视化占位与最终呈现；负责格式、标签、占位替换与实际呈现。",
      "exclusions": [
