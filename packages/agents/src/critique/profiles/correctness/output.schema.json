{
  "type": "object",
  "additionalProperties": false,
  "required": ["is_correct", "correctness_reason", "evidence"],
  "properties": {
    "is_correct": {
      "type": ["boolean", "null"]
    },
    "correctness_reason": {
      "type": "string",
      "minLength": 1
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["evidence_id"],
        "properties": {
          "evidence_id": {
            "type": "string",
            "minLength": 1
          },
          "observation": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
